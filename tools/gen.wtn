      (if (bytes.eq n (lit "ldx"))
      (lit "(fn ldx ((dst U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (ldr dst (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "sdx"))
      (lit "(fn sdx ((src U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat4 (add_rr (tmp) base idx) (str src (tmp) (i64.of 0)) (movw (r5) (i64.of 0)) (str (r5) (tmp) (i64.of 4))))")
      (if (bytes.eq n (lit "lbux"))
      (lit "(fn lbux ((dst U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (ldrb dst (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "sbx"))
      (lit "(fn sbx ((src U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (strb src (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "add_big"))
      (lit "(fn add_big ((d U32) (n U32) (imm I64)) Bytes\n    (uses Alloc)\n    (if (and (<= (i64.of -4095) imm) (<= imm (i64.of 4095)))\n      (addi d n imm)\n      (cat (mov_imm (tmp) imm) (add_rr d n (tmp)))))")
      (if (bytes.eq n (lit "frame_load"))
      (lit "(fn frame_loadp ((lo U32) (hi U32) (disp I64)) Bytes\n    (uses Alloc)\n    (if (and (<= (i64.of -255) disp) (<= disp (i64.of 4088)))\n      (cat (ldr lo (fp) disp) (ldr hi (fp) (wrap.add disp (i64.of 4))))\n      (cat3 (mov_imm (tmp) disp) (add_rr (tmp) (fp) (tmp)) (cat (ldr lo (tmp) (i64.of 0)) (ldr hi (tmp) (i64.of 4))))))")
      (if (bytes.eq n (lit "frame_store"))
