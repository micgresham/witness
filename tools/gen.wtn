      (if (str.eq k "sdiv")
      (lit "extui g B 31 1,extui h D 31 1,slli i h 1,or T g i,beqz g S1,neg B B,beqz A N1,addi B B -1,label N1,neg A A,label S1,beqz h S2,neg D D,beqz C N2,addi D D -1,label N2,neg C C,label S2,movi E 0,movi F 0,movi i 64,ssai 31,label LOOP,extui g F 31 1,src F F E,src E E B,src B B A,slli A A 1,bnez g DO,bne F D HIGH,bltu E C SKIP,j DO,label HIGH,bltu F D SKIP,label DO,sub F F D,bgeu E C NB,addi F F -1,label NB,sub E E C,addi A A 1,label SKIP,addi i i -1,bnez i LOOP,srli g T 1,xor g g T,extui g g 0 1,beqz g S3,neg B B,beqz A N3,addi B B -1,label N3,neg A A,label S3")
      (if (str.eq k "srem")
