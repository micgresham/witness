      (if (bytes.eq n (lit "compare_negated"))
      (lit "-")
      (if (bytes.eq n (lit "alu_work"))
      (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (lit "(fn alu_work ((code U8)) (Option Bytes)\n    (uses Alloc)\n    (if (= code (u8.of 124)) (Some ") (thumb_asm (thumb_program "add"))) (lit ") (if (= code (u8.of 125)) (Some ")) (thumb_asm (thumb_program "sub"))) (lit ") (if (= code (u8.of 126)) (Some ")) (thumb_asm (thumb_program "mul"))) (lit ") (if (= code (u8.of 131)) (Some ")) (thumb_asm (thumb_program "and"))) (lit ") (if (= code (u8.of 132)) (Some ")) (thumb_asm (thumb_program "or"))) (lit ") (if (= code (u8.of 133)) (Some ")) (thumb_asm (thumb_program "xor"))) (lit ") (if (= code (u8.of 134)) (Some ")) (thumb_asm (thumb_program "shl"))) (lit ") (if (= code (u8.of 135)) (Some ")) (thumb_asm (thumb_program "shrs"))) (lit ") (if (= code (u8.of 136)) (Some ")) (thumb_asm (thumb_program "shru"))) (lit ") (if (= code (u8.of 114)) (Some ")) (thumb_asm (thumb_program "or"))) (lit ") (if (= code (u8.of 113)) (Some ")) (thumb_asm (thumb_program "and"))) (lit ") (None)))))))))))))"))
      (if (bytes.eq n (lit "zero_check"))
      (glue (glue (lit "(fn zero_check () Bytes (uses Alloc) ") (thumb_asm (thumb_program "zero_check"))) (lit ")"))
      (if (bytes.eq n (lit "overflow_check"))
      (glue (glue (lit "(fn overflow_check () Bytes (uses Alloc) ") (thumb_asm (thumb_program "overflow_check"))) (lit ")"))
      (if (bytes.eq n (lit "divide_code"))
      (glue (glue (glue (glue (glue (glue (glue (glue (lit "(fn divide_code ((code U8)) (Option Bytes)\n    (uses Alloc)\n    (if (= code (u8.of 127))\n      (Some (binary_code (cat3 (zero_check) (overflow_check) ") (thumb_asm (thumb_program "sdiv"))) (lit ")))\n      (if (= code (u8.of 128))\n        (Some (binary_code (cat (zero_check) ")) (thumb_asm (thumb_program "udiv"))) (lit ")))\n        (if (= code (u8.of 129))\n          (Some (binary_code (cat (zero_check) ")) (thumb_asm (thumb_program "srem"))) (lit ")))\n          (if (= code (u8.of 130))\n            (Some (binary_code (cat (zero_check) ")) (thumb_asm (thumb_program "urem"))) (lit ")))\n            (None))))))"))
      (if (bytes.eq n (lit "unary_work"))
      (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (lit "(fn unary_work ((code U8)) (Option Bytes)\n    (uses Alloc)\n    (if (= code (u8.of 80)) (Some ") (thumb_asm (thumb_program "eqz"))) (lit ") (if (= code (u8.of 69)) (Some ")) (thumb_asm (thumb_program "eqz"))) (lit ") (if (= code (u8.of 167)) (Some ")) (thumb_asm (thumb_program "wrap"))) (lit ") (if (= code (u8.of 173)) (Some (no_bytes)) (if (= code (u8.of 194)) (Some ")) (thumb_asm (thumb_program "ext8"))) (lit ") (if (= code (u8.of 195)) (Some ")) (thumb_asm (thumb_program "ext16"))) (lit ") (if (= code (u8.of 196)) (Some ")) (thumb_asm (thumb_program "exts"))) (lit ") (None)))))))))"))
      (if (bytes.eq n (lit "epilogue"))
      (lit "(fn epilogue ((fx VFx)) Bytes\n    (uses Alloc)\n    (cat4 (if (= (get fx results) (u32.of 0)) (no_bytes) (popp (r0) (r1)))\n      (add_big (os) (fp) (widen (wrap.mul (get fx params) (u32.of 8))))\n      (pop_frame)\n      (ret)))")
      (if (bytes.eq n (lit "push_frame"))
