      (replaced f (lit "(zeros (u32.of 8) (u32.of 8))") (lit "(zeros (u32.of 44) (u32.of 8))") 100)
      f))))))))

  (fn rv_patches () Words (uses Alloc) (Words (lit "step") (Words (lit "other_op") (Words (lit "jump_code") (Words (lit "call_step") (Words (lit "write_constant") (Words (lit "start_code") (Words (lit "elf_of") (NoWords)))))))))

  (fn rv_comment () Bytes
    (uses Alloc)
    (lit "; Witness to RISC-V (RV32IM) Linux, from the same instructions the other backends write.\n;\n; This is the RV64 backend (compiler/native_riscv.wtn) with a 32-bit machine behind it. The\n; operand stack still has eight-byte slots, so every frame offset is what it was, but a slot is\n; now two registers: the low word first, then the high word. Addition carries through a compare,\n; a shift is two shifts and an or, a product is mulhu and two muls, a quotient is 64 steps of\n; shift and subtract, a comparison looks at the high words and then the low ones. A wasm address\n; is the low word. Memory is a quarter of a gigabyte rather than four, and the stacks are\n; smaller, because a 32-bit address space is all there is. The ELF file is 32-bit, and the time\n; comes from clock_gettime64 because RV32 Linux has no other.\n;\n; Almost nothing here is written by hand: tools/gen_riscv32.py makes it from native_riscv.wtn,\n; riscv.wtn and a table of what each 64-bit operation becomes. Edit that, not this.\n;\n; The evidence is tests/test_native_riscv32.py: the ELF file is run in an emulator and what it\n; prints is compared with the interpreter's.\n;\n;   witness test compiler/native_riscv32.wtn\n"))


  ; --- Cortex-M: gen_thumb.py --------------------------------------------------------------
  (fn thumb_reg ((x Bytes)) Bytes
    (uses Alloc)
    (imm "u32.of"
      (if (is x "A") (lit "0") (if (is x "B") (lit "1") (if (is x "C") (lit "2") (if (is x "D") (lit "3") (if (is x "E") (lit "4") (if (is x "F") (lit "5")
      (if (is x "g") (lit "6") (if (is x "h") (lit "7") (if (is x "i") (lit "8") (lit "12"))))))))))))

  ; A branch on a register being zero or not is a compare and a branch: two instructions.
  (fn thumb_size ((w Words)) Int (uses Alloc) (if (is (nth w 0) "label") 0 (if (has_word (nth w 0) "bz bnz") 2 1)))

  (fn thumb_labels ((items Words) (n Int) (out Labels)) Labels
    (uses Alloc)
    (match items
      ((NoWords) out)
      ((Words h rest) (let w (pieces h 32) (thumb_labels rest (+ n (thumb_size w)) (if (is (nth w 0) "label") (Labels (nth w 1) n out) out))))))

  (fn thumb_to ((ls Labels) (name Bytes) (n Int)) Bytes (uses Alloc) (imm "i64.of" (num (* 4 (- (label_at ls name) n)))))

  (fn thumb_cond ((op Bytes)) Bytes
    (uses Alloc)
    (if (is op "beq") (lit "0") (if (is op "bne") (lit "1") (if (is op "bhs") (lit "2") (if (is op "blo") (lit "3") (if (is op "bhi") (lit "8")
      (if (is op "bls") (lit "9") (if (is op "bge") (lit "10") (if (is op "blt") (lit "11") (if (is op "bgt") (lit "12") (lit "13")))))))))))

  ; One instruction, or for `bz` and `bnz` two.
  (fn thumb_instruction ((w Words) (ls Labels) (n Int)) Words
    (uses Alloc)
    (let op (nth w 0)
      (let a (thumb_reg (nth w 1))
        (let b (thumb_reg (nth w 2))
          (if (has_word op "add adds adc adcs sub subs sbc sbcs and orr eor mul")
            (one (call_of (glue op (lit "_rr")) (three a b (thumb_reg (nth w 3)))))
            (if (has_word op "lsl lsr asr")
              (one (call_of (glue op (lit "_r")) (three a b (thumb_reg (nth w 3)))))
              (if (has_word op "adds_i adc_i subs_i orr_i and_i rsb_i addw subw")
                (one (call_of op (three a b (imm "i64.of" (nth w 3)))))
                (if (has_word op "lsl_i lsr_i asr_i")
                  (one (call_of op (three a b (imm "u32.of" (nth w 3)))))
                  (if (has_word op "mvn mov")
                    (one (call_of (glue op (lit "_rr")) (two a b)))
                    (if (has_word op "movw movt cmp_i")
                      (one (call_of op (two a (imm "i64.of" (nth w 2)))))
                      (if (is op "umull")
                        (one (call_of op (four a b (thumb_reg (nth w 3)) (thumb_reg (nth w 4)))))
                        (if (has_word op "beq bne bhs blo bhi bls bge blt bgt ble")
                          (one (call_of (lit "bcond") (two (imm "u32.of" (thumb_cond op)) (thumb_to ls (nth w 1) n))))
                          (if (has_word op "bz bnz")
                            (two (call_of (lit "cmp_i") (two a (lit "(i64.of 0)")))
                                 (call_of (lit "bcond") (two (imm "u32.of" (if (is op "bz") (lit "0") (lit "1"))) (thumb_to ls (nth w 2) (+ n 1)))))
                            (if (is op "jmp") (one (call_of (lit "b") (one (thumb_to ls (nth w 1) n)))) (one (lit "(bkpt)"))))))))))))))))

  (fn thumb_assembled ((items Words) (ls Labels) (n Int)) Words
    (uses Alloc)
    (match items
      ((NoWords) (NoWords))
      ((Words h rest) (let w (pieces h 32)
        (if (is (nth w 0) "label") (thumb_assembled rest ls n) (appended (thumb_instruction w ls n) (thumb_assembled rest ls (+ n (thumb_size w)))))))))

  (fn thumb_asm ((prog Bytes)) Bytes
    (uses Alloc)
    (let items (pieces prog 44) (nest (thumb_assembled items (thumb_labels items 0 (NoLabels)) 0) 100000)))

  ; A form kept from either source: replaced, dropped, or patched, and `(ebreak)` is `(bkpt)`.
  (fn thumb_applied ((f Bytes)) Bytes
    (uses Alloc)
    (let n (fn_name f)
      (let r (thumb_replacement n)
        (if (< 0 (size r))
          (if (is r "-") (lit "") r)
          (if (has_word n "push_frame pop_frame") (lit "") (replaced (thumb_patched n f) (lit "(ebreak)") (lit "(bkpt)") 1000))))))

  (fn thumb_from_thumb ((fs Words)) Words
    (uses Alloc)
    (match fs
      ((NoWords) fs)
      ((Words f rest) (if (is (fn_name f) "main") (thumb_from_thumb rest) (let e (thumb_applied f) (if (= (size e) 0) (thumb_from_thumb rest) (Words e (thumb_from_thumb rest))))))))

  ; What native_riscv.wtn imports that thumb.wtn, or nothing here, wants.
  (fn thumb_unwanted ((a Bytes)) Bool
    (uses Alloc)
    (has_word a "add_rr addi addiw jal ecall ebreak branch_not call ld sd lbu sb mov_imm sll_rr srl_rr sra_rr sltu_rr slt_rr sltiu xori slli srli srai divu_rr div_rr rem_rr remu_rr pop_frame push_frame xor_rr or_rr beq bne"))

  (fn thumb_from_native ((fs Words) (th Words) (b Built)) Built
    (uses Alloc)
    (match fs
      ((NoWords) b)
      ((Words f more) (if (is_use f)
        (let a (alias_of f 0 (+ 1 (size f)))
          (thumb_from_native more th (if (or (has th a) (thumb_unwanted a)) b (with b (imports (Words f (get b imports)))))))
        (let n (fn_name f)
          (if (or (and (and (< 0 (size n)) (has th n)) (and (= (size (thumb_replacement n)) 0) (not (is n "main")))) (is n "host_call"))
            (thumb_from_native more th b)
            (let e (thumb_applied f) (thumb_from_native more th (if (= (size e) 0) b (with b (rest (Words e (get b rest)))))))))))))

  (fn thumb ((src Str)) Str
    (uses Alloc)
    (let parts (pieces (str.encode src) 0)
      (let th (forms (nth parts 1))
        (let b (thumb_from_native (forms (nth parts 0)) (fn_names th (NoWords)) (make Built (imports (NoWords)) (rest (NoWords))))
          (module_text (thumb_comment) "native_thumb"
            (appended (get b imports)
              (appended (thumb_from_thumb th)
                (Words (thumb_extra) (Words (thumb_replacement (lit "host_call")) (Words (thumb_replacement (lit "push_frame")) (Words (thumb_replacement (lit "pop_frame")) (reversed (get b rest) (NoWords)))))))))))))

  (fn thumb_program ((k Str)) Bytes
    (uses Alloc)
    (if (str.eq k "add")
      (lit "adds A A C,adc B B D")
      (if (str.eq k "sub")
      (lit "subs A A C,sbc B B D")
      (if (str.eq k "mul")
      (lit "umull E F A C,mul g A D,mul h B C,add F F g,add F F h,mov A E,mov B F")
      (if (str.eq k "and")
      (lit "and A A C,and B B D")
      (if (str.eq k "or")
      (lit "orr A A C,orr B B D")
      (if (str.eq k "xor")
      (lit "eor A A C,eor B B D")
      (if (str.eq k "shl")
      (lit "and_i C C 63,rsb_i g C 32,subw h C 32,lsl B B C,lsr i A g,orr B B i,lsl i A h,orr B B i,lsl A A C")
      (if (str.eq k "shru")
      (lit "and_i C C 63,rsb_i g C 32,subw h C 32,lsr A A C,lsl i B g,orr A A i,lsr i B h,orr A A i,lsr B B C")
      (if (str.eq k "shrs")
      (lit "and_i C C 63,cmp_i C 32,bhs BIG,rsb_i g C 32,lsr A A C,lsl i B g,orr A A i,asr B B C,jmp END,label BIG,subw h C 32,asr A B h,asr_i B B 31,label END")
      (if (str.eq k "lts")
      (lit "subs g A C,sbcs g B D,movw A 1,blt SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "ltu")
      (lit "subs g A C,sbcs g B D,movw A 1,blo SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "gts")
      (lit "subs g C A,sbcs g D B,movw A 1,blt SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "gtu")
      (lit "subs g C A,sbcs g D B,movw A 1,blo SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "les")
      (lit "subs g C A,sbcs g D B,movw A 1,bge SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "leu")
      (lit "subs g C A,sbcs g D B,movw A 1,bhs SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "ges")
      (lit "subs g A C,sbcs g B D,movw A 1,bge SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "geu")
      (lit "subs g A C,sbcs g B D,movw A 1,bhs SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "eq")
      (lit "eor E A C,eor F B D,orr E E F,cmp_i E 0,movw A 1,beq SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "ne")
      (lit "eor E A C,eor F B D,orr E E F,cmp_i E 0,movw A 1,bne SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "eqz")
      (lit "orr A A B,cmp_i A 0,movw A 1,beq SKIP,movw A 0,label SKIP,movw B 0")
      (if (str.eq k "wrap")
      (lit "movw B 0")
      (if (str.eq k "ext8")
      (lit "lsl_i A A 24,asr_i A A 24,asr_i B A 31")
      (if (str.eq k "ext16")
      (lit "lsl_i A A 16,asr_i A A 16,asr_i B A 31")
      (if (str.eq k "exts")
      (lit "asr_i B A 31")
      (if (str.eq k "zero_check")
      (lit "orr E C D,bnz E OK,bkpt,label OK")
      (if (str.eq k "overflow_check")
      (lit "addw E C 1,addw F D 1,orr E E F,bnz E OK,movw F 0,movt F 32768,eor F B F,orr F F A,bnz F OK,bkpt,label OK")
      (if (str.eq k "udiv")
      (lit "movw E 0,movw F 0,movw i 64,label LOOP,adds A A A,adcs B B B,adcs E E E,adcs F F F,bhs DO,subs g E C,sbcs h F D,blo SKIP,label DO,subs E E C,sbc F F D,orr_i A A 1,label SKIP,subs_i i i 1,bne LOOP")
      (if (str.eq k "sdiv")
      (lit "lsr_i g B 31,lsr_i h D 31,lsl_i i h 1,orr T g i,bz g S1,mvn A A,mvn B B,adds_i A A 1,adc_i B B 0,label S1,bz h S2,mvn C C,mvn D D,adds_i C C 1,adc_i D D 0,label S2,movw E 0,movw F 0,movw i 64,label LOOP,adds A A A,adcs B B B,adcs E E E,adcs F F F,bhs DO,subs g E C,sbcs h F D,blo SKIP,label DO,subs E E C,sbc F F D,orr_i A A 1,label SKIP,subs_i i i 1,bne LOOP,lsr_i g T 1,eor g g T,and_i g g 1,bz g S3,mvn A A,mvn B B,adds_i A A 1,adc_i B B 0,label S3")
      (if (str.eq k "srem")
      (lit "lsr_i g B 31,lsr_i h D 31,lsl_i i h 1,orr T g i,bz g S1,mvn A A,mvn B B,adds_i A A 1,adc_i B B 0,label S1,bz h S2,mvn C C,mvn D D,adds_i C C 1,adc_i D D 0,label S2,movw E 0,movw F 0,movw i 64,label LOOP,adds A A A,adcs B B B,adcs E E E,adcs F F F,bhs DO,subs g E C,sbcs h F D,blo SKIP,label DO,subs E E C,sbc F F D,orr_i A A 1,label SKIP,subs_i i i 1,bne LOOP,and_i g T 1,bz g S3,mvn E E,mvn F F,adds_i E E 1,adc_i F F 0,label S3,mov A E,mov B F")
      (if (str.eq k "urem")
      (lit "movw E 0,movw F 0,movw i 64,label LOOP,adds A A A,adcs B B B,adcs E E E,adcs F F F,bhs DO,subs g E C,sbcs h F D,blo SKIP,label DO,subs E E C,sbc F F D,orr_i A A 1,label SKIP,subs_i i i 1,bne LOOP,mov A E,mov B F")
      (lit ""))))))))))))))))))))))))))))))))

  (fn thumb_replacement ((n Bytes)) Bytes
    (uses Alloc)
    (if (bytes.eq n (lit "r0"))
      (lit "(fn r0 () U32 (wrap.sub (u32.of 16) (u32.of 16)))")
