      (if (bytes.eq n (lit "push"))
      (lit "(fn push ((r U32)) Bytes\n    (uses Alloc)\n    (cat4 (str r (os) (i64.of -8)) (movw (tmp) (i64.of 0)) (str (tmp) (os) (i64.of -4)) (subw (os) (os) (i64.of 8))))")
      (if (bytes.eq n (lit "pop"))
