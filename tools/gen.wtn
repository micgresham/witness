      (if (bytes.eq n (lit "pop_frame"))
      (lit "(fn pop_frame () Bytes\n    (uses Alloc)\n    (cat3 (l32i (fp) (sp) (i64.of 0)) (l32i (u32.of 0) (sp) (i64.of 8)) (addi8 (sp) (sp) (i64.of 16))))")
      (if (bytes.eq n (lit "load_code"))
      (lit "(fn load_code ((code U8) (disp U32)) Bytes\n    (uses Alloc)\n    (if (= code (u8.of 49))\n      (cat4 (pop (r0)) (with_offset disp) (lbux (r0) (mem) (r0)) (push (r0)))\n      (cat4 (pop (r0)) (with_offset disp) (add_rr (tmp) (mem) (r0))\n        (cat3 (l32i (r0) (tmp) (i64.of 0)) (l32i (r1) (tmp) (i64.of 4)) (pushp (r0) (r1))))))")
      (if (bytes.eq n (lit "store_code"))
