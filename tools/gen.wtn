      (if (bytes.eq n (lit "pop"))
      (lit "(fn pop ((r U32)) Bytes\n    (uses Alloc)\n    (cat (l32i r (os) (i64.of 0)) (addi8 (os) (os) (i64.of 8))))\n\n  ; A 64-bit value is a slot of two words, the low one first.\n  (fn pushp ((lo U32) (hi U32)) Bytes\n    (uses Alloc)\n    (cat3 (addi8 (os) (os) (i64.of -8)) (s32i lo (os) (i64.of 0)) (s32i hi (os) (i64.of 4))))\n\n  (fn popp ((lo U32) (hi U32)) Bytes\n    (uses Alloc)\n    (cat3 (l32i lo (os) (i64.of 0)) (l32i hi (os) (i64.of 4)) (addi8 (os) (os) (i64.of 8))))\n\n  (fn peekp ((lo U32) (hi U32)) Bytes\n    (uses Alloc)\n    (cat (l32i lo (os) (i64.of 0)) (l32i hi (os) (i64.of 4))))\n\n  ; The heap pointer and the page count live in two words of RAM.\n  (fn cell_get ((d U32) (at I64)) Bytes (uses Alloc) (cat (mov_imm (tmp) at) (l32i d (tmp) (i64.of 0))))\n\n  (fn cell_set ((s U32) (at I64)) Bytes (uses Alloc) (cat (mov_imm (tmp) at) (s32i s (tmp) (i64.of 0))))\n\n  ; addi takes -128 to 127; past that the constant goes through the temporary.\n  (fn addi ((d U32) (n U32) (imm I64)) Bytes\n    (uses Alloc)\n    (if (and (<= (i64.of -128) imm) (<= imm (i64.of 127)))\n      (addi8 d n imm)\n      (cat (mov_imm (tmp) imm) (add_rr d n (tmp)))))")
      (if (bytes.eq n (lit "ldx"))
      (lit "(fn ldx ((dst U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (l32i dst (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "sdx"))
      (lit "(fn sdx ((src U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat4 (add_rr (tmp) base idx) (s32i src (tmp) (i64.of 0)) (movi (r5) (i64.of 0)) (s32i (r5) (tmp) (i64.of 4))))")
      (if (bytes.eq n (lit "lbux"))
      (lit "(fn lbux ((dst U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (l8ui dst (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "sbx"))
      (lit "(fn sbx ((src U32) (base U32) (idx U32)) Bytes\n    (uses Alloc)\n    (cat (add_rr (tmp) base idx) (s8i src (tmp) (i64.of 0))))")
      (if (bytes.eq n (lit "add_big"))
