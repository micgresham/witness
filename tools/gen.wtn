  (fn rv_patched ((n Bytes) (f Bytes)) Bytes
    (uses Alloc)
    (if (bytes.eq n (lit "step"))
      (replaced (replaced (replaced (replaced f (lit "(walked (cat (mov_imm (r0) n) (push (r0))) st") (lit "(walked (cat3 (mov_imm (r0) n) (mov_imm (r1) (high32 n)) (pushp (r0) (r1))) st") 100) (lit "(cat (frame_load (r0) (local_disp fx x)) (push (r0)))") (lit "(cat (frame_loadp (r0) (r1) (local_disp fx x)) (pushp (r0) (r1)))") 100) (lit "(cat (pop (r0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (popp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100) (lit "(cat (ld (r0) (os) (i64.of 0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (peekp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100)
      (if (bytes.eq n (lit "other_op"))
      (replaced f (lit "(cat4 (pop (r2)) (pop (r1)) (pop (r0)) (cat3 (bne (r2) (zero) (i64.of 8)) (mov_rr (r0) (r1)) (push (r0))))") (lit "(cat4 (pop (r2)) (popp (r4) (r5)) (popp (r0) (r1)) (cat3 (bne (r2) (zero) (i64.of 12)) (cat (mov_rr (r0) (r4)) (mov_rr (r1) (r5))) (pushp (r0) (r1))))") 100)
