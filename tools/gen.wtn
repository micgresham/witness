      (if (bytes.eq n (lit "zero_check"))
      (glue (glue (lit "(fn zero_check () Bytes (uses Alloc) ") (xt_asm (xt_program "zero_check"))) (lit ")"))
      (if (bytes.eq n (lit "overflow_check"))
      (glue (glue (lit "(fn overflow_check () Bytes (uses Alloc) ") (xt_asm (xt_program "overflow_check"))) (lit ")"))
      (if (bytes.eq n (lit "divide_code"))
      (glue (glue (glue (glue (glue (glue (glue (glue (lit "(fn divide_code ((code U8)) (Option Bytes)\n    (uses Alloc)\n    (if (= code (u8.of 127))\n      (Some (binary_code (cat3 (zero_check) (overflow_check) ") (xt_asm (xt_program "sdiv"))) (lit ")))\n      (if (= code (u8.of 128))\n        (Some (binary_code (cat (zero_check) ")) (xt_asm (xt_program "udiv"))) (lit ")))\n        (if (= code (u8.of 129))\n          (Some (binary_code (cat (zero_check) ")) (xt_asm (xt_program "srem"))) (lit ")))\n          (if (= code (u8.of 130))\n            (Some (binary_code (cat (zero_check) ")) (xt_asm (xt_program "urem"))) (lit ")))\n            (None))))))"))
