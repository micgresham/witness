      (if (bytes.eq n (lit "call_step"))
      (replaced f (lit "(raw (push (r0)))") (lit "(raw (pushp (r0) (r1)))") 100)
      (if (bytes.eq n (lit "write_constant"))
      (replaced f (lit "(cat (mov_imm (r5) text) (push (r5)))") (lit "(cat3 (mov_imm (r5) text) (mov_imm (tmp) (high32 text)) (pushp (r5) (tmp)))") 100)
