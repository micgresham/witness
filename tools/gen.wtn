      (if (bytes.eq n (lit "copy_loop"))
      (glue (glue (glue (glue (glue (glue (lit "(fn copy_loop () Bytes\n    (uses Alloc)\n    ") (xt_asm (xt_program "copy_loop"))) (lit ")\n\n  (fn word_copy () Bytes\n    (uses Alloc)\n    ")) (xt_asm (xt_program "word_copy"))) (lit ")\n\n  (fn word_zero () Bytes\n    (uses Alloc)\n    ")) (xt_asm (xt_program "word_zero"))) (lit ")"))
      (if (bytes.eq n (lit "host_call"))
      (glue (glue (lit "(fn host_call ((k U32)) Bytes\n    (uses Alloc)\n    (cat (mov_imm (tmp) (wrap.add (i64.of ") (num (get l host))) (lit ") (i64.of (wrap.mul k (u32.of 16))))) (callx0 (tmp))))"))
      (if (bytes.eq n (lit "syscall_with"))
      (lit "-")
      (if (bytes.eq n (lit "write_code"))
      (lit "-")
      (if (bytes.eq n (lit "write_constant"))
      (lit "-")
      (if (bytes.eq n (lit "print_code"))
      (lit "(fn print_code ((fd I64)) Bytes\n    (uses Alloc)\n    (cat4 (pop (r4)) (add_rr (r0) (mem) (r4)) (mov_imm (r1) fd) (host_call (u32.of 1))))")
      (if (bytes.eq n (lit "clock_code"))
      (lit "(fn clock_code ((which I64) (divide I64)) Bytes\n    (uses Alloc)\n    (cat4 (mov_imm (r0) which) (mov_imm (r1) divide) (host_call (u32.of 2)) (pushp (r0) (r1))))")
      (if (bytes.eq n (lit "host_code"))
      (lit "(fn host_code ((name Str)) Bytes\n    (uses Alloc)\n    (if (str.eq name \"print\")\n      (print_code (i64.of 1))\n      (if (str.eq name \"log\")\n        (print_code (i64.of 2))\n        (if (str.eq name \"clock.now\")\n          (clock_code (i64.of 1) (i64.of 1))\n          (if (str.eq name \"clock.wall\")\n            (clock_code (i64.of 0) (i64.of 1))\n            (if (str.eq name \"clock.ticks\") (clock_code (i64.of 1) (i64.of 1000)) (ill)))))))")
      (if (bytes.eq n (lit "elf_header"))
      (lit "(fn elf_header ((entry I64) (total I64)) Bytes\n    (uses Alloc)\n    (cat4 (cat4 (cat4 (bytes.of (u8.of 127)) (bytes.of (u8.of 69)) (bytes.of (u8.of 76)) (bytes.of (u8.of 70))) (bytes.of (u8.of 1)) (bytes.of (u8.of 1)) (cat (bytes.of (u8.of 1)) (zeros (u32.of 9) (u32.of 8))))\n      (cat4 (le16 (u32.of 2)) (le16 (u32.of 94)) (le32 (i64.of 1)) (le32 entry))\n      (cat4 (le32 (i64.of 52))\n        (le32 (i64.of 0))\n        (le32 (i64.of 0))\n        (cat4 (le16 (u32.of 52))\n          (le16 (u32.of 32))\n          (le16 (u32.of 1))\n          (cat3 (le16 (u32.of 0)) (le16 (u32.of 0)) (le16 (u32.of 0)))))\n      (cat4 (le32 (i64.of 1))\n        (le32 (i64.of 0))\n        (le32 (base_address))\n        (cat4 (le32 (base_address))\n          (le32 total)\n          (le32 total)\n          (cat (le32 (i64.of 5)) (le32 (i64.of 4)))))))")
      (if (bytes.eq n (lit "base_address"))
      (glue (glue (lit "(fn base_address () I64 (i64.of ") (num (get l base))) (lit "))"))
      (if (bytes.eq n (lit "exit_code"))
      (lit "(fn exit_code ((status I64)) Bytes\n    (uses Alloc)\n    (cat3 (mov_imm (r0) status) (host_call (u32.of 0)) (ill)))")
      (if (bytes.eq n (lit "mmap_code"))
      (lit "-")
      (if (bytes.eq n (lit "start_code"))
      (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (lit "(fn start_code ((image_at I64) (image_size I64) (heap I64) (pages I64)) Bytes\n    (uses Alloc)\n    (cat4 (cat3 (mov_imm (sp) (i64.of ") (num (get l sp_top))) (lit ")) (mov_imm (os) (i64.of ")) (num (get l os_top))) (lit ")) (mov_imm (mem) (i64.of ")) (num (get l mem))) (lit ")))\n      (cleared)\n      (cat (mov_rr (r0) (mem)) (cat4 (mov_imm (r1) image_at) (mov_imm (r2) (bit.shr image_size 2)) (word_copy) (cell_pair heap pages)))\n      (no_bytes)))\n\n  ; RAM comes out of reset holding anything, and the runtime counts on memory it has not\n  ; written reading as zero, as a wasm module's does: the free lists' table, for one, is\n  ; allocated and never cleared. So the wasm memory and the operand stack are zeroed, a word\n  ; at a time, before the data image is copied in.\n  (fn cleared () Bytes\n    (uses Alloc)\n    (cat4 (mov_rr (r0) (mem)) (mov_imm (r2) (i64.of ")) (num (get l words))) (lit ")) (movi (r3) (i64.of 0)) (word_zero)))\n\n  (fn cell_pair ((heap I64) (pages I64)) Bytes\n    (uses Alloc)\n    (cat4 (mov_imm (r0) heap) (cell_set (r0) (i64.of ")) (num (get l hp))) (lit ")) (mov_imm (r0) pages) (cell_set (r0) (i64.of ")) (num (get l pg))) (lit "))))"))
      (if (bytes.eq n (lit "filter_entry"))
      (lit "-")
      (lit "")))))))))))))))))))))))))))))))))))))))))))))))))))))))

  (fn xt_patched ((n Bytes) (f Bytes) (l XLayout)) Bytes
    (uses Alloc)
    (if (bytes.eq n (lit "item_size"))
      (replaced (replaced (replaced f (lit "((VJump id) (u32.of 4))") (lit "((VJump id) (u32.of 3))") 100) (lit "((VJumpIf f3 a b id) (u32.of 8))") (lit "((VJumpIf f3 a b id) (if (through_tmp f3 a b) (u32.of 9) (u32.of 6)))") 100) (lit "((VCallFn func) (u32.of 8))") (lit "((VCallFn func) (u32.of 3))") 100)
      (if (bytes.eq n (lit "item_bytes"))
      (replaced (replaced (replaced f (lit "((VJump id) (jal (zero) (distance (label_at ls id) at)))") (lit "((VJump id) (j (distance (label_at ls id) at)))") 100) (lit "((VJumpIf f3 a b id) (cat (branch_not f3 a b (i64.of 8)) (jal (zero) (distance (label_at ls id) (wrap.add at (u32.of 4))))))") (lit "((VJumpIf f3 a b id) (if (through_tmp f3 a b) (cat3 (movi (tmp) (i64.of 0)) (branch_not f3 (named a) (named b) (i64.of 6)) (j (distance (label_at ls id) (wrap.add at (u32.of 6))))) (cat (branch_not f3 a b (i64.of 6)) (j (distance (label_at ls id) (wrap.add at (u32.of 3)))))))") 100) (lit "((VCallFn func) (call (distance (start_of ss func) at)))") (lit "((VCallFn func) (call0_to (widen (start_of ss func)) (widen at)))") 100)
      (if (bytes.eq n (lit "step"))
      (replaced (replaced (replaced (replaced (replaced (replaced (replaced (replaced f (lit "(walked (cat (mov_imm (r0) n) (push (r0))) st") (lit "(walked (cat3 (mov_imm (r0) n) (mov_imm (r1) (bit.shr n 32)) (pushp (r0) (r1))) st") 100) (lit "(cat (frame_load (r0) (local_disp fx x)) (push (r0)))") (lit "(cat (frame_loadp (r0) (r1) (local_disp fx x)) (pushp (r0) (r1)))") 100) (lit "(cat (pop (r0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (popp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100) (lit "(cat (ld (r0) (os) (i64.of 0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (peekp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100) (lit "(walked (push (hp)) st") (glue (glue (lit "(walked (cat (cell_get (r0) (i64.of ") (num (get l hp))) (lit ")) (push (r0))) st")) 100) (lit "(walked (pop (hp)) st") (glue (glue (lit "(walked (cat (pop (r0)) (cell_set (r0) (i64.of ") (num (get l hp))) (lit "))) st")) 100) (lit "(walked (push (pg)) st") (glue (glue (lit "(walked (cat (cell_get (r0) (i64.of ") (num (get l pg))) (lit ")) (push (r0))) st")) 100) (lit "(walked (cat4 (pop (r0)) (mov_rr (r1) (pg)) (add_rr (pg) (pg) (r0)) (push (r1))) st") (glue (glue (glue (glue (lit "(walked (cat4 (pop (r0)) (cell_get (r1) (i64.of ") (num (get l pg))) (lit ")) (cat (add_rr (r2) (r1) (r0)) (cell_set (r2) (i64.of ")) (num (get l pg))) (lit "))) (push (r1))) st")) 100)
      (if (bytes.eq n (lit "other_op"))
      (replaced f (lit "(cat4 (pop (r2)) (pop (r1)) (pop (r0)) (cat3 (bne (r2) (zero) (i64.of 8)) (mov_rr (r0) (r1)) (push (r0))))") (lit "(cat4 (pop (r2)) (popp (r4) (r5)) (popp (r0) (r1)) (cat4 (bnez (r2) (i64.of 9)) (mov_rr (r0) (r4)) (mov_rr (r1) (r5)) (pushp (r0) (r1))))") 100)
      (if (bytes.eq n (lit "jump_code"))
      (replaced f (lit "(if (= carries (u32.of 0)) (no_bytes) (pop (r0))) (set_stack fx height) (if (= carries (u32.of 0)) (no_bytes) (push (r0)))") (lit "(if (= carries (u32.of 0)) (no_bytes) (popp (r0) (r1))) (set_stack fx height) (if (= carries (u32.of 0)) (no_bytes) (pushp (r0) (r1)))") 100)
      (if (bytes.eq n (lit "call_step"))
      (replaced f (lit "(raw (push (r0)))") (lit "(raw (pushp (r0) (r1)))") 100)
      (if (bytes.eq n (lit "bodies_of"))
      (replaced f (lit "(VBodies (function_items f shapes hosts)") (lit "(VBodies (aligned (function_items f shapes hosts))") 100)
      (if (bytes.eq n (lit "elf_of"))
      (replaced (replaced (replaced (replaced (replaced f (lit "(zeros (u32.of 8) (u32.of 8))") (lit "(zeros (u32.of 44) (u32.of 8))") 100) (lit "(if filter (filter_entry index) (main_entry index))") (lit "(main_entry index)") 100) (lit "(let image (image_of (get m segments) (zeros (narrow heap) (u32.of 40)))") (lit "(let image (padded (image_of (get m segments) (zeros (narrow heap) (u32.of 40))))") 100) (lit "(let stub (stub_items entry image_at (i64.of (octets image)) heap (widen (get m pages)))") (lit "(let stub (aligned (stub_items entry image_at (i64.of (octets image)) heap (widen (get m pages))))") 100) (lit "(Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 44) (u32.of 8)) image code))") (glue (glue (glue (glue (glue (glue (lit "(if (< (i64.of ") (num (get l iram))) (lit ") total) (Err (fault \"native\" (concat \"the image is \" (concat (num.to_str total) \" bytes, more than the ")) (num (get l iram))) (lit " of instruction RAM the ")) (str.encode (get l chip))) (lit "'s layout has for code\")))) (Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 44) (u32.of 8)) image code)))")) 100)
      f)))))))))

  (fn xt_extra ((l XLayout)) Bytes (uses Alloc) (lit "(fn cond_of ((f3 U32)) U32\n    (if (= f3 (u32.of 0)) (u32.of 1)\n      (if (= f3 (u32.of 1)) (u32.of 9)\n        (if (= f3 (u32.of 4)) (u32.of 2)\n          (if (= f3 (u32.of 5)) (u32.of 10)\n            (if (= f3 (u32.of 6)) (u32.of 3) (u32.of 11)))))))\n\n  ; RISC-V's `zero` is a register and Xtensa has none. Comparing a register with zero for\n  ; (in)equality is beqz or bnez; any other comparison with zero, on either side, is made\n  ; with the temporary holding a zero instead.\n  (fn through_tmp ((f3 U32) (a U32) (b U32)) Bool\n    (or (= a (zero)) (and (= b (zero)) (not (or (= f3 (u32.of 0)) (= f3 (u32.of 1)))))))\n\n  (fn named ((r U32)) U32 (if (= r (zero)) (tmp) r))\n\n  ; Branch when a and b fail the RISC-V comparison f3; b is the register `zero` only for\n  ; (in)equality, which Xtensa writes as beqz or bnez.\n  (fn branch_not ((f3 U32) (a U32) (b U32) (off I64)) Bytes\n    (uses Alloc)\n    (if (= b (zero))\n      (if (= f3 (u32.of 0)) (bnez a off) (beqz a off))\n      (bcmp (bit.xor (cond_of f3) (u32.of 8)) a b off)))\n\n  ; call0 lands on a word, so every function, and the start code, is padded to a multiple of four.\n  (fn pad_of ((n U32)) U32 (bit.and (wrap.sub (u32.of 0) n) (u32.of 3)))\n\n  (fn aligned ((is VItems)) VItems\n    (uses Alloc)\n    (items_join is (raw (zeros (pad_of (items_size is)) (u32.of 8)))))\n\n  (fn padded ((b Bytes)) Bytes\n    (uses Alloc)\n    (bytes.concat b (zeros (pad_of (octets b)) (u32.of 8))))"))

  (fn xt_comment ((l XLayout)) Bytes
    (uses Alloc)
    (glue (glue (glue (glue (glue (glue (glue (glue (glue (glue (lit "; Witness to the ") (str.encode (get l chip))) (lit " (Xtensa ")) (str.encode (get l core))) (lit "), from the same instructions the other backends write.\n;\n; This is the RISC-V backend's walk with an Xtensa core behind it, as native_thumb.wtn is with\n; a Cortex-M: eight-byte slots on the operand stack and a 64-bit value as two registers (low\n; word first). There are no flags, so a carry is an unsigned comparison, and a 64-bit shift is\n; the funnel shift `src`. Calls use `call0`, without register windows: a0 holds the return\n; address and is saved in the frame, and every function starts on a word, as call0 needs.\n; There is no operating system: the wasm memory, the stacks and two words for the heap pointer\n; and page count are fixed places in the ")) (str.encode (get l chip))) (lit "'s data RAM, and the host's functions -- print,\n; the clock, exit -- are calls through fixed addresses that a board's support code supplies\n; (tests/emulate.py loads one into QEMU beside the program).\n;\n; Almost nothing here is written by hand: tools/gen_xtensa.py makes it from native_riscv.wtn,\n; xtensa.wtn and a table of what each 64-bit operation becomes. Edit that, not this.\n;\n; The evidence is tests/test_native_xtensa.py: the image is run on QEMU's model of the ")) (str.encode (get l chip))) (lit "\n; core and what it prints is compared with the interpreter's.\n;\n;   witness test compiler/")) (str.encode (get l named))) (lit ".wtn\n")))

  (fn xt_riscv_only ((a Bytes)) Bool (uses Alloc) (has_word a "add_rr addi addiw and_rr at beq bne branch_not byte call div_rr divu_rr ebreak ecall jal lbu ld mov_imm mov_rr mul_rr or_rr plus pop_frame push_frame rem_rr remu_rr ret sb sd sll_rr slli slt_rr sltiu sltu_rr sra_rr srai srl_rr srli sub_rr xor_rr xori"))


  (test "an operation is assembled as gen_riscv32.py assembles it"
    (bytes.eq (rv_asm (lit "add A A C,sltu E A C"))
              (lit "(cat (add_rr (u32.of 10) (u32.of 10) (u32.of 12)) (sltu_rr (u32.of 14) (u32.of 10) (u32.of 12)))")))

  (test "a branch on Thumb is the distance to its label, and bz is two instructions"
    (bytes.eq (thumb_asm (lit "bz E OK,bkpt,label OK"))
              (lit "(cat3 (cmp_i (u32.of 4) (i64.of 0)) (bcond (u32.of 0) (i64.of 4)) (bkpt))")))

  (test "a form is named as gen_riscv32.py names it"
    (and (bytes.eq (fn_name (lit "(fn (present T) ((o (Option T))) Bool true)")) (lit "present"))
         (bytes.eq (fn_name (lit "(enum Keys (NoKeys))")) (lit "")))))
