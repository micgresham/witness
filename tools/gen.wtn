      (if (bytes.eq n (lit "write_code"))
      (lit "-")
      (if (bytes.eq n (lit "write_constant"))
      (lit "-")
      (if (bytes.eq n (lit "print_code"))
      (lit "(fn print_code ((fd I64)) Bytes\n    (uses Alloc)\n    (cat4 (pop (r4)) (add_rr (r0) (mem) (r4)) (mov_imm (r1) fd) (host_call (u32.of 1))))")
      (if (bytes.eq n (lit "clock_code"))
      (lit "(fn clock_code ((which I64) (divide I64)) Bytes\n    (uses Alloc)\n    (cat4 (mov_imm (r0) which) (mov_imm (r1) divide) (host_call (u32.of 2)) (pushp (r0) (r1))))")
      (if (bytes.eq n (lit "host_code"))
      (lit "(fn host_code ((name Str)) Bytes\n    (uses Alloc)\n    (if (str.eq name \"print\")\n      (print_code (i64.of 1))\n      (if (str.eq name \"log\")\n        (print_code (i64.of 2))\n        (if (str.eq name \"clock.now\")\n          (clock_code (i64.of 1) (i64.of 1))\n          (if (str.eq name \"clock.wall\")\n            (clock_code (i64.of 0) (i64.of 1))\n            (if (str.eq name \"clock.ticks\") (clock_code (i64.of 1) (i64.of 1000)) (bkpt)))))))")
      (if (bytes.eq n (lit "elf_header"))
      (lit "(fn elf_header ((entry I64) (total I64)) Bytes\n    (uses Alloc)\n    (cat4 (cat4 (cat4 (bytes.of (u8.of 127)) (bytes.of (u8.of 69)) (bytes.of (u8.of 76)) (bytes.of (u8.of 70))) (bytes.of (u8.of 1)) (bytes.of (u8.of 1)) (cat (bytes.of (u8.of 1)) (zeros (u32.of 9) (u32.of 8))))\n      (cat4 (le16 (u32.of 2)) (le16 (u32.of 40)) (le32 (i64.of 1)) (le32 entry))\n      (cat4 (le32 (i64.of 52))\n        (le32 (i64.of 0))\n        (le32 (i64.of 83886080))\n        (cat4 (le16 (u32.of 52))\n          (le16 (u32.of 32))\n          (le16 (u32.of 1))\n          (cat3 (le16 (u32.of 0)) (le16 (u32.of 0)) (le16 (u32.of 0)))))\n      (cat4 (le32 (i64.of 1))\n        (le32 (i64.of 0))\n        (le32 (base_address))\n        (cat4 (le32 (base_address))\n          (le32 total)\n          (le32 total)\n          (cat (le32 (i64.of 5)) (le32 (i64.of 4096)))))))")
      (if (bytes.eq n (lit "base_address"))
      (lit "(fn base_address () I64 (i64.of 134217728))")
      (if (bytes.eq n (lit "exit_code"))
      (lit "(fn exit_code ((status I64)) Bytes\n    (uses Alloc)\n    (cat3 (mov_imm (r0) status) (host_call (u32.of 0)) (bkpt)))")
      (if (bytes.eq n (lit "mmap_code"))
      (lit "-")
      (if (bytes.eq n (lit "start_code"))
      (lit "(fn start_code ((image_at I64) (image_size I64) (heap I64) (pages I64)) Bytes\n    (uses Alloc)\n    (cat4 (cat3 (mov_imm (r0) (i64.of 537329664)) (mov_rr (sp) (r0)) (mov_imm (os) (i64.of 537264128)))\n      (cat (mov_imm (mem) (i64.of 536870912)) (cleared))\n      (cat (mov_rr (r0) (mem)) (cat4 (mov_imm (r1) image_at) (mov_imm (r2) image_size) (copy_loop) (cell_pair heap pages)))\n      (no_bytes)))\n\n  ; RAM comes out of reset holding anything, and the runtime counts on memory it has not\n  ; written reading as zero, as a wasm module's does: the free lists' table, for one, is\n  ; allocated and never cleared. So the wasm memory and the operand stack are zeroed, a word\n  ; at a time, before the data image is copied in.\n  (fn cleared () Bytes\n    (uses Alloc)\n    (cat4 (mov_rr (r0) (mem)) (mov_imm (r2) (i64.of 98304)) (movw (r3) (i64.of 0))\n      (cat4 (str (r3) (r0) (i64.of 0)) (adds_i (r0) (r0) (i64.of 4)) (subs_i (r2) (r2) (i64.of 1)) (bcond (u32.of 1) (i64.of -12)))))\n\n  (fn cell_pair ((heap I64) (pages I64)) Bytes\n    (uses Alloc)\n    (cat4 (mov_imm (r0) heap) (cell_set (r0) (i64.of 537391104)) (mov_imm (r0) pages) (cell_set (r0) (i64.of 537391108))))")
      (if (bytes.eq n (lit "filter_entry"))
      (lit "-")
      (lit "")))))))))))))))))))))))))))))))))))))))))))))))))))))))

  (fn thumb_patched ((n Bytes) (f Bytes)) Bytes
    (uses Alloc)
    (if (bytes.eq n (lit "item_size"))
      (replaced (replaced f (lit "((VJumpIf f3 a b id) (u32.of 8))") (lit "((VJumpIf f3 a b id) (u32.of 12))") 100) (lit "((VCallFn func) (u32.of 8))") (lit "((VCallFn func) (u32.of 4))") 100)
      (if (bytes.eq n (lit "item_bytes"))
      (replaced (replaced (replaced f (lit "((VJump id) (jal (zero) (distance (label_at ls id) at)))") (lit "((VJump id) (b (distance (label_at ls id) at)))") 100) (lit "((VJumpIf f3 a b id) (cat (branch_not f3 a b (i64.of 8)) (jal (zero) (distance (label_at ls id) (wrap.add at (u32.of 4))))))") (lit "((VJumpIf f3 a b id) (cat3 (jump_cmp a b) (bcond (not_cond (cond_of f3)) (i64.of 8)) (b (distance (label_at ls id) (wrap.add at (u32.of 8))))))") 100) (lit "((VCallFn func) (call (distance (start_of ss func) at)))") (lit "((VCallFn func) (bl (distance (start_of ss func) at)))") 100)
      (if (bytes.eq n (lit "step"))
      (replaced (replaced (replaced (replaced (replaced (replaced (replaced (replaced f (lit "(walked (cat (mov_imm (r0) n) (push (r0))) st") (lit "(walked (cat3 (mov_imm (r0) n) (mov_imm (r1) (bit.shr n 32)) (pushp (r0) (r1))) st") 100) (lit "(cat (frame_load (r0) (local_disp fx x)) (push (r0)))") (lit "(cat (frame_loadp (r0) (r1) (local_disp fx x)) (pushp (r0) (r1)))") 100) (lit "(cat (pop (r0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (popp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100) (lit "(cat (ld (r0) (os) (i64.of 0)) (frame_store (r0) (local_disp fx x)))") (lit "(cat (peekp (r0) (r1)) (frame_storep (r0) (r1) (local_disp fx x)))") 100) (lit "(walked (push (hp)) st") (lit "(walked (cat (cell_get (r0) (i64.of 537391104)) (push (r0))) st") 100) (lit "(walked (pop (hp)) st") (lit "(walked (cat (pop (r0)) (cell_set (r0) (i64.of 537391104))) st") 100) (lit "(walked (push (pg)) st") (lit "(walked (cat (cell_get (r0) (i64.of 537391108)) (push (r0))) st") 100) (lit "(walked (cat4 (pop (r0)) (mov_rr (r1) (pg)) (add_rr (pg) (pg) (r0)) (push (r1))) st") (lit "(walked (cat4 (pop (r0)) (cell_get (r1) (i64.of 537391108)) (cat (add_rr (r2) (r1) (r0)) (cell_set (r2) (i64.of 537391108))) (push (r1))) st") 100)
      (if (bytes.eq n (lit "other_op"))
      (replaced f (lit "(cat4 (pop (r2)) (pop (r1)) (pop (r0)) (cat3 (bne (r2) (zero) (i64.of 8)) (mov_rr (r0) (r1)) (push (r0))))") (lit "(cat4 (pop (r2)) (popp (r4) (r5)) (popp (r0) (r1)) (cat4 (cmp_i (r2) (i64.of 0)) (bcond (u32.of 1) (i64.of 12)) (cat (mov_rr (r0) (r4)) (mov_rr (r1) (r5))) (pushp (r0) (r1))))") 100)
      (if (bytes.eq n (lit "jump_code"))
      (replaced f (lit "(if (= carries (u32.of 0)) (no_bytes) (pop (r0))) (set_stack fx height) (if (= carries (u32.of 0)) (no_bytes) (push (r0)))") (lit "(if (= carries (u32.of 0)) (no_bytes) (popp (r0) (r1))) (set_stack fx height) (if (= carries (u32.of 0)) (no_bytes) (pushp (r0) (r1)))") 100)
      (if (bytes.eq n (lit "call_step"))
      (replaced f (lit "(raw (push (r0)))") (lit "(raw (pushp (r0) (r1)))") 100)
      (if (bytes.eq n (lit "elf_of"))
      (replaced (replaced (replaced f (lit "(zeros (u32.of 8) (u32.of 8))") (lit "(zeros (u32.of 44) (u32.of 8))") 100) (lit "(if filter (filter_entry index) (main_entry index))") (lit "(main_entry index)") 100) (lit "(elf_header (wrap.add (base_address) code_offset) total)") (lit "(elf_header (wrap.add (wrap.add (base_address) code_offset) (i64.of 1)) total)") 100)
      f))))))))

  (fn thumb_patches () Words (uses Alloc) (Words (lit "item_size") (Words (lit "item_bytes") (Words (lit "step") (Words (lit "other_op") (Words (lit "jump_code") (Words (lit "call_step") (Words (lit "elf_of") (NoWords)))))))))

  (fn thumb_extra () Bytes (uses Alloc) (lit "(fn cond_of ((f3 U32)) U32\n    (if (= f3 (u32.of 0)) (u32.of 0)\n      (if (= f3 (u32.of 1)) (u32.of 1)\n        (if (= f3 (u32.of 4)) (u32.of 11)\n          (if (= f3 (u32.of 5)) (u32.of 10)\n            (if (= f3 (u32.of 6)) (u32.of 3) (u32.of 2)))))))\n\n  ; Compare a with b, where b is the register `zero` when the jump is on a being zero.\n  (fn jump_cmp ((a U32) (b U32)) Bytes\n    (uses Alloc)\n    (if (= b (zero)) (cmp_i a (i64.of 0)) (cmp_rr a b)))"))

  (fn thumb_comment () Bytes
    (uses Alloc)
    (lit "; Witness to Thumb-2 (Cortex-M, ARMv7-M), from the same instructions the other backends write.\n;\n; This is the RISC-V backend's walk with a Cortex-M behind it: eight-byte slots on the operand\n; stack, a 64-bit value as two registers (low word first), and the flags doing the carrying that\n; RISC-V does with compares (`adds`/`adc`, `subs`/`sbc`, and a 64-bit comparison is a `subs`\n; and an `sbcs`). Every instruction is the four-byte form. There is no operating system: the\n; wasm memory, the stacks and two words for the heap pointer and page count are fixed places in\n; RAM, and the host's functions -- print, the clock, exit -- are calls through fixed addresses\n; that a board's support code supplies (the emulator in tests/emulate.py answers them).\n;\n; Almost nothing here is written by hand: tools/gen_thumb.py makes it from native_riscv.wtn,\n; thumb.wtn and a table of what each 64-bit operation becomes. Edit that, not this.\n;\n; The evidence is tests/test_native_thumb.py: the image is run in a Cortex-M3 emulator and what\n; it prints is compared with the interpreter's.\n;\n;   witness test compiler/native_thumb.wtn\n"))


  ; --- ESP32-P4 and ESP32-S31, bare metal: gen_esp32p4.py ------------------------------------
  ; What differs between the two chips is where their RAM is; gen_esp32p4.py says why each
  ; address is where it is. `words` is how many words lie between the wasm memory and the top of
  ; the operand stack, all of them cleared at reset.
  (record Layout (named Str) (chip Str) (short Str) (ram Str) (base Int) (code Int) (mem Int) (os_top Int) (sp_top Int) (host Int) (words Int))

  (fn p4 () Layout
    (make Layout (named "native_esp32p4") (chip "ESP32-P4") (short "P4") (ram "L2 memory") (base 1341128704) (code 131072)
                 (mem 1341259776) (os_top 1341784064) (sp_top 1341882368) (host 1341911040) (words 131072)))

  (fn s31 () Layout
    (make Layout (named "native_esp32s31") (chip "ESP32-S31") (short "S31") (ram "SRAM") (base 788529152) (code 131072)
                 (mem 788660224) (os_top 788955136) (sp_top 789028864) (host 789028864) (words 73728)))

  (fn esp_base_address ((l Layout)) Bytes
    (uses Alloc)
    (glue (glue (lit "(fn base_address () I64 (i64.of ") (num (get l base))) (lit "))")))

  (fn esp_print_code ((l Layout)) Bytes
    (uses Alloc)
    (glue (glue (lit "; A call to the board, through the temporary: the return address goes in ra, which the\n  ; frame already keeps, and k picks the function.\n  (fn host_call ((k U32)) Bytes\n    (uses Alloc)\n    (cat (mov_imm (tmp) (wrap.add (i64.of ") (num (get l host)))
          (lit ") (i64.of (wrap.mul k (u32.of 16))))) (jalr (u32.of 1) (tmp) (i64.of 0))))\n\n  ; The board writes the string the wasm address names, and the line's end; `prefix` is what\n  ; the Linux backend writes before a log line, which the board does itself.\n  (fn print_code ((fd I64) (prefix Bytes)) Bytes\n    (uses Alloc)\n    (cat4 (pop (r4)) (add_rr (r0) (mem) (r4)) (mov_imm (r1) fd) (host_call (u32.of 1))))")))

  (fn esp_clock_code () Bytes
    (uses Alloc)
    (lit "(fn clock_code ((which I64) (divide I64)) Bytes\n    (uses Alloc)\n    (cat4 (mov_imm (r0) which) (mov_imm (r1) divide) (host_call (u32.of 2)) (pushp (r0) (r1))))"))

  (fn esp_host_code () Bytes
    (uses Alloc)
    (lit "(fn host_code ((name Str)) Bytes\n    (uses Alloc)\n    (if (str.eq name \"print\")\n      (print_code (i64.of 1) (no_bytes))\n      (if (str.eq name \"log\")\n        (print_code (i64.of 2) (no_bytes))\n        (if (str.eq name \"clock.now\")\n          (clock_code (i64.of 1) (i64.of 1))\n          (if (str.eq name \"clock.wall\")\n            (clock_code (i64.of 0) (i64.of 1))\n            (if (str.eq name \"clock.ticks\") (clock_code (i64.of 1) (i64.of 1000)) (ebreak)))))))"))

  (fn esp_exit_code () Bytes
    (uses Alloc)
    (lit "(fn exit_code ((status I64)) Bytes\n    (uses Alloc)\n    (cat3 (mov_imm (r0) status) (host_call (u32.of 0)) (ebreak)))"))

  (fn esp_start_code ((l Layout)) Bytes
    (uses Alloc)
    (glue (glue (glue (glue (lit "(fn start_code ((image_at I64) (image_size I64) (heap I64) (pages I64)) Bytes\n    (uses Alloc)\n    (cat4 (cat3 (mov_imm (sp) (i64.of ") (num (get l sp_top)))
                      (glue (glue (lit ")) (mov_imm (os) (i64.of ") (num (get l os_top))) (glue (lit ")) (mov_imm (mem) (i64.of ") (num (get l mem)))))
                (lit ")))\n      (cleared)\n      (cat4 (mov_rr (r0) (mem)) (mov_imm (r1) image_at) (mov_imm (r2) image_size) (copy_loop))\n      (cat (mov_imm (hp) heap) (mov_imm (pg) pages))))\n\n  ; RAM comes out of reset holding anything, and the runtime counts on memory it has not\n  ; written reading as zero, as a wasm module's does: the free lists' table, for one, is\n  ; allocated and never cleared. So the wasm memory and the operand stack are zeroed, a word\n  ; at a time, before the data image is copied in.\n  (fn cleared () Bytes\n    (uses Alloc)\n    (cat4 (mov_rr (r0) (mem)) (mov_imm (r2) (i64.of "))
          (glue (num (get l words))
                (lit "))\n      (cat (sw (zero) (r0) (i64.of 0)) (addi (r0) (r0) (i64.of 4)))\n      (cat (addi (r2) (r2) (i64.of -1)) (bne (r2) (zero) (i64.of -12)))))"))))

  ; The image is refused when it would not fit the code's part of RAM.
  (fn esp_elf_of ((f Bytes) (l Layout)) Bytes
    (uses Alloc)
    (let once (replaced f (lit "(if filter (filter_entry index) (main_entry index))") (lit "(main_entry index)") 100)
      (replaced once
        (lit "(Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 44) (u32.of 8)) image code))")
        (glue (glue (glue (glue (glue (lit "(if (< (i64.of ") (num (get l code))) (lit ") total) (Err (fault \"native\" (concat \"the image is \" (concat (num.to_str total) \" bytes, more than the "))
                          (num (get l code)))
                    (glue (glue (lit " of ") (str.encode (get l ram))) (glue (lit " the ") (str.encode (get l chip)))))
              (lit "'s layout has for code\")))) (Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 44) (u32.of 8)) image code)))"))
        100)))

  ; What becomes of a form: itself, another text, or nothing ("").
  (fn esp_rewritten ((f Bytes) (l Layout)) Bytes
    (uses Alloc)
    (let n (fn_name f)
      (if (bytes.eq n (lit "base_address"))
        (esp_base_address l)
        (if (or (or (bytes.eq n (lit "syscall_with")) (bytes.eq n (lit "write_code"))) (or (or (bytes.eq n (lit "write_constant")) (bytes.eq n (lit "mmap_code"))) (bytes.eq n (lit "filter_entry"))))
          (lit "")
          (if (bytes.eq n (lit "print_code"))
            (esp_print_code l)
            (if (bytes.eq n (lit "clock_code"))
              (esp_clock_code)
              (if (bytes.eq n (lit "host_code"))
                (esp_host_code)
                (if (bytes.eq n (lit "exit_code"))
                  (esp_exit_code)
                  (if (bytes.eq n (lit "start_code")) (esp_start_code l) (if (bytes.eq n (lit "elf_of")) (esp_elf_of f l) f))))))))))

  (fn esp_comment ((l Layout)) Bytes
    (uses Alloc)
    (glue (glue (glue (glue (lit "; Witness to the ") (str.encode (get l chip))) (lit " (RISC-V RV32IM, bare metal), from the same instructions the other backends write.\n;\n; This is the RV32 backend (native_riscv32.wtn) without an operating system under it: the\n; wasm memory and the stacks are fixed places in the "))
                (glue (glue (glue (str.encode (get l short)) (lit "'s ")) (str.encode (get l ram)))
                      (lit ", cleared before the data\n; image goes in, and print, the clock and exit are calls through fixed addresses that a\n; board's support code supplies (tests/emulate.py answers them in an RV32 emulator). The\n; walk, the frames and the 64-bit operations in pairs of registers are the RV32 backend's.\n;\n; Almost nothing here is written by hand: tools/gen_esp32p4.py makes it from native_riscv32.wtn.\n; Edit that, not this.\n;\n; The evidence is tests/test_native_esp32p4.py: the image is run in Unicorn's RV32 and what it\n; prints is compared with the interpreter's.\n;\n;   witness test compiler/")))
          (glue (str.encode (get l named)) (lit ".wtn\n"))))

  (fn esp_rewritten_all ((fs Words) (l Layout)) Words
    (uses Alloc)
    (match fs ((NoWords) fs) ((Words f rest) (let e (esp_rewritten f l) (if (= (size e) 0) (esp_rewritten_all rest l) (Words e (esp_rewritten_all rest l)))))))

  (fn esp ((src Str) (l Layout)) Str
    (uses Alloc)
    (module_text (esp_comment l) (get l named) (esp_rewritten_all (forms (str.encode src)) l)))

  (fn esp32p4 ((src Str)) Str (uses Alloc) (esp src (p4)))

  (fn esp32s31 ((src Str)) Str (uses Alloc) (esp src (s31)))

  ; --- ESP32 and ESP32-S3, Xtensa: gen_xtensa.py --------------------------------------------
  ; The two are the same code for two memory maps; gen_xtensa.py says why each address is where
  ; it is. `hp` and `pg` are the words that hold the heap pointer and the page count, and
  ; `words` how many words lie between the wasm memory and the top of the operand stack.
  (record XLayout (named Str) (chip Str) (core Str) (mem Int) (os_top Int) (sp_top Int) (hp Int) (pg Int) (base Int) (host Int) (iram Int) (words Int))

  (fn esp32 () XLayout
    (make XLayout (named "native_xtensa") (chip "ESP32") (core "LX6") (mem 1073414144) (os_top 1073676288) (sp_top 1073733632)
                  (hp 1073737728) (pg 1073737732) (base 1074266112) (host 1074200576) (iram 131072) (words 65536)))

  (fn esp32s3 () XLayout
    (make XLayout (named "native_xtensa_s3") (chip "ESP32-S3") (core "LX7") (mem 1070235648) (os_top 1070542848) (sp_top 1070592000)
                  (hp 1070592000) (pg 1070592004) (base 1077379072) (host 1077346304) (iram 131072) (words 76800)))

  (fn xt_reg ((x Bytes)) Bytes
    (uses Alloc)
    (imm "u32.of"
      (if (is x "A") (lit "2") (if (is x "B") (lit "3") (if (is x "C") (lit "4") (if (is x "D") (lit "5") (if (is x "E") (lit "6") (if (is x "F") (lit "7")
      (if (is x "g") (lit "8") (if (is x "h") (lit "9") (if (is x "i") (lit "10") (lit "11"))))))))))))

  ; Every instruction is three bytes, and a branch is counted in bytes from where it is.
  (fn xt_labels ((items Words) (n Int) (out Labels)) Labels
    (uses Alloc)
    (match items
      ((NoWords) out)
      ((Words h rest) (let w (pieces h 32) (if (is (nth w 0) "label") (xt_labels rest n (Labels (nth w 1) n out)) (xt_labels rest (+ n 3) out))))))

  (fn xt_to ((ls Labels) (name Bytes) (n Int)) Bytes (uses Alloc) (imm "i64.of" (num (- (label_at ls name) n))))

  (fn xt_instruction ((w Words) (ls Labels) (n Int)) Bytes
    (uses Alloc)
    (let op (nth w 0)
      (let a (xt_reg (nth w 1))
        (let b (xt_reg (nth w 2))
          (if (has_word op "add sub and or xor")
            (call_of (glue op (lit "_rr")) (three a b (xt_reg (nth w 3))))
            (if (has_word op "mull muluh src")
              (call_of op (three a b (xt_reg (nth w 3))))
              (if (is op "mov")
                (call_of (lit "mov_rr") (two a b))
                (if (is op "neg")
                  (call_of (lit "neg_r") (two a b))
                  (if (has_word op "sll srl sra")
                    (call_of op (two a b))
                    (if (has_word op "slli srli srai")
                      (call_of op (three a b (imm "u32.of" (nth w 3))))
                      (if (is op "extui")
                        (call_of op (four a b (imm "u32.of" (nth w 3)) (imm "u32.of" (nth w 4))))
                        (if (has_word op "ssl ssr")
                          (call_of op (one a))
                          (if (is op "ssai")
                            (call_of op (one (imm "u32.of" (nth w 1))))
                            (if (is op "movi")
                              (call_of op (two a (imm "i64.of" (nth w 2))))
                              (if (is op "addi")
                                (call_of (lit "addi8") (three a b (imm "i64.of" (nth w 3))))
                                (if (has_word op "l32i s32i l8ui s8i")
                                  (call_of op (three a b (imm "i64.of" (nth w 3))))
                                  (if (has_word op "beq bne blt bge bltu bgeu")
                                    (call_of op (three a b (xt_to ls (nth w 3) n)))
                                    (if (has_word op "beqz bnez")
                                      (call_of op (two a (xt_to ls (nth w 2) n)))
                                      (if (has_word op "bbci bbsi")
                                        (call_of op (three a (imm "u32.of" (nth w 2)) (xt_to ls (nth w 3) n)))
                                        (if (is op "j") (call_of op (one (xt_to ls (nth w 1) n))) (lit "(ill)")))))))))))))))))))))

  (fn xt_assembled ((items Words) (ls Labels) (n Int)) Words
    (uses Alloc)
    (match items
      ((NoWords) (NoWords))
      ((Words h rest) (let w (pieces h 32) (if (is (nth w 0) "label") (xt_assembled rest ls n) (Words (xt_instruction w ls n) (xt_assembled rest ls (+ n 3))))))))

  (fn xt_asm ((prog Bytes)) Bytes
    (uses Alloc)
    (let items (pieces prog 44) (nest (xt_assembled items (xt_labels items 0 (NoLabels)) 0) 100000)))

  ; A form of native_riscv.wtn kept: replaced, dropped, or patched, and `(ebreak)` is `(ill)`.
  (fn xt_applied ((f Bytes) (l XLayout)) Bytes
    (uses Alloc)
    (let n (fn_name f)
      (let r (xt_replacement n l)
        (if (< 0 (size r))
          (if (is r "-") (lit "") r)
          (if (has_word n "push_frame pop_frame") (lit "") (replaced (xt_patched n f l) (lit "(ebreak)") (lit "(ill)") 1000))))))

  ; xtensa.wtn's forms as they are, but for its `main`.
  (fn xt_from_xtensa ((fs Words)) Words
    (uses Alloc)
    (match fs ((NoWords) fs) ((Words f rest) (if (is (fn_name f) "main") (xt_from_xtensa rest) (Words f (xt_from_xtensa rest))))))

  (fn xt_from_native ((fs Words) (xt Words) (l XLayout) (b Built)) Built
    (uses Alloc)
    (match fs
      ((NoWords) b)
      ((Words f more) (if (is_use f)
        (let a (alias_of f 0 (+ 1 (size f)))
          (xt_from_native more xt l (if (or (has xt a) (xt_riscv_only a)) b (with b (imports (Words f (get b imports)))))))
        (let n (fn_name f)
          (if (or (and (and (< 0 (size n)) (has xt n)) (and (= (size (xt_replacement n l)) 0) (not (is n "main")))) (is n "host_call"))
            (xt_from_native more xt l b)
            (let e (xt_applied f l) (xt_from_native more xt l (if (= (size e) 0) b (with b (rest (Words e (get b rest)))))))))))))

  (fn xtensa_for ((src Str) (l XLayout)) Str
    (uses Alloc)
    (let parts (pieces (str.encode src) 0)
      (let xt (forms (nth parts 1))
        (let b (xt_from_native (forms (nth parts 0)) (fn_names xt (NoWords)) l (make Built (imports (NoWords)) (rest (NoWords))))
          (module_text (xt_comment l) (get l named)
            (appended (get b imports)
              (appended (xt_from_xtensa xt)
                (Words (xt_extra l) (Words (xt_replacement (lit "host_call") l) (Words (xt_replacement (lit "push_frame") l) (Words (xt_replacement (lit "pop_frame") l) (reversed (get b rest) (NoWords)))))))))))))

  (fn xtensa ((src Str)) Str (uses Alloc) (xtensa_for src (esp32)))

  (fn xtensa_s3 ((src Str)) Str (uses Alloc) (xtensa_for src (esp32s3)))

  (fn xt_program ((k Str)) Bytes
    (uses Alloc)
    (if (str.eq k "add")
      (lit "add A A C,add B B D,bgeu A C NC,addi B B 1,label NC")
      (if (str.eq k "sub")
