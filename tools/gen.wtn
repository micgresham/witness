      (if (str.eq k "ltu")
      (lit "movi E 1,bne B D HI,bltu A C DONE,j NO,label HI,bltu B D DONE,label NO,movi E 0,label DONE,mov A E,movi B 0")
      (if (str.eq k "gts")
      (lit "movi E 1,bne D B HI,bltu C A DONE,j NO,label HI,blt D B DONE,label NO,movi E 0,label DONE,mov A E,movi B 0")
      (if (str.eq k "gtu")
      (lit "movi E 1,bne D B HI,bltu C A DONE,j NO,label HI,bltu D B DONE,label NO,movi E 0,label DONE,mov A E,movi B 0")
      (if (str.eq k "les")
      (lit "movi E 0,bne D B HI,bltu C A DONE,j NO,label HI,blt D B DONE,label NO,movi E 1,label DONE,mov A E,movi B 0")
      (if (str.eq k "leu")
