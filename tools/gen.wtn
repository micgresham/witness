      (if (bytes.eq n (lit "frame_load"))
      (lit "(fn frame_loadp ((lo U32) (hi U32) (disp I64)) Bytes\n    (uses Alloc)\n    (if (and (<= (i64.of 0) disp) (<= disp (i64.of 1016)))\n      (cat (l32i lo (fp) disp) (l32i hi (fp) (wrap.add disp (i64.of 4))))\n      (cat3 (mov_imm (tmp) disp) (add_rr (tmp) (fp) (tmp)) (cat (l32i lo (tmp) (i64.of 0)) (l32i hi (tmp) (i64.of 4))))))")
      (if (bytes.eq n (lit "frame_store"))
