; The backends made from the RISC-V one: tools/gen_riscv32.py, gen_thumb.py, gen_xtensa.py and
; gen_esp32p4.py, in Witness, writing the same bytes.
;
; Each backend after the first is the RV64 one (compiler/native_riscv.wtn) with another machine
; behind it, and most of its text is that backend's, form for form: what differs is a table of
; what each 64-bit operation becomes in the new machine's instructions, assembled into the
; Witness that writes them (`rv_asm`, `thumb_asm`, `xt_asm`), the functions that are replaced outright
; (`*_replacement`), and the ones changed in place (`*_patched`). So the backends are written
; here and nowhere else, and edited here: compiler/native_riscv32.wtn and the others are made.
;
; Each entry takes the texts it is made from, separated by a NUL byte, and gives the backend:
;
;   riscv32    native_riscv.wtn, riscv.wtn          -> native_riscv32.wtn
;   thumb      native_riscv.wtn, thumb.wtn          -> native_thumb.wtn
;   esp32p4    native_riscv32.wtn                   -> native_esp32p4.wtn
;   esp32s31   native_riscv32.wtn                   -> native_esp32s31.wtn
;   xtensa     native_riscv.wtn, xtensa.wtn         -> native_xtensa.wtn
;   xtensa_s3  native_riscv.wtn, xtensa.wtn         -> native_xtensa_s3.wtn
;
; A source is read as its top-level forms, exactly as written, comments inside them and all;
; the comments between them are the generator's to write.
;
;   witness test tools/gen.wtn
(module gen
  (fn lit ((s Str)) Bytes (uses Alloc) (str.encode s))

  (fn size ((t Bytes)) Int (ensures (<= 0 result)) (unwrap (bytes.len t)))

  (fn octet ((t Bytes) (i Int)) Int
    (match (bytes.at t (Octets i)) ((None) (- 0 1)) ((Some d) (int.of d))))

  (fn slice ((t Bytes) (from Int) (to Int)) Bytes (uses Alloc) (bytes.slice t (Octets from) (Octets to)))

  (fn glue ((a Bytes) (b Bytes)) Bytes (uses Alloc) (bytes.concat a b))

  (fn num ((n Int)) Bytes (uses Alloc) (str.encode (num.to_str n)))

  (fn is ((t Bytes) (s Str)) Bool (uses Alloc) (bytes.eq t (str.encode s)))

  ; Where `what` first appears at or after `i`, or -1.
  (fn find ((t Bytes) (what Bytes) (i Int) (left Int)) Int
    (uses Alloc)
    (if (<= left 0)
      (- 0 1)
      (if (< (size t) (+ i (size what))) (- 0 1) (if (bytes.eq (slice t i (+ i (size what))) what) i (find t what (+ i 1) (- left 1))))))

  ; Every `a` replaced by `b`, as Python's str.replace.
  (fn replaced ((t Bytes) (a Bytes) (b Bytes) (left Int)) Bytes
    (uses Alloc)
    (if (<= left 0)
      t
      (let at (find t a 0 (+ 1 (size t)))
        (if (< at 0) t (glue (glue (slice t 0 at) b) (replaced (slice t (+ at (size a)) (size t)) a b (- left 1)))))))

  ; --- words ------------------------------------------------------------------------------
  (enum Words (NoWords) (Words (head Bytes) (rest Words)))

  ; `t` cut at every byte `sep`, in order.
  (fn split ((t Bytes) (sep Int) (from Int) (i Int) (left Int)) Words
    (uses Alloc)
    (if (<= left 0)
      (NoWords)
      (let c (octet t i)
        (if (< c 0)
          (Words (slice t from i) (NoWords))
          (if (= c sep) (Words (slice t from i) (split t sep (+ i 1) (+ i 1) (- left 1))) (split t sep from (+ i 1) (- left 1)))))))

  (fn pieces ((t Bytes) (sep Int)) Words (uses Alloc) (split t sep 0 0 (+ 1 (size t))))

  (fn nth ((ws Words) (n Int)) Bytes
    (uses Alloc)
    (match ws ((NoWords) (lit "")) ((Words h rest) (if (<= n 0) h (nth rest (- n 1))))))

  (fn count ((ws Words)) Int (match ws ((NoWords) 0) ((Words h rest) (+ 1 (count rest)))))

  (fn has ((ws Words) (w Bytes)) Bool (match ws ((NoWords) false) ((Words h rest) (or (bytes.eq h w) (has rest w)))))

  (fn reversed ((ws Words) (onto Words)) Words (match ws ((NoWords) onto) ((Words h rest) (reversed rest (Words h onto)))))

  (fn appended ((a Words) (b Words)) Words (match a ((NoWords) b) ((Words h rest) (Words h (appended rest b)))))

  (fn has_word ((t Bytes) (ws Str)) Bool (uses Alloc) (has (pieces (lit ws) 32) t))

  ; --- assembling -------------------------------------------------------------------------
  (enum Labels (NoLabels) (Labels (name Bytes) (at Int) (rest Labels)))

  (fn label_at ((ls Labels) (name Bytes)) Int
    (match ls ((NoLabels) 0) ((Labels n at rest) (if (bytes.eq n name) at (label_at rest name)))))

  ; One expression for a run of them: cat, cat3 and cat4, four at a time.
  (fn nest ((xs Words) (left Int)) Bytes
    (uses Alloc)
    (if (<= left 0)
      (lit "")
      (let k (count xs)
        (if (= k 1)
          (nth xs 0)
          (if (<= k 4)
            (glue (glue (lit "(") (if (= k 2) (lit "cat") (if (= k 3) (lit "cat3") (lit "cat4")))) (glue (lit " ") (glue (spaced xs) (lit ")"))))
            (match xs
              ((NoWords) (lit ""))
              ((Words a r1) (match r1
                ((NoWords) a)
                ((Words b r2) (match r2
                  ((NoWords) a)
                  ((Words c r3) (glue (glue (lit "(cat4 ") (glue a (glue (lit " ") b))) (glue (glue (lit " ") c) (glue (lit " ") (glue (nest r3 (- left 1)) (lit ")"))))))))))))))))

  (fn spaced ((xs Words)) Bytes
    (uses Alloc)
    (match xs ((NoWords) (lit "")) ((Words h rest) (match rest ((NoWords) h) ((Words h2 more) (glue h (glue (lit " ") (spaced rest))))))))

  ; `(op a b c)`, each of the words already written.
  (fn call_of ((op Bytes) (args Words)) Bytes (uses Alloc) (glue (glue (lit "(") op) (glue (if (= (count args) 0) (lit "") (lit " ")) (glue (spaced args) (lit ")")))))

  (fn imm ((kind Str) (v Bytes)) Bytes (uses Alloc) (glue (glue (glue (lit "(") (lit kind)) (glue (lit " ") v)) (lit ")")))

  (fn one ((a Bytes)) Words (Words a (NoWords)))

  (fn two ((a Bytes) (b Bytes)) Words (Words a (Words b (NoWords))))

  (fn three ((a Bytes) (b Bytes) (c Bytes)) Words (Words a (Words b (Words c (NoWords)))))

  (fn four ((a Bytes) (b Bytes) (c Bytes) (d Bytes)) Words (Words a (Words b (Words c (Words d (NoWords))))))

  ; --- the forms of a module, as gen_riscv32.py's `forms` and `name_of` read them -----------
  (enum Spans (NoSpans) (Spans (from Int) (to Int) (rest Spans)))

  (record Scan (depth Int) (start Int) (quoted Bool) (out Spans))

  (fn scan ((t Bytes) (i Int) (s Scan) (left Int)) Spans
    (if (<= left 0) (get s out) (let c (octet t i) (if (< c 0) (get s out) (scan_byte t i c s (- left 1))))))

  (fn scan_byte ((t Bytes) (i Int) (c Int) (s Scan) (left Int)) Spans
    (if (get s quoted)
      (if (= c 92) (scan t (+ i 2) s left) (scan t (+ i 1) (if (= c 34) (with s (quoted false)) s) left))
      (if (= c 34)
        (scan t (+ i 1) (with s (quoted true)) left)
        (if (= c 59)
          (scan t (line_end t i (+ 1 (size t))) s left)
          (if (= c 40)
            (scan t (+ i 1) (with s (depth (+ (get s depth) 1)) (start (if (= (get s depth) 1) i (get s start)))) left)
            (if (= c 41)
              (let d (- (get s depth) 1)
                (if (= d 0) (get s out) (scan t (+ i 1) (with s (depth d) (out (if (= d 1) (Spans (get s start) (+ i 1) (get s out)) (get s out)))) left)))
              (scan t (+ i 1) s left)))))))

  (fn line_end ((t Bytes) (i Int) (left Int)) Int
    (if (<= left 0) i (let c (octet t i) (if (or (< c 0) (= c 10)) i (line_end t (+ i 1) (- left 1))))))

  (fn forms_of ((t Bytes) (ss Spans) (out Words)) Words
    (uses Alloc)
    (match ss ((NoSpans) out) ((Spans from to rest) (forms_of t rest (Words (slice t from to) out)))))

  (fn forms ((t Bytes)) Words
    (uses Alloc)
    (forms_of t (scan t (find t (lit "(module") 0 (+ 1 (size t))) (make Scan (depth 0) (start 0) (quoted false) (out (NoSpans))) (+ 1 (size t))) (NoWords)))

  (fn is_word ((c Int)) Bool (or (or (and (<= 97 c) (<= c 122)) (and (<= 65 c) (<= c 90))) (or (and (<= 48 c) (<= c 57)) (= c 95))))

  (fn is_name ((c Int)) Bool (or (is_word c) (or (= c 46) (= c 45))))

  (fn run_of ((t Bytes) (i Int) (names Bool) (left Int)) Int
    (if (<= left 0) i (let c (octet t i) (if (if names (is_name c) (is_word c)) (run_of t (+ i 1) names (- left 1)) i))))

  (fn spaces_end ((t Bytes) (i Int) (left Int)) Int
    (if (<= left 0) i (let c (octet t i) (if (or (or (= c 32) (= c 10)) (or (= c 9) (= c 13))) (spaces_end t (+ i 1) (- left 1)) i))))

  ; `(fn name ...)` or `(fn (name T) ...)`: the name; "" for anything that is not a fn.
  (fn fn_name ((f Bytes)) Bytes
    (uses Alloc)
    (let kind_end (run_of f 1 false (+ 1 (size f)))
      (if (not (bytes.eq (slice f 0 kind_end) (lit "(fn")))
        (lit "")
        (let gap (spaces_end f kind_end (+ 1 (size f)))
          (if (= gap kind_end)
            (lit "")
            (let from (if (= (octet f gap) 40) (+ gap 1) gap) (slice f from (run_of f from true (+ 1 (size f))))))))))

  (fn is_use ((f Bytes)) Bool (uses Alloc) (bytes.eq (slice f 0 4) (lit "(use")))

  ; The local name of `(use "..." as name)`: the first `as ` followed by a word and `)`.
  (fn alias_of ((f Bytes) (i Int) (left Int)) Bytes
    (uses Alloc)
    (if (<= left 0)
      (lit "")
      (let at (find f (lit "as ") i (+ 1 (size f)))
        (if (< at 0)
          (lit "")
          (let e (run_of f (+ at 3) false (+ 1 (size f)))
            (if (and (< (+ at 3) e) (= (octet f e) 41)) (slice f (+ at 3) e) (alias_of f (+ at 1) (- left 1))))))))

  (fn fn_names ((fs Words) (out Words)) Words
    (uses Alloc)
    (match fs ((NoWords) out) ((Words f rest) (fn_names rest (let n (fn_name f) (if (= (size n) 0) out (Words n out)))))))

  ; The forms after "(module name\n  ", the imports first, each after "\n\n  ".
  (fn joined ((ws Words) (first Bool)) Bytes
    (uses Alloc)
    (match ws ((NoWords) (lit "")) ((Words h rest) (glue (glue (if first (lit "") (lit "\n\n  ")) h) (joined rest false)))))

  (fn imports_of ((ws Words)) Words (uses Alloc) (match ws ((NoWords) ws) ((Words h rest) (if (is_use h) (Words h (imports_of rest)) (imports_of rest)))))

  (fn others_of ((ws Words)) Words (uses Alloc) (match ws ((NoWords) ws) ((Words h rest) (if (is_use h) (others_of rest) (Words h (others_of rest))))))

  (fn module_text ((comment Bytes) (name Str) (fs Words)) Str
    (uses Alloc)
    (match (bytes.decode (glue (glue comment (glue (lit "(module ") (glue (lit name) (lit "\n  ")))) (glue (joined (appended (imports_of fs) (others_of fs)) true) (lit ")\n"))))
      ((Err f) "")
      ((Ok s) s)))

  ; What a replacement table says of a form: its text, "" to drop it, or the form itself.
  (fn instead ((f Bytes) (r Bytes)) Bytes (uses Alloc) (if (= (size r) 0) f (if (is r "-") (lit "") r)))

  ; --- RV32 Linux: gen_riscv32.py --------------------------------------------------------------
  ; A register by the letter the table uses for it.
  (fn rv_reg ((x Bytes)) Bytes
    (uses Alloc)
    (imm "u32.of"
      (if (is x "A") (lit "10") (if (is x "B") (lit "11") (if (is x "C") (lit "12") (if (is x "D") (lit "13") (if (is x "E") (lit "14") (if (is x "F") (lit "15")
      (if (is x "Z") (lit "0") (if (is x "T") (lit "5") (if (is x "g") (lit "6") (if (is x "h") (lit "7") (if (is x "i") (lit "28") (if (is x "j") (lit "29")
      (if (is x "k") (lit "30") (if (is x "l") (lit "31") (lit "9")))))))))))))))))

  (fn rv_labels ((items Words) (n Int) (out Labels)) Labels
    (uses Alloc)
    (match items
      ((NoWords) out)
      ((Words h rest) (let w (pieces h 32) (if (is (nth w 0) "label") (rv_labels rest n (Labels (nth w 1) n out)) (rv_labels rest (+ n 1) out))))))

  (fn rv_to ((ls Labels) (name Bytes) (n Int)) Bytes (uses Alloc) (imm "i64.of" (num (* 4 (- (label_at ls name) n)))))

  (fn rv_instruction ((w Words) (ls Labels) (n Int)) Bytes
    (uses Alloc)
    (let op (nth w 0)
      (let a (rv_reg (nth w 1))
        (let b (rv_reg (nth w 2))
          (if (has_word op "add sub and or xor sll srl sra slt sltu mul mulhu")
            (call_of (glue op (lit "_rr")) (three a b (rv_reg (nth w 3))))
            (if (has_word op "addi sltiu xori ori andi")
              (call_of op (three a b (imm "i64.of" (nth w 3))))
              (if (has_word op "slli srli srai")
                (call_of op (three a b (imm "u32.of" (nth w 3))))
                (if (has_word op "beq bne blt bge bltu bgeu")
                  (call_of op (three a b (rv_to ls (nth w 3) n)))
                  (if (is op "jal")
                    (call_of op (two (lit "(u32.of 0)") (rv_to ls (nth w 1) n)))
                    (if (is op "ebreak")
                      (lit "(ebreak)")
                      (if (is op "lui") (call_of op (two a (imm "i64.of" (nth w 2)))) (call_of (lit "addi") (three a b (lit "(i64.of 0)"))))))))))))))

  (fn rv_assembled ((items Words) (ls Labels) (n Int)) Words
    (uses Alloc)
    (match items
      ((NoWords) (NoWords))
      ((Words h rest) (let w (pieces h 32) (if (is (nth w 0) "label") (rv_assembled rest ls n) (Words (rv_instruction w ls n) (rv_assembled rest ls (+ n 1))))))))

  (fn rv_asm ((prog Bytes)) Bytes
    (uses Alloc)
    (let items (pieces prog 44) (nest (rv_assembled items (rv_labels items 0 (NoLabels)) 0) 100000)))

  ; riscv.wtn's forms first, its `main` left out.
  (fn rv_from_riscv ((fs Words)) Words
    (uses Alloc)
    (match fs
      ((NoWords) fs)
      ((Words f rest) (let n (fn_name f)
        (if (is n "main") (rv_from_riscv rest) (let e (instead f (rv_replacement n)) (if (= (size e) 0) (rv_from_riscv rest) (Words e (rv_from_riscv rest)))))))))

  ; Then native_riscv.wtn's: its imports, but for what riscv.wtn now gives, each put in front
  ; of what is there; and its functions, but for those riscv.wtn already has and nothing replaces.
  (record Built (imports Words) (rest Words))

  (fn rv_from_native ((fs Words) (rv Words) (b Built)) Built
    (uses Alloc)
    (match fs
      ((NoWords) b)
      ((Words f more) (if (is_use f)
        (let a (alias_of f 0 (+ 1 (size f)))
          (rv_from_native more rv (if (or (has rv a) (has_word a "add_rr addi addiw")) b (with b (imports (Words f (get b imports)))))))
        (let n (fn_name f)
          (if (and (and (< 0 (size n)) (has rv n)) (and (= (size (rv_replacement n)) 0) (not (is n "main"))))
            (rv_from_native more rv b)
            (let e (instead f (rv_replacement n)) (rv_from_native more rv (if (= (size e) 0) b (with b (rest (Words e (get b rest)))))))))))))

  (fn rv_patched_all ((ws Words)) Words (uses Alloc) (match ws ((NoWords) ws) ((Words h rest) (Words (rv_patched (fn_name h) h) (rv_patched_all rest)))))

  (fn riscv32 ((src Str)) Str
    (uses Alloc)
    (let parts (pieces (str.encode src) 0)
      (let rv (forms (nth parts 1))
        (let b (rv_from_native (forms (nth parts 0)) (fn_names rv (NoWords)) (make Built (imports (NoWords)) (rest (NoWords))))
          (module_text (rv_comment) "native_riscv32" (rv_patched_all (appended (get b imports) (appended (rv_from_riscv rv) (reversed (get b rest) (NoWords))))))))))


  ; The tables gen_riscv32.py and gen_thumb.py hold: each 64-bit operation as instructions,
  ; comma-separated (`*_program`); what each function of the RV64 backend becomes (`*_replacement`:
  ; its text, "-" for nothing, "" to keep it); and the functions changed in place (`*_patched`).

  (fn rv_program ((k Str)) Bytes
    (uses Alloc)
    (if (str.eq k "add")
      (lit "add A A C,sltu E A C,add B B D,add B B E")
      (if (str.eq k "sub")
      (lit "sltu E A C,sub A A C,sub B B D,sub B B E")
      (if (str.eq k "mul")
      (lit "mulhu E A C,mul F A D,mul g B C,mul A A C,add B E F,add B B g")
      (if (str.eq k "and")
      (lit "and A A C,and B B D")
      (if (str.eq k "or")
      (lit "or A A C,or B B D")
      (if (str.eq k "xor")
      (lit "xor A A C,xor B B D")
      (if (str.eq k "shl")
      (lit "andi C C 63,beq C Z END,addi E Z 32,bltu C E SMALL,sub C C E,sll B A C,addi A Z 0,jal END,label SMALL,sll B B C,sub E E C,srl E A E,or B B E,sll A A C,label END")
      (if (str.eq k "shru")
      (lit "andi C C 63,beq C Z END,addi E Z 32,bltu C E SMALL,sub C C E,srl A B C,addi B Z 0,jal END,label SMALL,srl A A C,sub E E C,sll E B E,or A A E,srl B B C,label END")
      (if (str.eq k "shrs")
      (lit "andi C C 63,beq C Z END,addi E Z 32,bltu C E SMALL,sub C C E,sra A B C,srai B B 31,jal END,label SMALL,srl A A C,sub E E C,sll E B E,or A A E,sra B B C,label END")
      (if (str.eq k "eq")
      (lit "xor E A C,xor F B D,or A E F,sltiu A A 1,addi B Z 0")
      (if (str.eq k "ne")
      (lit "xor E A C,xor F B D,or A E F,sltu A Z A,addi B Z 0")
      (if (str.eq k "lts")
      (lit "slt g B D,xor h B D,sltiu h h 1,sltu E A C,and h h E,or A g h,addi B Z 0")
      (if (str.eq k "ltu")
      (lit "sltu g B D,xor h B D,sltiu h h 1,sltu E A C,and h h E,or A g h,addi B Z 0")
      (if (str.eq k "gts")
      (lit "slt g D B,xor h D B,sltiu h h 1,sltu E C A,and h h E,or A g h,addi B Z 0")
      (if (str.eq k "gtu")
      (lit "sltu g D B,xor h D B,sltiu h h 1,sltu E C A,and h h E,or A g h,addi B Z 0")
      (if (str.eq k "les")
      (lit "slt g D B,xor h D B,sltiu h h 1,sltu E C A,and h h E,or A g h,xori A A 1,addi B Z 0")
      (if (str.eq k "leu")
      (lit "sltu g D B,xor h D B,sltiu h h 1,sltu E C A,and h h E,or A g h,xori A A 1,addi B Z 0")
      (if (str.eq k "ges")
      (lit "slt g B D,xor h B D,sltiu h h 1,sltu E A C,and h h E,or A g h,xori A A 1,addi B Z 0")
      (if (str.eq k "geu")
      (lit "sltu g B D,xor h B D,sltiu h h 1,sltu E A C,and h h E,or A g h,xori A A 1,addi B Z 0")
      (if (str.eq k "eqz")
      (lit "or A A B,sltiu A A 1,addi B Z 0")
      (if (str.eq k "wrap")
      (lit "addi B Z 0")
      (if (str.eq k "ext8")
      (lit "slli A A 24,srai A A 24,srai B A 31")
      (if (str.eq k "ext16")
      (lit "slli A A 16,srai A A 16,srai B A 31")
      (if (str.eq k "exts")
      (lit "srai B A 31")
      (if (str.eq k "zero_check")
      (lit "or E C D,bne E Z OK,ebreak,label OK")
      (if (str.eq k "overflow_check")
      (lit "addi E C 1,addi F D 1,or E E F,bne E Z OK,lui F 524288,xor F B F,or F F A,bne F Z OK,ebreak,label OK")
      (if (str.eq k "udiv")
      (lit "addi E Z 0,addi F Z 0,addi g Z 64,label LOOP,srli h B 31,slli B B 1,srli i A 31,or B B i,slli A A 1,srli T F 31,slli F F 1,srli i E 31,or F F i,slli E E 1,or E E h,bne T Z DO,sltu i F D,xor j F D,sltiu j j 1,sltu h E C,and j j h,or i i j,bne i Z SKIP,label DO,sltu j E C,sub E E C,sub F F D,sub F F j,ori A A 1,label SKIP,addi g g -1,bne g Z LOOP")
      (if (str.eq k "sdiv")
      (lit "srli k B 31,srli l D 31,xor m k l,beq k Z S1,sltu T Z A,sub A Z A,sub B Z B,sub B B T,label S1,beq l Z S2,sltu T Z C,sub C Z C,sub D Z D,sub D D T,label S2,addi E Z 0,addi F Z 0,addi g Z 64,label LOOP,srli h B 31,slli B B 1,srli i A 31,or B B i,slli A A 1,srli T F 31,slli F F 1,srli i E 31,or F F i,slli E E 1,or E E h,bne T Z DO,sltu i F D,xor j F D,sltiu j j 1,sltu h E C,and j j h,or i i j,bne i Z SKIP,label DO,sltu j E C,sub E E C,sub F F D,sub F F j,ori A A 1,label SKIP,addi g g -1,bne g Z LOOP,beq m Z S3,sltu T Z A,sub A Z A,sub B Z B,sub B B T,label S3")
      (if (str.eq k "srem")
      (lit "srli k B 31,srli l D 31,beq k Z S1,sltu T Z A,sub A Z A,sub B Z B,sub B B T,label S1,beq l Z S2,sltu T Z C,sub C Z C,sub D Z D,sub D D T,label S2,addi E Z 0,addi F Z 0,addi g Z 64,label LOOP,srli h B 31,slli B B 1,srli i A 31,or B B i,slli A A 1,srli T F 31,slli F F 1,srli i E 31,or F F i,slli E E 1,or E E h,bne T Z DO,sltu i F D,xor j F D,sltiu j j 1,sltu h E C,and j j h,or i i j,bne i Z SKIP,label DO,sltu j E C,sub E E C,sub F F D,sub F F j,ori A A 1,label SKIP,addi g g -1,bne g Z LOOP,beq k Z S3,sltu T Z E,sub E Z E,sub F Z F,sub F F T,label S3,mov A E,mov B F")
      (if (str.eq k "urem")
