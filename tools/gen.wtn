      (if (bytes.eq n (lit "unary_code"))
      (lit "(fn unary_code ((work Bytes)) Bytes\n    (uses Alloc)\n    (cat3 (popp (r0) (r1)) work (pushp (r0) (r1))))")
      (if (bytes.eq n (lit "compare_work"))
