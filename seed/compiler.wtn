    (match (module_ir src)
      ((Err f) (concat "error: " (get f why)))
      ((Ok m) (match (checked_bounds_in m "main" src (if (str.eq chip "esp32s3") (esp32s3_room) (if (str.eq chip "esp32") (esp32_room) (if (str.eq chip "esp32p4") (esp32p4_room) (thumb_room))))) ((Err f) (concat "error: " (get f why))) ((Ok b) (concat (num.to_str (get (get b stack) operand)) (concat " " (concat (num.to_str (get (get b stack) machine)) (concat " " (concat (num.to_str (get b heap)) (concat " " (num.to_str (get b base)))))))))))))

  (fn drive_riscv_filter ((src Str)) Bytes
    (uses Alloc)
    (match (module_ir src)
      ((Err f) (str.encode (concat "error: " (get f why))))
      ((Ok m) (match (riscv_elf_of m "drive" true) ((Ok elf) elf) ((Err f) (str.encode (concat "error: " (get f why))))))))

  (fn main () Unit
    (uses Alloc Console)
    (print (match (compile_ir "(module m (fn double ((x I32)) I32 (wrap.add x x)))") ((Ok wasm) (concat "compiled " (concat (num.to_str (unwrap (bytes.len wasm))) " bytes"))) ((Err f) (concat "not compiled: " (get f why))))))

  (fn rt_byte ((b Bytes) (at Int)) Int
    (match (bytes.at b (Octets at)) ((None) 0) ((Some x) (int.of x))))

  ; Valid, or why not. The budget is four steps a byte, which is more than any text takes.
  (fn rt_utf8_check ((b Bytes)) Int
    (rt_utf8_from b 0 (unwrap (bytes.len b)) (+ (* 4 (unwrap (bytes.len b))) 8)))

  (fn rt_utf8_from ((b Bytes) (at Int) (end Int) (left Int)) Int
    (requires (<= 0 left))
    (if (or (<= left 0) (<= end at)) 0 (rt_utf8_lead b at end (- left 1) (rt_byte b at))))

  (fn rt_utf8_lead ((b Bytes) (at Int) (end Int) (left Int) (c Int)) Int
    (requires (<= 0 left))
    (if (< c 128)
      (rt_utf8_from b (+ at 1) end left)
      (if (< c 194)
        1
        (if (< c 224)
          (rt_utf8_cont b at end left 1 1 128 191)
          (if (< c 240)
            (rt_utf8_cont b at end left 1 2 (rt_lo c) (rt_hi c))
            (if (< c 245) (rt_utf8_cont b at end left 1 3 (rt_lo c) (rt_hi c)) 1))))))

  ; The range of the first continuation byte after a lead byte: narrower after E0, ED, F0
  ; and F4, which is what keeps overlong forms, surrogates and anything past U+10FFFF out.
  (fn rt_lo ((c Int)) Int (if (= c 224) 160 (if (= c 240) 144 128)))

  (fn rt_hi ((c Int)) Int (if (= c 237) 159 (if (= c 244) 143 191)))

  ; Continuation byte number `k` of `need`, which must lie in lo..hi.
  (fn rt_utf8_cont ((b Bytes) (at Int) (end Int) (left Int) (k Int) (need Int) (lo Int) (hi Int)) Int
    (requires (<= 0 left))
    (if (<= left 0)
      3
      (if (< need k)
        (rt_utf8_from b (+ at (+ need 1)) end (- left 1))
        (if (<= end (+ at k))
          3
          (rt_utf8_next b at end (- left 1) k need lo hi (rt_byte b (+ at k)))))))

  (fn rt_utf8_next ((b Bytes) (at Int) (end Int) (left Int) (k Int) (need Int) (lo Int) (hi Int) (d Int)) Int
    (requires (<= 0 left))
    (if (or (< d lo) (< hi d)) 2 (rt_utf8_cont b at end left (+ k 1) need 128 191)))

  (fn rt_reason ((code Int)) Str
    (if (= code 1)
      "invalid start byte"
      (if (= code 2) "invalid continuation byte" "unexpected end of data")))

  (fn rt_check_str ((b Bytes)) Str (rt_reason (rt_utf8_check b))))
