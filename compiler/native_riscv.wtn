  (enum VChunks (VNoChunks) (VChunks (head Bytes) (rest VChunks)))

  (fn merged ((cs VChunks)) VChunks
    (uses Alloc)
    (match cs
      ((VNoChunks) (VNoChunks))
      ((VChunks a rest) (match rest ((VNoChunks) (VChunks a (VNoChunks))) ((VChunks b more) (VChunks (bytes.concat a b) (merged more)))))))

  (fn joined_in ((cs VChunks) (rounds U32)) Bytes
    (uses Alloc)
    (match cs
      ((VNoChunks) (no_bytes))
      ((VChunks a rest) (match rest ((VNoChunks) a) ((VChunks b more) (if (<= rounds (u32.of 0)) (bytes.concat a (joined_linear rest)) (joined_in (merged cs) (- rounds (u32.of 1)))))))))

  (fn joined_linear ((cs VChunks)) Bytes
    (uses Alloc)
    (match cs
      ((VNoChunks) (no_bytes))
      ((VChunks a rest) (bytes.concat a (joined_linear rest)))))

  (fn joined ((cs VChunks)) Bytes
    (uses Alloc)
    (joined_in cs (u32.of 40)))

  ; The bytes of a function whose first byte is at `at`, appended before `tail`.
  
  (fn code_to ((is VItems) (at U32) (ls VLabels) (ss VStarts) (tail VChunks)) VChunks
    (uses Alloc)
    (match is
      ((VNoItems) tail)
      ((VItems h rest) (VChunks (item_bytes h at ls ss) (code_to rest (wrap.add at (item_size h)) ls ss tail)))))

  ; --- the module ----------------------------------------------------------------------------------------------
  
  (fn shapes_of ((fs Funcs)) VShapes
    (match fs
      ((NoFuncs) (VNoShapes))
      ((Funcs f rest) (VShapes (get f params) (get f results) (shapes_of rest)))))

  (fn hostfns_of ((is Imports)) VHostfns
    (match is
      ((NoImports) (VNoHostfns))
      ((Imports i rest) (VHostfns (get i name) (get i params) (get i results) (hostfns_of rest)))))

  ; A function: the frame, the body, the way out.
  
  (fn function_items ((f Func) (shapes VShapes) (hosts VHostfns)) VItems
    (uses Alloc)
    (let fx (make VFx (params (get f params)) (locals (get f locals)) (results (get f results)) (shapes shapes) (hosts hosts))
