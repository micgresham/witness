; Witness to RISC-V (RV64IM) Linux, from the same instructions the other backends write.
;
; compiler/native_arm.wtn does this for AArch64; this is the same translation with a third
; machine behind it, and everything that decides what a program means -- layout, widths,
; tags, tail calls, the capabilities -- is not here because it was decided before any
; machine was chosen. What is here is the machine:
;
;   the operand stack  a second stack in s6, growing down; the machine stack (sp) holds only
;                      return addresses and saved frame pointers
;   a frame            s0 points at the operand stack as the call began: parameters are
;                      above it, locals below, and a branch restores s6 from it
;   memory             one region mapped at startup, its base in s2
;   the heap pointer   s3, and the page count `memory.size` answers in s4
;
; RISC-V has no flags, so a comparison leaves 0 or 1 in a register and a branch compares two
; registers; and it has no register-plus-register addressing, so a load or store of a
; wasm address adds first. Division by zero answers -1 and the most negative number over -1
; answers itself, so the checks that make those traps are written out. A conditional jump
; is the opposite branch over an unconditional `jal`, a call is `auipc` and `jalr`, so every
; jump's size is known before any address is.
;
; The evidence is tests/test_native_riscv.py, which has no RISC-V machine to run on and uses
; an emulator instead: the ELF file is loaded, a handful of system calls are answered, and
; what it prints is compared with the interpreter's.
;
;   witness test compiler/native_riscv.wtn
(module native_riscv
  (use "wtn:aaa5788594cd2f68165abd0f2e6560c4aa6aaf92e09822948cc887f7cd927be5" as Module)

  (use "wtn:3e591891f9cf54232e04bb14b46fe1ad8efe8c82e1ddad2a481589bba3844f43" as Funcs)

  (use "wtn:780cd5f1caffd09ae27df62731b93b0f47c18f7b93487643ce22510a7c5f029b" as Func)

  (use "wtn:746b7af1483e2ad3bac5bd48a927f405dda763ad2e13285b41298d2d268a366f" as Imports)

  (use "wtn:1d8850cc1eac3078061af0c4abac9ffb8c04c7f625724d647535443ad3cd3899" as Segments)

  (use "wtn:6049eb96cd5bb0261e93f3b63d858e9295b28d4454c9d335d6fc6b7357255c97" as Segment)

  (use "wtn:1073bcf7f2ec07adcc09eb7c2e8fe48e9f9e9761a767076f6172edba3db8cde8" as Inss)

  (use "wtn:a21c39d745ed071e8a191a37f70dd1779e3f66cef78971e75cc5db8d15985d3a" as Ins)

  (use "wtn:3752be75d9b35195f27bce3966247382cbf1f4b367ca42472081c4579c41a784" as low8)

  (use "wtn:30701617d68c3654a403fd5dedb917a11d116e4e5ce3d16cc8059f76e8f0b497" as imm32)

  (use "wtn:8be2edc17933e3f38aba6ee3bc6960aaa2e82f42c8b8022ec3d187702ed47a20" as imm64)

  (use "wtn:68ae8704bba089cacc5e52b5debb2e3761c8f0c5ced02256764b36bdd6684111" as add_rr)

  (use "wtn:ba5fded0ea81a502e8485e13ad00aa3154158e524cac42c5e3a0e9fd70dc93d6" as addi)

  (use "wtn:b3cb63d23167ee61cfb3f2331f298063515f36e3a4d3266cfb6c48944c3b5c23" as addiw)

  (use "wtn:08a1eb4db878ae815464ca2910a33ff4efecffdd418aaf25cee4208f4463d18b" as and_rr)

  (use "wtn:1c4dcb0abdb7e7d3353bf26e3960b12a0e3a8a3f475812beabbf7b5884ad9b62" as at)

  (use "wtn:21681c9e519181936697ac6bdcd736655272e59cde81b97d2f158c1b7bc07c41" as beq)

  (use "wtn:0c86e7c71ec2d18cf592aeef19d765d8dfc825f3babbc752a350128f8aecc2b8" as bne)

  (use "wtn:10fd48b4a99d2b8e3f9f4c0fecc7268d841285ef9e762af32412526e285a6af2" as branch_not)

  (use "wtn:be8a5fb369318dd602364f0e75a8b18bea5974a0b6213db771c32631001498c0" as byte)

  (use "wtn:ea3350c7b2de815c4a0e7849377b50dde3055a885a05400185483003489b7231" as call)

  (use "wtn:b4c30c933f20492139cd75ccd80a62f20d2086507bfd8bd1c48edeee3595699c" as div_rr)

  (use "wtn:0886685daa78a1a15447f173ddf3a9e4b379d10c472ecf16907c649898030b4f" as divu_rr)

  (use "wtn:8ae1a91f3a1475c5b803c1911d483cad66783a2b063cae46d51778e726718427" as ebreak)

  (use "wtn:da5ab21d5eaddbb80b18245d2ee7fe6fcdb775f12e6c0d7ee5fa668df01b0518" as ecall)

  (use "wtn:0d97087e32508d5b6046e7c2be770a1a380b00bd0f8d9d53c13771c5876cd9d3" as jal)

  (use "wtn:dc9b8b97089c0aceddf03e639f9d1ab467b0c664a7609e39900e0f853b7d3ce4" as lbu)

  (use "wtn:fcefb72b902c6b3005f0b1e96f74b4c726fc0887628dedcffcb7e5ec165f1ef2" as ld)

  (use "wtn:cfbebf552000f02d9ac6400542873e0fd7884deda641953957f7d8c34b4695ff" as mov_imm)

  (use "wtn:2cd3c0854420bda9bdfdab0dd25ee0d20f8f795ab85255f23474c7d6e4a36ee9" as mov_rr)

  (use "wtn:7c95fc0e0383e6a3144d6f4603939dadbd404f9fc85faa41d3a4463e8aabd97a" as mul_rr)

  (use "wtn:7e3d2280bb3eccd493d0bcbe3d8a8ca1fa5aed6b4fa0c4ffc0b33e38da914cec" as or_rr)

  (use "wtn:ba512af04225bf44514732ba9265490d6b81241fe8e83843e00b46289d694278" as plus)

  (use "wtn:0ef60c4970a31734ae71651ab34fdd67a5903565f4b8c23e879c7f9d3072316d" as pop_frame)

  (use "wtn:2254834578d50e79c37569793bc40d7c5e5865b0fe075cfabcaeec8cec3ffc3c" as push_frame)

  (use "wtn:be7a2fc6e4953c87ce1bdac505f41323be2cffbfd8be7af6cea1f71d5050bc60" as rem_rr)

  (use "wtn:9499c0d9057034bd438821d9c56d6c9d4f273b8784119223f4c554ebd0ba1aa8" as remu_rr)

  (use "wtn:6363a4c8486044dfedee4e2a2dd615340bd5ed9a9159afc6bd3b911449e3e295" as ret)

  (use "wtn:58f9129b8f6063d6138939f03b96bd541ad165602db7adca21b89e9cf5b3d395" as sb)

  (use "wtn:32fcc5b956fbedad815112c4f538c3db1acf09f6aaa842ede82b4a63ed19761b" as sd)

  (use "wtn:d0568ec25e7517b17435c6c8449f1de9787e60d523f7b19fdbebb84e920727ec" as sll_rr)

  (use "wtn:15750ccfb06ba27babead9847cd70c5b6b6bce1a0e7138328ccea0ba4ee92b32" as slli)

  (use "wtn:986e1fefacda5c278356f67e095cf3e901d2932c12d95ec681ec860ebb183914" as slt_rr)

  (use "wtn:cc564459489fca5120bb99d38281f9de7aca507a3adbeb9f76be6c1751287543" as sltiu)

  (use "wtn:8d33869643c52b0f96ec28a47ffc0f90b08adf43853636367b11a0418961805a" as sltu_rr)

  (use "wtn:c24ffaa6343c5c383de9178d780de757fbac561f24880997f1071a44db175c66" as sra_rr)

  (use "wtn:d0c5e02595b15f38f2264df503027ad131779dc5d755c9402f08c4675b39b34e" as srai)

  (use "wtn:8cfb556f8ff00ed7e54d9b6b6b0ed88a11a82c0d9a8846449743b6397a509d72" as srl_rr)

  (use "wtn:eecc35d31e67f9e6ca4dec0175bc675bb40eeda058f84d158a83fe07353c5c94" as srli)

  (use "wtn:55a44ea91923b099d3ff4511a151e63c4722c3c674c80e3591353cf4cbf4e187" as sub_rr)

  (use "wtn:6f843540f10a7ecaeb781fafae3f5642023cc91afe8af4ed77592ae0c5ac3043" as xor_rr)

  (use "wtn:3e9890c2967a78bab299c4928a9055fc2375d9dc47fe6bd3583b6e41f5b45868" as xori)

  (fn no_bytes () Bytes
    (uses Alloc)
    (str.encode ""))

  (fn octets ((b Bytes)) U32
    (let n (unwrap (bytes.len b)) (if (<= n 4294967295) (u32.of n) (u32.of 0))))

  (fn greater ((a U32) (b U32)) U32 (if (< a b) b a))

  (fn less ((a U32) (b U32)) U32 (if (< a b) (u32.of 0) (- a b)))

  (enum VItem
    (VRaw (code Bytes))
    (VMark (id U32))
    (VJump (id U32))
    (VJumpIf (f3 U32) (a U32) (b U32) (id U32))
    (VCallFn (func U32)))

  (enum VItems (VNoItems) (VItems (head VItem) (rest VItems)))

  (fn items_join ((a VItems) (b VItems)) VItems
    (match a ((VNoItems) b) ((VItems h rest) (VItems h (items_join rest b)))))

  (fn raw ((code Bytes)) VItems (VItems (VRaw code) (VNoItems)))

  (fn item ((i VItem)) VItems (VItems i (VNoItems)))

  (fn item_size ((i VItem)) U32
    (match i
      ((VRaw code) (octets code))
      ((VMark id) (u32.of 0))
      ((VJump id) (u32.of 4))
      ((VJumpIf f3 a b id) (u32.of 8))
      ((VCallFn func) (u32.of 8))))

  (fn items_size ((is VItems)) U32
    (match is
      ((VNoItems) (u32.of 0))
      ((VItems h rest) (wrap.add (item_size h) (items_size rest)))))

  (enum VLabels (VNoLabels) (VLabels (id U32) (offset U32) (rest VLabels)))

  (fn labels_of ((is VItems) (at U32)) VLabels
    (match is
      ((VNoItems) (VNoLabels))
      ((VItems h rest) (match h ((VMark id) (VLabels id at (labels_of rest at))) ((VRaw code) (labels_of rest (wrap.add at (item_size h)))) ((VJump id) (labels_of rest (wrap.add at (item_size h)))) ((VJumpIf f3 a b id) (labels_of rest (wrap.add at (item_size h)))) ((VCallFn func) (labels_of rest (wrap.add at (item_size h))))))))

  (fn label_at ((ls VLabels) (mark U32)) U32
    (match ls
      ((VNoLabels) (u32.of 0))
      ((VLabels l offset rest) (if (= l mark) offset (label_at rest mark)))))

  (enum VStarts (VNoStarts) (VStarts (offset U32) (rest VStarts)))

  (fn start_of ((ss VStarts) (index U32)) U32
    (match ss
      ((VNoStarts) (u32.of 0))
      ((VStarts offset rest) (if (<= index (u32.of 0)) offset (start_of rest (- index (u32.of 1)))))))

  ; The distance from `at` to `target` in bytes, which is how a branch says it.
  (fn distance ((target U32) (at U32)) I64 (wrap.sub (i64.of target) (i64.of at)))

  ; A conditional jump is the opposite branch over an unconditional one, which reaches a
  ; megabyte either way where a branch alone reaches four kilobytes.
  (fn item_bytes ((i VItem) (at U32) (ls VLabels) (ss VStarts)) Bytes
    (uses Alloc)
    (match i
      ((VRaw code) code)
      ((VMark id) (no_bytes))
      ((VJump id) (jal (zero) (distance (label_at ls id) at)))
      ((VJumpIf f3 a b id) (cat (branch_not f3 a b (i64.of 8)) (jal (zero) (distance (label_at ls id) (wrap.add at (u32.of 4))))))
      ((VCallFn func) (call (distance (start_of ss func) at)))))

  ; --- registers ---------------------------------------------------------------------------------
  
  (fn r0 () U32 (u32.of 10))

  (fn r1 () U32 (u32.of 11))

  (fn r2 () U32 (u32.of 12))

  (fn r3 () U32 (u32.of 13))

  (fn r4 () U32 (u32.of 14))

  (fn r5 () U32 (u32.of 15))

  ; --- registers --------------------------------------------------------------------------------
  ; The arguments of a system call are a0 to a5 and its number is in a7. The rest are chosen
  ; from the registers a function preserves: the memory base in s2, the heap pointer in s3,
  ; the page count in s4, a saved value in s5, the operand stack in s6, the frame in s0 (x8).
  (fn zero () U32 (u32.of 0))

  (fn sp () U32 (u32.of 2))

  (fn tmp () U32 (u32.of 5))

  (fn fp () U32 (u32.of 8))

  (fn sn () U32 (u32.of 17))

  (fn mem () U32 (u32.of 18))

  (fn hp () U32 (u32.of 19))

  (fn pg () U32 (u32.of 20))

  (fn sv () U32 (u32.of 21))

  (fn os () U32 (u32.of 22))

  (fn cat ((a Bytes) (b Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a b))

  (fn cat3 ((a Bytes) (b Bytes) (c Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b c)))

  (fn cat4 ((a Bytes) (b Bytes) (c Bytes) (d Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b (bytes.concat c d))))

  ; Pushing and popping the operand stack, which lives in s6 and grows down.
  (fn push ((r U32)) Bytes
    (uses Alloc)
    (cat (sd r (os) (i64.of -8)) (addi (os) (os) (i64.of -8))))

  (fn pop ((r U32)) Bytes
    (uses Alloc)
    (cat (ld r (os) (i64.of 0)) (addi (os) (os) (i64.of 8))))

  ; Loads and stores at the sum of two registers, which RV64 has no instruction for.
  (fn ldx ((dst U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (ld dst (tmp) (i64.of 0))))

  (fn sdx ((src U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (sd src (tmp) (i64.of 0))))

  (fn lbux ((dst U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (lbu dst (tmp) (i64.of 0))))

  (fn sbx ((src U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (sb src (tmp) (i64.of 0))))

  ; d = n + imm for any imm, by way of tmp when it does not fit in twelve bits.
  (fn add_big ((d U32) (n U32) (imm I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of -2048) imm) (<= imm (i64.of 2047)))
      (addi d n imm)
      (cat (mov_imm (tmp) imm) (add_rr d n (tmp)))))

  ; A frame-relative word. Parameters sit above s0 and locals below it.
  (fn frame_load ((dst U32) (disp I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of -2048) disp) (<= disp (i64.of 2047)))
      (ld dst (fp) disp)
      (cat (mov_imm (tmp) disp) (ldx dst (fp) (tmp)))))

  (fn frame_store ((src U32) (disp I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of -2048) disp) (<= disp (i64.of 2047)))
      (sd src (fp) disp)
      (cat (mov_imm (tmp) disp) (sdx src (fp) (tmp)))))

  (fn widen ((n U32)) I64 (i64.of n))

  ; --- what the translator knows about the function ----------------------------------------------
  
  (enum VShapes (VNoShapes) (VShapes (params U32) (results U32) (rest VShapes)))

  (fn shape_at ((ss VShapes) (index U32)) (Option VShapes)
    (match ss
      ((VNoShapes) (None))
      ((VShapes p r rest) (if (<= index (u32.of 0)) (Some ss) (shape_at rest (- index (u32.of 1)))))))

  (enum VHostfns
    (VNoHostfns)
    (VHostfns (name Str) (params U32) (results U32) (rest VHostfns)))

  (fn host_at ((hs VHostfns) (slot U32)) (Option VHostfns)
    (match hs
      ((VNoHostfns) (None))
      ((VHostfns n p r rest) (if (<= slot (u32.of 0)) (Some hs) (host_at rest (- slot (u32.of 1)))))))

  (record VFx (params U32) (locals U32) (results U32) (shapes VShapes) (hosts VHostfns))

  ; A local's place relative to x29: parameters were pushed by the caller, the first deepest.
  
  (fn local_disp ((fx VFx) (index U32)) I64
    (if (< index (get fx params))
      (widen (wrap.mul (wrap.sub (wrap.sub (get fx params) (u32.of 1)) index) (u32.of 8)))
      (wrap.sub (i64.of 0)
        (widen (wrap.mul (wrap.add (wrap.sub index (get fx params)) (u32.of 1)) (u32.of 8))))))

  ; Where x28 is when `h` values are on the operand stack, as a distance below x29.
  
  (fn frame_depth ((fx VFx) (h U32)) U32 (wrap.mul (wrap.add (get fx locals) h) (u32.of 8)))

  (fn set_stack ((fx VFx) (h U32)) Bytes
    (uses Alloc)
    (add_big (os) (fp) (wrap.sub (i64.of 0) (widen (frame_depth fx h)))))

  ; --- the state of the walk --------------------------------------------------------------------------
  
  (record VSt (h U32) (next U32) (dead Bool))

  (record VWalked (items VItems) (st VSt))

  ; A block that can be branched to: the mark a branch goes to (the start of a loop, the
  ; end of anything else), the height it expects, and how many values a branch carries.
  
  (enum VCtrl (VNoCtrl) (VCtrl (target U32) (height U32) (carries U32) (rest VCtrl)))

  (fn ctrl_at ((c VCtrl) (depth U32)) (Option VCtrl)
    (match c
      ((VNoCtrl) (None))
      ((VCtrl t h a rest) (if (<= depth (u32.of 0)) (Some c) (ctrl_at rest (- depth (u32.of 1)))))))

  (fn with_h ((st VSt) (h U32)) VSt (make VSt (h h) (next (get st next)) (dead false)))

  (fn walked ((code Bytes) (st VSt) (h U32)) VWalked
    (make VWalked (items (raw code)) (st (with_h st h))))

  (fn nothing ((st VSt)) VWalked (make VWalked (items (VNoItems)) (st st)))

  (fn walked_join ((a VWalked) (b VWalked)) VWalked
    (make VWalked (items (items_join (get a items) (get b items))) (st (get b st))))

  ; --- one instruction ---------------------------------------------------------------------------------
  
  (fn binary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat4 (pop (r1)) (pop (r0)) work (push (r0))))

  (fn unary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat3 (pop (r0)) work (push (r0))))

  ; i64 comparison opcodes 81 to 90 leave 0 or 1 in a0, the left operand in a0 and the right in a1.
  (fn compare_work ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 81))
      (Some (cat (sub_rr (r0) (r0) (r1)) (sltiu (r0) (r0) (i64.of 1))))
      (if (= code (u8.of 82))
        (Some (cat (sub_rr (r0) (r0) (r1)) (sltu_rr (r0) (zero) (r0))))
        (if (= code (u8.of 83))
          (Some (slt_rr (r0) (r0) (r1)))
          (if (= code (u8.of 84))
            (Some (sltu_rr (r0) (r0) (r1)))
            (if (= code (u8.of 85))
              (Some (slt_rr (r0) (r1) (r0)))
              (if (= code (u8.of 86))
                (Some (sltu_rr (r0) (r1) (r0)))
                (compare_negated code))))))))

  (fn compare_negated ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 87))
      (Some (cat (slt_rr (r0) (r1) (r0)) (xori (r0) (r0) (i64.of 1))))
      (if (= code (u8.of 88))
        (Some (cat (sltu_rr (r0) (r1) (r0)) (xori (r0) (r0) (i64.of 1))))
        (if (= code (u8.of 89))
          (Some (cat (slt_rr (r0) (r0) (r1)) (xori (r0) (r0) (i64.of 1))))
          (if (= code (u8.of 90))
            (Some (cat (sltu_rr (r0) (r0) (r1)) (xori (r0) (r0) (i64.of 1))))
            (None))))))

  (fn alu_work ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 124))
      (Some (add_rr (r0) (r0) (r1)))
      (if (= code (u8.of 125))
        (Some (sub_rr (r0) (r0) (r1)))
        (if (= code (u8.of 126))
          (Some (mul_rr (r0) (r0) (r1)))
          (if (= code (u8.of 131))
            (Some (and_rr (r0) (r0) (r1)))
            (if (= code (u8.of 132))
              (Some (or_rr (r0) (r0) (r1)))
              (if (= code (u8.of 133))
                (Some (xor_rr (r0) (r0) (r1)))
                (if (= code (u8.of 134))
                  (Some (sll_rr (r0) (r0) (r1)))
                  (if (= code (u8.of 135))
                    (Some (sra_rr (r0) (r0) (r1)))
                    (if (= code (u8.of 136))
                      (Some (srl_rr (r0) (r0) (r1)))
                      (if (= code (u8.of 114))
                        (Some (or_rr (r0) (r0) (r1)))
                        (if (= code (u8.of 113)) (Some (and_rr (r0) (r0) (r1))) (None)))))))))))))

  ; A divisor of zero traps: skip the trap when a1 is not zero.
  (fn zero_check () Bytes
    (uses Alloc)
    (cat (bne (r1) (zero) (i64.of 8)) (ebreak)))

  ; The most negative number over -1 traps too, as WebAssembly says it does.
  (fn overflow_check () Bytes
    (uses Alloc)
    (cat4 (addi (r2) (r1) (i64.of 1))
      (bne (r2) (zero) (i64.of 20))
      (cat (addi (r3) (zero) (i64.of 1)) (slli (r3) (r3) (u32.of 63)))
      (cat (bne (r0) (r3) (i64.of 8)) (ebreak))))

  (fn divide_code ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 127))
      (Some (binary_code (cat3 (zero_check) (overflow_check) (div_rr (r0) (r0) (r1)))))
      (if (= code (u8.of 128))
        (Some (binary_code (cat (zero_check) (divu_rr (r0) (r0) (r1)))))
        (if (= code (u8.of 129))
          (Some (binary_code (cat (zero_check) (rem_rr (r0) (r0) (r1)))))
          (if (= code (u8.of 130))
            (Some (binary_code (cat (zero_check) (remu_rr (r0) (r0) (r1)))))
            (None))))))

  (fn unary_work ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 80))
      (Some (sltiu (r0) (r0) (i64.of 1)))
      (if (= code (u8.of 69))
        (Some (sltiu (r0) (r0) (i64.of 1)))
        (if (= code (u8.of 167))
          (Some (cat (slli (r0) (r0) (u32.of 32)) (srli (r0) (r0) (u32.of 32))))
          (if (= code (u8.of 173))
            (Some (no_bytes))
            (if (= code (u8.of 194))
              (Some (cat (slli (r0) (r0) (u32.of 56)) (srai (r0) (r0) (u32.of 56))))
              (if (= code (u8.of 195))
                (Some (cat (slli (r0) (r0) (u32.of 48)) (srai (r0) (r0) (u32.of 48))))
                (if (= code (u8.of 196)) (Some (addiw (r0) (r0) (i64.of 0))) (None)))))))))

  (fn op_step ((fx VFx) (code U8) (st VSt)) VWalked
    (uses Alloc)
    (match (compare_work code)
      ((Some work) (walked (binary_code work) st (less (get st h) (u32.of 1))))
      ((None) (match (alu_work code) ((Some work) (walked (binary_code work) st (less (get st h) (u32.of 1)))) ((None) (match (divide_code code) ((Some work) (walked work st (less (get st h) (u32.of 1)))) ((None) (match (unary_work code) ((Some work) (walked (unary_code work) st (get st h))) ((None) (other_op fx code st))))))))))

  (fn other_op ((fx VFx) (code U8) (st VSt)) VWalked
    (uses Alloc)
    (if (= code (u8.of 26))
      (walked (addi (os) (os) (i64.of 8)) st (less (get st h) (u32.of 1)))
      (if (= code (u8.of 27))
        (walked (cat4 (pop (r2)) (pop (r1)) (pop (r0)) (cat3 (bne (r2) (zero) (i64.of 8)) (mov_rr (r0) (r1)) (push (r0))))
          st
          (less (get st h) (u32.of 2)))
        (if (= code (u8.of 1))
          (nothing st)
          (if (= code (u8.of 15))
            (make VWalked
              (items (raw (epilogue fx)))
              (st (make VSt (h (get st h)) (next (get st next)) (dead true))))
            (make VWalked
              (items (raw (ebreak)))
              (st (make VSt (h (get st h)) (next (get st next)) (dead true)))))))))

  (fn epilogue ((fx VFx)) Bytes
    (uses Alloc)
    (cat4 (if (= (get fx results) (u32.of 0)) (no_bytes) (pop (r0)))
      (add_big (os) (fp) (widen (wrap.mul (get fx params) (u32.of 8))))
      (pop_frame)
      (ret)))

  (fn prologue ((fx VFx)) Bytes
    (uses Alloc)
    (cat4 (push_frame)
      (mov_rr (fp) (os))
      (mov_imm (r0) (i64.of 0))
      (pushes (get fx locals))))

  (fn pushes ((n U32)) Bytes
    (uses Alloc)
    (if (<= n (u32.of 0)) (no_bytes) (cat (push (r0)) (pushes (- n (u32.of 1))))))

  ; --- the walk ------------------------------------------------------------------------------------------
  
  (fn walk ((fx VFx) (ctrl VCtrl) (is Inss) (st VSt)) VWalked
    (uses Alloc)
    (match is
      ((NoInss) (nothing st))
      ((Inss i rest) (if (get st dead) (nothing st) (let first (step fx ctrl i st) (walked_join first (walk fx ctrl rest (get first st))))))))

  (fn step ((fx VFx) (ctrl VCtrl) (i Ins) (st VSt)) VWalked
    (uses Alloc)
    (match i
      ((WConst n) (walked (cat (mov_imm (r0) n) (push (r0))) st (wrap.add (get st h) (u32.of 1))))
      ((WLocalGet x) (walked (cat (frame_load (r0) (local_disp fx x)) (push (r0))) st (wrap.add (get st h) (u32.of 1))))
      ((WLocalSet x) (walked (cat (pop (r0)) (frame_store (r0) (local_disp fx x))) st (less (get st h) (u32.of 1))))
      ((WLocalTee x) (walked (cat (ld (r0) (os) (i64.of 0)) (frame_store (r0) (local_disp fx x))) st (get st h)))
      ((WGlobalGet x) (walked (push (hp)) st (wrap.add (get st h) (u32.of 1))))
      ((WGlobalSet x) (walked (pop (hp)) st (less (get st h) (u32.of 1))))
      ((WOp code) (op_step fx code st))
      ((WLoad code align offset) (walked (load_code code offset) st (get st h)))
      ((WStore code align offset) (walked (store_code code offset) st (less (get st h) (u32.of 2))))
      ((WCall f) (call_step fx f st))
      ((WHost slot) (host_step fx slot st))
      ((WIf value then other) (let otherwise (get st next) (let end (wrap.add otherwise (u32.of 1)) (let h0 (less (get st h) (u32.of 1)) (let inner (VCtrl end h0 (arity value) ctrl) (let yes (walk fx inner then (make VSt (h h0) (next (wrap.add end (u32.of 1))) (dead false))) (let no (walk fx inner other (with_h (get yes st) h0)) (if_result yes no otherwise end h0 value))))))))
      ((WBlock value body) (let end (get st next) (let h0 (get st h) (block_result (walk fx (VCtrl end h0 (arity value) ctrl) body (make VSt (h h0) (next (wrap.add end (u32.of 1))) (dead false))) end h0 value))))
      ((WLoop value body) (let start (get st next) (let h0 (get st h) (loop_result (walk fx (VCtrl start h0 (u32.of 0) ctrl) body (make VSt (h h0) (next (wrap.add start (u32.of 1))) (dead false))) start h0 value))))
      ((WBr depth) (branch_step fx ctrl depth false st))
      ((WBrIf depth) (branch_step fx ctrl depth true st))
      ((WCopy) (walked (copy_code) st (less (get st h) (u32.of 3))))
      ((WFill) (make VWalked (items (raw (ebreak))) (st (make VSt (h (get st h)) (next (get st next)) (dead true)))))
      ((WMemSize) (walked (push (pg)) st (wrap.add (get st h) (u32.of 1))))
      ((WMemGrow) (walked (cat4 (pop (r0)) (mov_rr (r1) (pg)) (add_rr (pg) (pg) (r0)) (push (r1))) st (get st h)))))

  ; The address in a0 plus the instruction's offset.
  (fn with_offset ((disp U32)) Bytes
    (uses Alloc)
    (if (<= disp (u32.of 0))
      (no_bytes)
      (if (< disp (u32.of 2048))
        (addi (r0) (r0) (widen disp))
        (cat (mov_imm (r1) (widen disp)) (add_rr (r0) (r0) (r1))))))

  (fn load_code ((code U8) (disp U32)) Bytes
    (uses Alloc)
    (if (= code (u8.of 49))
      (cat4 (pop (r0)) (with_offset disp) (lbux (r0) (mem) (r0)) (push (r0)))
      (cat4 (pop (r0)) (with_offset disp) (ldx (r0) (mem) (r0)) (push (r0)))))

  (fn store_code ((code U8) (disp U32)) Bytes
    (uses Alloc)
    (if (= code (u8.of 60))
      (cat4 (pop (r1)) (pop (r0)) (with_offset disp) (sbx (r1) (mem) (r0)))
      (cat4 (pop (r1)) (pop (r0)) (with_offset disp) (sdx (r1) (mem) (r0)))))

  ; memory.copy: length, source, destination popped, then a byte loop.
  (fn copy_code () Bytes
    (uses Alloc)
    (cat4 (cat3 (pop (r2)) (pop (r1)) (pop (r0)))
      (cat (add_rr (r0) (r0) (mem)) (add_rr (r1) (r1) (mem)))
      (copy_loop)
      (no_bytes)))

  (fn call_step ((fx VFx) (f U32) (st VSt)) VWalked
    (uses Alloc)
    (match (shape_at (get fx shapes) f)
      ((None) (nothing st))
      ((Some found) (match found ((VNoShapes) (nothing st)) ((VShapes params results more) (let after (wrap.add (less (get st h) params) results) (make VWalked (items (items_join (item (VCallFn f)) (if (= results (u32.of 0)) (VNoItems) (raw (push (r0)))))) (st (with_h st after)))))))))

  ; --- blocks --------------------------------------------------------------------------------------------------
  
  (fn arity ((value Bool)) U32 (if value (u32.of 1) (u32.of 0)))

  (fn block_result ((inside VWalked) (end U32) (h0 U32) (value Bool)) VWalked
    (make VWalked
      (items (items_join (get inside items) (item (VMark end))))
      (st (make VSt (h (wrap.add h0 (arity value))) (next (get (get inside st) next)) (dead false)))))

  (fn loop_result ((inside VWalked) (start U32) (h0 U32) (value Bool)) VWalked
    (make VWalked
      (items (items_join (item (VMark start)) (get inside items)))
      (st (make VSt (h (wrap.add h0 (arity value))) (next (get (get inside st) next)) (dead false)))))

  ; pop the condition; if it is zero go to `else`; then, jump to the end; else; end.
  
  (fn if_result ((yes VWalked) (no VWalked) (otherwise U32) (end U32) (h0 U32) (value Bool)) VWalked
    (uses Alloc)
    (make VWalked
      (items (items_join (raw (pop (r0))) (items_join (item (VJumpIf (u32.of 0) (r0) (zero) otherwise)) (items_join (get yes items) (items_join (item (VJump end)) (items_join (item (VMark otherwise)) (items_join (get no items) (item (VMark end)))))))))
      (st (make VSt (h (wrap.add h0 (arity value))) (next (get (get no st) next)) (dead false)))))

  ; Put the stack where the target expects it, carrying the value a branch carries, and go.
  
  (fn jump_code ((fx VFx) (found VCtrl)) VItems
    (uses Alloc)
    (match found
      ((VNoCtrl) (VNoItems))
      ((VCtrl target height carries rest) (items_join (raw (cat3 (if (= carries (u32.of 0)) (no_bytes) (pop (r0))) (set_stack fx height) (if (= carries (u32.of 0)) (no_bytes) (push (r0))))) (item (VJump target))))))

  (fn branch_step ((fx VFx) (ctrl VCtrl) (depth U32) (conditional Bool) (st VSt)) VWalked
    (uses Alloc)
    (match (ctrl_at ctrl depth)
      ((None) (nothing st))
      ((Some found) (if conditional (let skip (get st next) (make VWalked (items (items_join (raw (pop (r0))) (items_join (item (VJumpIf (u32.of 0) (r0) (zero) skip)) (items_join (jump_code fx found) (item (VMark skip)))))) (st (make VSt (h (less (get st h) (u32.of 1))) (next (wrap.add skip (u32.of 1))) (dead false))))) (make VWalked (items (jump_code fx found)) (st (make VSt (h (get st h)) (next (get st next)) (dead true))))))))

  ; --- the host ----------------------------------------------------------------------------------------------------
  
  (fn host_step ((fx VFx) (slot U32) (st VSt)) VWalked
    (uses Alloc)
    (match (host_at (get fx hosts) slot)
      ((None) (nothing st))
      ((Some found) (match found ((VNoHostfns) (nothing st)) ((VHostfns name params results more) (let after (wrap.add (less (get st h) params) results) (walked (host_code name) st after)))))))

  (fn syscall_with ((number I64)) Bytes
    (uses Alloc)
    (cat (mov_imm (sn) number) (ecall)))

  ; write(fd, x1, x2)
  
  (fn write_code ((fd I64)) Bytes
    (uses Alloc)
    (cat (mov_imm (r0) fd) (syscall_with (i64.of 64))))

  ; Write text held in a constant by way of the operand stack, then take it off again.
  (fn write_constant ((fd I64) (text I64) (length I64)) Bytes
    (uses Alloc)
    (cat4 (cat (mov_imm (r5) text) (push (r5)))
      (cat (mov_rr (r1) (os)) (mov_imm (r2) length))
      (write_code fd)
      (addi (os) (os) (i64.of 8))))

  ; Pop the address of a string and write it, then a newline, to a descriptor; a prefix first
  ; when there is one. a4 holds the address across the system calls.
  (fn print_code ((fd I64) (prefix Bytes)) Bytes
    (uses Alloc)
    (cat4 (pop (r4))
      prefix
      (cat3 (ldx (r2) (mem) (r4))
        (add_rr (r1) (mem) (r4))
        (addi (r1) (r1) (i64.of 8)))
      (cat (write_code fd) (write_constant fd (i64.of 10) (i64.of 1)))))

  ; clock_gettime(which, &ts), the time in nanoseconds divided by `divide`, pushed.
  (fn clock_code ((which I64) (divide I64)) Bytes
