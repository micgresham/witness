          (items_join (get walked_body items) (raw (epilogue fx)))))))

  (enum VBodies (VNoBodies) (VBodies (items VItems) (rest VBodies)))

  (fn bodies_of ((fs Funcs) (shapes VShapes) (hosts VHostfns)) VBodies
    (uses Alloc)
    (match fs
      ((NoFuncs) (VNoBodies))
      ((Funcs f rest) (VBodies (function_items f shapes hosts) (bodies_of rest shapes hosts)))))

  ; Where each function starts, given where the first does.
  
  (fn starts_from ((bs VBodies) (at U32)) VStarts
    (match bs
      ((VNoBodies) (VNoStarts))
      ((VBodies is rest) (VStarts at (starts_from rest (wrap.add at (items_size is)))))))

  (fn bodies_end ((bs VBodies) (at U32)) U32
    (match bs
      ((VNoBodies) at)
      ((VBodies is rest) (bodies_end rest (wrap.add at (items_size is))))))

  (fn bodies_to ((bs VBodies) (at U32) (ss VStarts) (tail VChunks)) VChunks
    (uses Alloc)
    (match bs
      ((VNoBodies) tail)
      ((VBodies is rest) (code_to is at (labels_of is at) ss (bodies_to rest (wrap.add at (items_size is)) ss tail)))))

  (fn index_of_func ((fs Funcs) (name Str) (at U32)) (Option U32)
    (match fs
      ((NoFuncs) (None))
      ((Funcs f rest) (if (str.eq (get f name) name) (Some at) (index_of_func rest name (wrap.add at (u32.of 1)))))))

  ; --- the memory image ----------------------------------------------------------------------------------------
  
  (fn zeros ((n U32) (rounds U32)) Bytes
