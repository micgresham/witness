  ; --- the way in --------------------------------------------------------------------------------------------------
  ; mmap(0, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE, -1, 0) is
  ; syscall 222; its answer is in x0.
  
  (fn mmap_code ((size I64)) Bytes
