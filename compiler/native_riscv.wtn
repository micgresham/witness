    (cat4 (addi (os) (os) (i64.of -16))
      (cat3 (mov_rr (r1) (os)) (mov_imm (r0) which) (syscall_with (i64.of 113)))
      (cat4 (ld (r0) (os) (i64.of 0))
        (mov_imm (r2) (i64.of 1000000000))
        (mul_rr (r0) (r0) (r2))
        (cat (ld (r3) (os) (i64.of 8)) (add_rr (r0) (r0) (r3))))
      (cat4 (addi (os) (os) (i64.of 16))
        (if (= divide (i64.of 1))
          (no_bytes)
          (cat (mov_imm (r2) divide) (divu_rr (r0) (r0) (r2))))
        (push (r0))
        (no_bytes))))

  (fn host_code ((name Str)) Bytes
    (uses Alloc)
    (if (str.eq name "print")
      (print_code (i64.of 1) (no_bytes))
      (if (str.eq name "log")
        (print_code (i64.of 2)
          (write_constant (i64.of 2) (i64.of 35585539402843) (i64.of 6)))
        (if (str.eq name "clock.now")
