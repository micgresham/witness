              (items_join (item (VJump (u32.of 0)))
                (items_join (item (VMark (u32.of 1)))
                  (items_join (raw (cat4 (cat3 (sub_rr (r0) (hp) (sv)) (addi (r0) (r0) (i64.of -8)) (sdx (r0) (mem) (sv))) (cat3 (addi (hp) (hp) (i64.of 7)) (mov_imm (r1) (i64.of -8)) (and_rr (hp) (hp) (r1))) (cat3 (mov_imm (r1) (i64.of 16)) (srl_rr (pg) (hp) (r1)) (addi (pg) (pg) (i64.of 2))) (push (sv))))
                    (items_join (item (VCallFn drive_index))
                      (items_join (raw (cat4 (mov_rr (sv) (r0)) (ldx (r2) (mem) (sv)) (add_rr (r1) (mem) (sv)) (addi (r1) (r1) (i64.of 8))))
                        (items_join (item (VMark (u32.of 2)))
                          (items_join (item (VJumpIf (u32.of 0) (r2) (zero) (u32.of 3)))
                            (items_join (raw (cat (mov_imm (r0) (i64.of 1)) (syscall_with (i64.of 64))))
                              (items_join (item (VJumpIf (u32.of 5) (zero) (r0) (u32.of 4)))
                                (items_join (raw (cat (add_rr (r1) (r1) (r0)) (sub_rr (r2) (r2) (r0))))
                                  (items_join (item (VJump (u32.of 2)))
                                    (items_join (item (VMark (u32.of 3)))
                                      (items_join (raw (exit_code (i64.of 0)))
                                        (items_join (item (VMark (u32.of 4)))
                                          (raw (exit_code (i64.of 1)))))))))))))))))))))))

  (fn stub_items ((entry VItems) (image_at I64) (image_size I64) (heap I64) (pages I64)) VItems
    (uses Alloc)
    (items_join (raw (start_code image_at image_size heap pages)) entry))

  ; The ELF file: the headers, the memory image, then the code, which is what the entry
  ; address points into.
  
  (fn elf_of ((m Module) (entry_name Str) (filter Bool)) (Result Bytes Fault)
    (uses Alloc)
    (match (index_of_func (get m funcs) entry_name (u32.of 0))
      ((None) (Err (fault "native" (concat "the program has no function named " entry_name))))
      ((Some index) (let shapes (shapes_of (get m funcs)) (let bodies (bodies_of (get m funcs) shapes (hostfns_of (get m imports))) (let heap (get m heap) (let image (image_of (get m segments) (zeros (narrow heap) (u32.of 40))) (let image_at (wrap.add (base_address) (i64.of 128)) (let entry (if filter (filter_entry index) (main_entry index)) (let stub (stub_items entry image_at (i64.of (octets image)) heap (widen (get m pages))) (let stub_end (items_size stub) (let starts (starts_from bodies stub_end) (let code (joined (code_to stub (u32.of 0) (labels_of stub (u32.of 0)) starts (bodies_to bodies stub_end starts (VNoChunks)))) (let code_offset (wrap.add (i64.of 128) (i64.of (octets image))) (let total (wrap.add code_offset (i64.of (octets code))) (Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 8) (u32.of 8)) image code)))))))))))))))))

  (fn main () Unit
    (uses Console)
    (print "compiler/native_arm.wtn is exercised by tests/test_native_arm.py")))
