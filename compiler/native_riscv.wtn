    (items_join (raw (cat4 (cat (mov_imm (r0) (i64.of 1)) (sdx (r0) (mem) (hp))) (addi (hp) (hp) (i64.of 16)) (mov_rr (sv) (hp)) (addi (hp) (hp) (i64.of 8))))
