; Witness to AArch64 Linux, from the same instructions the other backends write.
;
; compiler/native.wtn does this for x86-64; this is the same translation with a different
; machine behind it, and almost everything that decides what a program means -- layout,
; widths, tags, tail calls, the capabilities -- is not here because it was decided before any
; machine was chosen. What is here is the machine:
;
;   the operand stack  a second stack in x28, growing down, pushed and popped with
;                      pre- and post-indexed accesses; the machine stack (sp) holds only
;                      return addresses and saved frame pointers, so it stays aligned
;   a frame            x29 points at the operand stack as the call began: parameters are
;                      above it, locals below, and a branch restores x28 from it
;   memory             one region mapped at startup, its base in x19, addressed with a
;                      register offset exactly as WebAssembly says
;   the heap pointer   x20, and the page count `memory.size` answers in x21
;
; Two things differ from WebAssembly and x86: AArch64 division by zero answers zero rather
; than faulting, and the most negative number divided by -1 answers itself, so the checks
; that make those traps are written out. Every instruction is four bytes, so a jump's size is
; never in question.
;
; The evidence is tests/test_native_arm.py, which has no AArch64 machine to run on and uses
; an emulator instead: the ELF file is loaded, a handful of system calls are answered, and
; what it prints is compared with the interpreter's.
;
;   witness test compiler/native_arm.wtn
(module native_arm
  (use "wtn:7aa3f7247dab5b088f4abd1b52ae142508af1c4abe00c98f1426d8851874d23e" as movz)

  (use "wtn:04f707ef533012142b8f7b76b74b27253efd1b10d90679402c0b9d37c1e86411" as mov_imm)

  (use "wtn:d3b4a5fe364a5525fd32af333f9e1505d1fc3ba5da0eadf606ed580da4fef0a5" as mov_rr)

  (use "wtn:edf3ff05a1b1ee759e13907893f067421d97c39e68a4057180ab979b0f32e420" as add_imm)

  (use "wtn:acd315099826a6bb81f842b311e255242e1c7f6d6d0d8fec1e158eaa9f9d712a" as sub_imm)

  (use "wtn:cca3189963afa4d2c38960a3d148178281306da999766ce73ba0b709e5d0db95" as add_rr)

  (use "wtn:180717101f577ff54e43530a1d49febff7efad4f077d73824365e9fadd604fc9" as sub_rr)

  (use "wtn:127211a18967bfb8cbe30a106ad03c3e9b615f687c66f18d4e8b84aa21d38e94" as and_rr)

  (use "wtn:1daf03ec2e9115f8e7e55fc4541017d6bdd7a69eca3dba99c5ee81df329c9824" as orr_rr)

  (use "wtn:041e7cf17d955ccce4b8f806d0501faed488160ea884eb938e6053cfa1e7992d" as eor_rr)

  (use "wtn:92bc66283bd457e2c9a582aba76d29c8d9bc2f72aec44171ff24244ea31b919f" as cmp_rr)

  (use "wtn:404499e97ef2de930b3d5fc87f7fa25d85e30857a420a784903015203021d271" as tst_rr)

  (use "wtn:9cce5adf076c9f364937025d7004274ce686a1f0bdda8c620775ab4366920800" as mul_rr)

  (use "wtn:5f195f0395307b7a8fd62b7f25f4bc0ac22989e9c80809dd7900e7157d81381d" as sdiv_rr)

  (use "wtn:5015c72689641ead3ff7459c0806af83ad576e3192d0fcffe4cd7740d5d7a5da" as udiv_rr)

  (use "wtn:8e060906db659c9aaaca923d72fedcede9465d0d2bd8ddb1a69bcaa9a412d4fb" as lsl_rr)

  (use "wtn:f44e45a85ed9dacee312fbc74e2d6b33acd60e5f2f20598d4b49c8d437cd15b3" as lsr_rr)

  (use "wtn:c2d6980896570c8f5ab9c97f5129a7e7fc83a7c5f26d5aee236231d07f3dfb2a" as asr_rr)

  (use "wtn:72201ad7d0a32c0165cf82109af93e11c8bc21203e6ad7175664119fdcb1b73a" as msub)

  (use "wtn:68f559456236afabebc273faa526436347ea946979f005c7d3feba81eb81b65c" as csel)

  (use "wtn:b18160c49ff5a2f05b758bbdc7aab670d49b2667a7a511ede819bcd80631621d" as cset)

  (use "wtn:a9f350d5f1e9d39ab9e7d78565f5bb219a127433bcc689d44217f97a7611611e" as sxt)

  (use "wtn:546746ef23d0e5ebcbcba9b961544feff8409408b4cb5b38de032bf01d62db81" as mov_w)

  (use "wtn:2b5a20f9f09592cdad5c86b5f328bef8ce2c96017042eff079160a0516af353b" as ldr_off)

  (use "wtn:5bbbec764db01449e2b9e0418d45c862cf2ee756ea30f671b2cdff37d0e6fdd5" as str_off)

  (use "wtn:adf36d1624f7f0fa3cedb6925516afe29973e5459457a6f2300adf59ea320602" as ldr_rr)

  (use "wtn:59dec513af8709cc0d0b38444997d4c2b53ffd0f6d657c69d548a75dbd728f10" as str_rr)

  (use "wtn:fa7110f41e78399f8fc90ea2074c615011dfd25de64e876780ff543418992a5c" as ldrb_rr)

  (use "wtn:1082e78a67f7aad0e7a3f102ff08c30d6d5f7a351dd20ae1a51c137f679c2895" as strb_rr)

  (use "wtn:b97522ddd579e5d68e24b37ed33301e2b95a700766427f55d23de95a634cf6ca" as ldr_pre)

  (use "wtn:5d8b1898e458c480aa6a4bb947b377a05b38020588878174025b15efb158e0cd" as ldr_post)

  (use "wtn:4c0b305301db1ca3896da11445eb684377318061ac2ecdb0c1bec7de0077b398" as str_pre)

  (use "wtn:9667538e7de57e903c431635960600141604ed9ddb5f4aa0061bbdfaaf97fe23" as ldur)

  (use "wtn:e9ec09d428918b64c0fed8837beffa1d27632c4170169157a2e510d9911bd2ac" as stur)

  (use "wtn:aa232330dd44505322021ce6d674f79f049c5526f966a0d495008295a6801e11" as ldrb_post)

  (use "wtn:58458d07b49fedc01249b14bb58e34267ee32cf30b13a24fc6bc5a2da452a441" as strb_post)

  (use "wtn:1764475600d841ee94705a9051a52579da1949bdaeaa006a12b1605fc35f09d2" as push_frame)

  (use "wtn:70202d3073e36778bc540857c947ee2fd5ac757ff06f41f2a5767f2662d342ad" as pop_frame)

  (use "wtn:a531328bcda50bca40a24a24cffe87fc57c559814f0776b5bfc7008019892bb4" as b)

  (use "wtn:9257a65ace6f99e93004c5b81158422e5fb1fd405f7889a4394f2aa1184144c8" as bl)

  (use "wtn:6652f905359a5700e8909a869f40d404223479b005aeadbdb5ede8cc75510646" as b_cond)

  (use "wtn:366517bddd8143182efdfa7844370f1e35a5bc2671c483e5b2014c10ca739c5d" as cbz)

  (use "wtn:d8664a4f0e8139730ba2ea5b24e98063338de2a985b1fd4646b68d42e1fc90b4" as cbnz)

  (use "wtn:0f20a3f7302de28867fa8a2dc1fef3f2ddfa0b2e366cd2f65f079f4ae36aeb8b" as ret)

  (use "wtn:01e58cfb43a18b0dcb4a690f98495c9d60a4b512a4fb9af98d83b9879836fb44" as svc)

  (use "wtn:e0a7efb3ecea85bb4f6411bd03a880aa5d467c0c45c2e8ea4193f1923c2819d3" as brk)

  (use "wtn:3e918237207884eac418e996e67edc7f757644b74ca02a565d6c9a3fc4c931cf" as word)

  (use "wtn:aaa5788594cd2f68165abd0f2e6560c4aa6aaf92e09822948cc887f7cd927be5" as Module)

  (use "wtn:3e591891f9cf54232e04bb14b46fe1ad8efe8c82e1ddad2a481589bba3844f43" as Funcs)

  (use "wtn:780cd5f1caffd09ae27df62731b93b0f47c18f7b93487643ce22510a7c5f029b" as Func)

  (use "wtn:746b7af1483e2ad3bac5bd48a927f405dda763ad2e13285b41298d2d268a366f" as Imports)

  (use "wtn:2246c36031ae9d98c0dcb67dfc9591483d4b9f520cbeedf2355dd9208a84d3ea" as Import)

  (use "wtn:1d8850cc1eac3078061af0c4abac9ffb8c04c7f625724d647535443ad3cd3899" as Segments)

  (use "wtn:6049eb96cd5bb0261e93f3b63d858e9295b28d4454c9d335d6fc6b7357255c97" as Segment)

  (use "wtn:1073bcf7f2ec07adcc09eb7c2e8fe48e9f9e9761a767076f6172edba3db8cde8" as Inss)

  (use "wtn:a21c39d745ed071e8a191a37f70dd1779e3f66cef78971e75cc5db8d15985d3a" as Ins)

  (use "wtn:3752be75d9b35195f27bce3966247382cbf1f4b367ca42472081c4579c41a784" as low8)

  (use "wtn:30701617d68c3654a403fd5dedb917a11d116e4e5ce3d16cc8059f76e8f0b497" as imm32)

  (use "wtn:8be2edc17933e3f38aba6ee3bc6960aaa2e82f42c8b8022ec3d187702ed47a20" as imm64)

  (fn no_bytes () Bytes
    (uses Alloc)
    (str.encode ""))

  (fn octets ((b Bytes)) U32
    (let n (unwrap (bytes.len b)) (if (<= n 4294967295) (u32.of n) (u32.of 0))))

  (fn greater ((a U32) (b U32)) U32 (if (< a b) b a))

  (fn less ((a U32) (b U32)) U32 (if (< a b) (u32.of 0) (- a b)))

  (fn insn_size () U32 (u32.of 4))

  ; --- the items of a function ------------------------------------------------------------------
  ; Bytes, with the places that need an address worked out afterwards: a label, a jump to
  ; one (unconditional, on a condition, or if x0 is zero), and a call by function index.
  (enum AItem
    (ARaw (code Bytes))
    (AMark (id U32))
    (AJump (id U32))
    (AJumpIf (cc U32) (id U32))
    (AJumpZero (id U32))
    (ACallFn (func U32)))

  (enum AItems (ANoItems) (AItems (head AItem) (rest AItems)))

  (fn items_join ((a AItems) (b AItems)) AItems
    (match a ((ANoItems) b) ((AItems h rest) (AItems h (items_join rest b)))))

  (fn raw ((code Bytes)) AItems (AItems (ARaw code) (ANoItems)))

  (fn item ((i AItem)) AItems (AItems i (ANoItems)))

  (fn item_size ((i AItem)) U32
    (match i
      ((ARaw code) (octets code))
      ((AMark id) (u32.of 0))
      ((AJump id) (insn_size))
      ((AJumpIf cc id) (insn_size))
      ((AJumpZero id) (insn_size))
      ((ACallFn func) (insn_size))))

  (fn items_size ((is AItems)) U32
    (match is
      ((ANoItems) (u32.of 0))
      ((AItems h rest) (wrap.add (item_size h) (items_size rest)))))

  (enum ALabels (ANoLabels) (ALabels (id U32) (offset U32) (rest ALabels)))

  (fn labels_of ((is AItems) (at U32)) ALabels
    (match is
      ((ANoItems) (ANoLabels))
      ((AItems h rest) (match h ((AMark id) (ALabels id at (labels_of rest at))) ((ARaw code) (labels_of rest (wrap.add at (octets code)))) ((AJump id) (labels_of rest (wrap.add at (insn_size)))) ((AJumpIf cc id) (labels_of rest (wrap.add at (insn_size)))) ((AJumpZero id) (labels_of rest (wrap.add at (insn_size)))) ((ACallFn func) (labels_of rest (wrap.add at (insn_size))))))))

  (fn label_at ((ls ALabels) (mark U32)) U32
    (match ls
      ((ANoLabels) (u32.of 0))
      ((ALabels l offset rest) (if (= l mark) offset (label_at rest mark)))))

  (enum AStarts (ANoStarts) (AStarts (offset U32) (rest AStarts)))

  (fn start_of ((ss AStarts) (index U32)) U32
    (match ss
      ((ANoStarts) (u32.of 0))
      ((AStarts offset rest) (if (<= index (u32.of 0)) offset (start_of rest (- index (u32.of 1)))))))

  ; The distance from `at` to `target` in instructions, which is how a branch says it.
  (fn words ((target U32) (at U32)) I64
    (match (num.div (wrap.sub (i64.of target) (i64.of at)) (i64.of 4))
      ((None) (i64.of 0))
      ((Some q) q)))

  (fn item_bytes ((i AItem) (at U32) (ls ALabels) (ss AStarts)) Bytes
    (uses Alloc)
    (match i
      ((ARaw code) code)
      ((AMark id) (no_bytes))
      ((AJump id) (b (words (label_at ls id) at)))
      ((AJumpIf cc id) (b_cond cc (words (label_at ls id) at)))
      ((AJumpZero id) (cbz (r0) (words (label_at ls id) at)))
      ((ACallFn func) (bl (words (start_of ss func) at)))))

  ; --- registers ---------------------------------------------------------------------------------
  (fn r0 () U32 (u32.of 0))

  (fn r1 () U32 (u32.of 1))

  (fn r2 () U32 (u32.of 2))

  (fn r3 () U32 (u32.of 3))

  (fn r4 () U32 (u32.of 4))

  (fn r5 () U32 (u32.of 5))

  (fn r8 () U32 (u32.of 8))

  (fn r19 () U32 (u32.of 19))

  (fn r20 () U32 (u32.of 20))

  (fn r21 () U32 (u32.of 21))

  (fn r22 () U32 (u32.of 22))

  (fn r28 () U32 (u32.of 28))

  (fn r29 () U32 (u32.of 29))

  (fn sp () U32 (u32.of 31))

  (fn cat ((a Bytes) (b Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a b))

  (fn cat3 ((a Bytes) (b Bytes) (c Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b c)))

  (fn cat4 ((a Bytes) (b Bytes) (c Bytes) (d Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b (bytes.concat c d))))

  ; Pushing and popping the operand stack, which lives in x28 and grows down.
  (fn push ((r U32)) Bytes
    (uses Alloc)
    (str_pre r (r28) (i64.of -8)))

  (fn pop ((r U32)) Bytes
    (uses Alloc)
    (ldr_post r (r28) (i64.of 8)))

  ; A frame-relative word. Parameters sit above x29 and locals below it.
  (fn frame_load ((dst U32) (disp I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of 0) disp) (<= disp (i64.of 32760)))
      (ldr_off dst (r29) (narrow disp))
      (if (and (<= (i64.of -256) disp) (< disp (i64.of 0)))
        (ldur dst (r29) disp)
        (cat (mov_imm (r5) disp) (ldr_rr dst (r29) (r5))))))

  (fn frame_store ((src U32) (disp I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of 0) disp) (<= disp (i64.of 32760)))
      (str_off src (r29) (narrow disp))
      (if (and (<= (i64.of -256) disp) (< disp (i64.of 0)))
        (stur src (r29) disp)
        (cat (mov_imm (r5) disp) (str_rr src (r29) (r5))))))

  (fn widen ((n U32)) I64 (i64.of n))

  ; --- what the translator knows about the function ----------------------------------------------
  (enum AShapes (ANoShapes) (AShapes (params U32) (results U32) (rest AShapes)))

  (fn shape_at ((ss AShapes) (index U32)) (Option AShapes)
    (match ss
      ((ANoShapes) (None))
      ((AShapes p r rest) (if (<= index (u32.of 0)) (Some ss) (shape_at rest (- index (u32.of 1)))))))

  (enum AHostfns
    (ANoHostfns)
    (AHostfns (name Str) (params U32) (results U32) (rest AHostfns)))

  (fn host_at ((hs AHostfns) (slot U32)) (Option AHostfns)
    (match hs
      ((ANoHostfns) (None))
      ((AHostfns n p r rest) (if (<= slot (u32.of 0)) (Some hs) (host_at rest (- slot (u32.of 1)))))))

  (record AFx (params U32) (locals U32) (results U32) (shapes AShapes) (hosts AHostfns))

  ; A local's place relative to x29: parameters were pushed by the caller, the first deepest.
  (fn local_disp ((fx AFx) (index U32)) I64
    (if (< index (get fx params))
      (widen (wrap.mul (wrap.sub (wrap.sub (get fx params) (u32.of 1)) index) (u32.of 8)))
      (wrap.sub (i64.of 0)
        (widen (wrap.mul (wrap.add (wrap.sub index (get fx params)) (u32.of 1)) (u32.of 8))))))

  ; Where x28 is when `h` values are on the operand stack, as a distance below x29.
  (fn frame_depth ((fx AFx) (h U32)) U32 (wrap.mul (wrap.add (get fx locals) h) (u32.of 8)))

  (fn set_stack ((fx AFx) (h U32)) Bytes
    (uses Alloc)
    (let depth (frame_depth fx h)
      (if (< depth (u32.of 4096))
        (sub_imm (r28) (r29) depth)
        (cat (mov_imm (r5) (widen depth)) (sub_rr (r28) (r29) (r5))))))

  ; --- the state of the walk --------------------------------------------------------------------------
  (record ASt (h U32) (next U32) (dead Bool))

  (record AWalked (items AItems) (st ASt))

  ; A block that can be branched to: the mark a branch goes to (the start of a loop, the
  ; end of anything else), the height it expects, and how many values a branch carries.
  (enum ACtrl (ANoCtrl) (ACtrl (target U32) (height U32) (carries U32) (rest ACtrl)))

  (fn ctrl_at ((c ACtrl) (depth U32)) (Option ACtrl)
    (match c
      ((ANoCtrl) (None))
      ((ACtrl t h a rest) (if (<= depth (u32.of 0)) (Some c) (ctrl_at rest (- depth (u32.of 1)))))))

  (fn with_h ((st ASt) (h U32)) ASt (make ASt (h h) (next (get st next)) (dead false)))

  (fn walked ((code Bytes) (st ASt) (h U32)) AWalked
    (make AWalked (items (raw code)) (st (with_h st h))))

  (fn nothing ((st ASt)) AWalked (make AWalked (items (ANoItems)) (st st)))

  (fn walked_join ((a AWalked) (b AWalked)) AWalked
    (make AWalked (items (items_join (get a items) (get b items))) (st (get b st))))

  ; --- one instruction ---------------------------------------------------------------------------------
  (fn binary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat4 (pop (r1)) (pop (r0)) work (push (r0))))

  (fn unary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat3 (pop (r0)) work (push (r0))))

  (fn compare_code ((cc U32)) Bytes
    (uses Alloc)
    (binary_code (cat (cmp_rr (r0) (r1)) (cset (r0) cc))))

  ; i64 comparison opcodes 81 to 90 and their AArch64 condition codes: eq 0, ne 1, lt 11,
  ; lo 3, gt 12, hi 8, le 13, ls 9, ge 10, hs 2.
  (fn compare_cc ((code U8)) (Option U32)
    (if (= code (u8.of 81))
      (Some (u32.of 0))
      (if (= code (u8.of 82))
        (Some (u32.of 1))
        (if (= code (u8.of 83))
          (Some (u32.of 11))
          (if (= code (u8.of 84))
            (Some (u32.of 3))
            (if (= code (u8.of 85))
              (Some (u32.of 12))
              (if (= code (u8.of 86))
                (Some (u32.of 8))
                (if (= code (u8.of 87))
                  (Some (u32.of 13))
                  (if (= code (u8.of 88))
                    (Some (u32.of 9))
                    (if (= code (u8.of 89))
                      (Some (u32.of 10))
                      (if (= code (u8.of 90)) (Some (u32.of 2)) (None))))))))))))

  (fn alu_work ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 124))
      (Some (add_rr (r0) (r0) (r1)))
      (if (= code (u8.of 125))
        (Some (sub_rr (r0) (r0) (r1)))
        (if (= code (u8.of 126))
          (Some (mul_rr (r0) (r0) (r1)))
          (if (= code (u8.of 131))
            (Some (and_rr (r0) (r0) (r1)))
            (if (= code (u8.of 132))
              (Some (orr_rr (r0) (r0) (r1)))
              (if (= code (u8.of 133))
                (Some (eor_rr (r0) (r0) (r1)))
                (if (= code (u8.of 134))
                  (Some (lsl_rr (r0) (r0) (r1)))
                  (if (= code (u8.of 135))
                    (Some (asr_rr (r0) (r0) (r1)))
                    (if (= code (u8.of 136))
                      (Some (lsr_rr (r0) (r0) (r1)))
                      (if (= code (u8.of 114))
                        (Some (orr_rr (r0) (r0) (r1)))
                        (if (= code (u8.of 113)) (Some (and_rr (r0) (r0) (r1))) (None)))))))))))))

  ; A divisor of zero traps: skip the trap when x1 is not zero.
  (fn zero_check () Bytes
    (uses Alloc)
    (cat (cbnz (r1) (i64.of 2)) (brk)))

  ; The most negative number over -1 traps too, as WebAssembly says it does.
  (fn overflow_check () Bytes
    (uses Alloc)
    (cat4 (add_imm (r2) (r1) (u32.of 1))
      (cbnz (r2) (i64.of 5))
      (cat (movz (r3) (u32.of 32768) (u32.of 3)) (cmp_rr (r0) (r3)))
      (cat (b_cond (u32.of 1) (i64.of 2)) (brk))))

  (fn divide_code ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 127))
      (Some (binary_code (cat3 (zero_check) (overflow_check) (sdiv_rr (r0) (r0) (r1)))))
      (if (= code (u8.of 128))
        (Some (binary_code (cat (zero_check) (udiv_rr (r0) (r0) (r1)))))
        (if (= code (u8.of 129))
          (Some (binary_code (cat3 (zero_check) (sdiv_rr (r2) (r0) (r1)) (msub (r0) (r2) (r1) (r0)))))
          (if (= code (u8.of 130))
            (Some (binary_code (cat3 (zero_check) (udiv_rr (r2) (r0) (r1)) (msub (r0) (r2) (r1) (r0)))))
            (None))))))

  (fn unary_work ((code U8)) (Option Bytes)
    (uses Alloc)
    (if (= code (u8.of 80))
      (Some (cat (tst_rr (r0) (r0)) (cset (r0) (u32.of 0))))
      (if (= code (u8.of 69))
        (Some (cat (tst_rr (r0) (r0)) (cset (r0) (u32.of 0))))
        (if (= code (u8.of 167))
