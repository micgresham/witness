  ; `(update base patch)`: a patch is a record of Options, and each `(Some v)` replaces a field.
  (fn update_value ((cx Cx) (binds Binds) (st St) (args Trees) (left Int)) (Result Out Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
      (match (values cx binds st args (- left 1))
        ((Err f) (Err f))
        ((Ok vs) (match (get vs syms)
          ((NoSyms) (unread "an update needs a record and a patch"))
          ((Syms base more) (match more
            ((NoSyms) (unread "an update needs a record and a patch"))
            ((Syms given_patch none) (match base
              ((Rec n fs) (match given_patch
                ((Rec pn pfs) (Ok (make Out (sym (Rec n (patched fs pfs))) (st (get vs st)))))
                ((Num x t) (Ok (unknown (get vs st) "?" false)))
                ((Truth t) (Ok (unknown (get vs st) "?" false)))
                ((Ctor v cs) (Ok (unknown (get vs st) "?" false)))))
              ((Num x t) (Ok (unknown (get vs st) "?" false)))
              ((Truth t) (Ok (unknown (get vs st) "?" false)))
              ((Ctor v cs) (Ok (unknown (get vs st) "?" false))))))))))))

