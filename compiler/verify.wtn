  ; One value out of mutually exclusive branches: a boolean if every one is, else an unknown equal
  ; to the one that ran.
  (fn joined_all ((st St) (cs Cases)) Out
    (uses Alloc)
    (if (all_truth cs)
      (make Out (sym (Truth (f_disj (truth_cases cs)))) (st st))
      (let fresh (unknown st (cases_type cs) false)
        (match (get fresh sym)
          ((Truth t) fresh)
          ((Num out t) (make Out (sym (get fresh sym)) (st (case_facts (get fresh st) out cs))))
          ((Rec n fs) fresh)
          ((Ctor v fs) fresh)))))

  (fn all_truth ((cs Cases)) Bool
    (match cs
      ((NoCases) true)
      ((Cases c rest) (match (get c sym) ((Truth f) (all_truth rest)) ((Num x t) false) ((Rec n fs) false) ((Ctor v fs) false)))))

  (fn truth_cases ((cs Cases)) Formulas
    (uses Alloc)
    (match cs
      ((NoCases) (NoFormulas))
      ((Cases c rest) (Formulas (f_conj (pair (get c cond) (as_formula (get c sym)))) (truth_cases rest)))))

  (fn cases_type ((cs Cases)) Str
    (uses Alloc)
    (match cs
      ((NoCases) "Int")
      ((Cases c rest) (of_type (match (get c sym) ((Num x t) t) ((Truth f) "Int") ((Rec n fs) n) ((Ctor v fs) "?")) (cases_type rest)))))

  (fn case_facts ((st St) (out Lin) (cs Cases)) St
    (uses Alloc)
    (match cs
      ((NoCases) st)
      ((Cases c rest) (let t (termed st (get c sym))
        (case_facts (facts_plus (get t st) (f_disj (pair (f_neg (get c cond)) (f_eq out (get t lin))))) out rest)))))

  ; --- a function ------------------------------------------------------------------------------------------------------
  (fn param_binds ((fname Str) (names Atoms) (kinds Atoms)) Binds
    (uses Alloc)
    (match names
      ((NoAtoms) (NoBinds))
      ((Atoms n rest) (match kinds
        ((NoAtoms) (NoBinds))
        ((Atoms k more) (Binds n (if (str.eq k "Bool") (Truth (Atom (concat "p:" (concat fname (concat ":" n))))) (Num (var_of (concat "p:" (concat fname (concat ":" n)))) k)) (param_binds fname rest more)))))))

  ; What a parameter's type says of it: a fixed width keeps it inside its range, a refined newtype its condition.
  (fn param_facts ((cx Cx) (st St) (fname Str) (names Atoms) (kinds Atoms) (named Atoms)) (Result St Fault)
    (uses Alloc)
    (match names
      ((NoAtoms) (Ok st))
      ((Atoms n rest) (match kinds
        ((NoAtoms) (Ok st))
        ((Atoms k more) (match named
          ((NoAtoms) (Ok st))
          ((Atoms w wmore) (let x (var_of (concat "p:" (concat fname (concat ":" n))))
            (match (refine cx (in_range st x k) w x 4000)
              ((Err f) (Err f))
              ((Ok s) (param_facts cx s fname rest more wmore)))))))))))

  (fn checked ((cx Cx) (info FnInfo) (body Tree)) (Result St Fault)
    (uses Alloc)
    (let binds (param_binds (get info name) (get info params) (get info kinds))
      (match (param_facts cx (make St (facts (NoFormulas)) (fresh 0) (errs "") (always (NoFormulas)) (sites (NoSites))) (get info name) (get info params) (get info kinds) (get info named))
        ((Err f) (Err f))
        ((Ok st1) (match (instantiate_own cx info binds st1)
          ((Err f) (Err f))
          ((Ok st0) (match (value cx binds st0 body 4000)
            ((Err f) (Err f))
            ((Ok done) (finish cx info binds (get done sym) (get done st))))))))))

  ; The function's own `requires`, taken as known on entry.
  (fn instantiate_own ((cx Cx) (info FnInfo) (binds Binds) (st St)) (Result St Fault)
    (uses Alloc)
    (match (get info pre)
      ((NoTrees) (Ok st))
      ((Trees c rest) (match (value (with cx (open (Atoms (get info name) (NoAtoms))) (contract true)) binds st c 4000)
        ((Err f) (Err f))
        ((Ok o) (Ok (facts_plus (get o st) (as_formula (get o sym)))))))))

  (fn finish ((cx Cx) (info FnInfo) (binds Binds) (answer Sym) (st St)) (Result St Fault)
    (uses Alloc)
    (match (get info post)
      ((NoTrees) (Ok st))
      ((Trees c rest) (match (value (with cx (open (Atoms (get info name) (NoAtoms))) (contract true)) (Binds "result" answer binds) st c 4000)
        ((Err f) (Err f))
        ((Ok o) (Ok (must (get o st) (as_formula (get o sym)) "unproven-postcondition" (get info name))))))))

  ; --- reading the module --------------------------------------------------------------------------------------------------
  (fn param_pairs ((ps Trees)) Trees ps)

  (fn param_names ((ps Trees)) Atoms
    (uses Alloc)
    (match ps
      ((NoTrees) (NoAtoms))
      ((Trees p rest) (match (node_items p)
        ((None) (param_names rest))
        ((Some parts) (match parts ((NoTrees) (param_names rest)) ((Trees n more) (Atoms (word_of n) (param_names rest)))))))))

  ; A type's name as the checker sees it: a label is only a mark on the type it wraps.
  (fn type_name ((t Tree) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      "?"
      (match (node_items t)
        ((None) (word_of t))
        ((Some parts) (if (head_is t "label")
          (match (last_of parts) ((Some inner) (type_name inner (- left 1))) ((None) "?"))
          (match parts ((NoTrees) "?") ((Trees h more) (word_of h))))))))

  ; A type as the value carries it: its name, or all of it when it has arguments.
  (fn type_ty ((t Tree) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (ty_with t (NoAtoms) (NoTrees) left))

  (fn heads_of ((ks Atoms)) Atoms
    (uses Alloc)
    (match ks ((NoAtoms) ks) ((Atoms k rest) (Atoms (type_head k) (heads_of rest)))))

  (fn param_kinds ((ps Trees)) Atoms
    (uses Alloc)
    (match ps
      ((NoTrees) (NoAtoms))
      ((Trees p rest) (match (node_items p)
        ((None) (Atoms "?" (param_kinds rest)))
        ((Some parts) (match parts
          ((NoTrees) (Atoms "?" (param_kinds rest)))
          ((Trees n more) (match more ((NoTrees) (Atoms "?" (param_kinds rest))) ((Trees t none) (Atoms (type_ty t 20) (param_kinds rest)))))))))))

  (fn all_scalar ((ks Atoms)) Bool
    (uses Alloc)
    (match ks ((NoAtoms) true) ((Atoms k rest) (and (scalar k) (all_scalar rest)))))

  ; The clause named `which` among the items between the result type and the body.
  (fn clause_of ((clauses Trees) (which Str)) Trees
    (uses Alloc)
    (match clauses
      ((NoTrees) (NoTrees))
      ((Trees c rest) (if (head_is c which) (after_head c) (clause_of rest which)))))

  (fn effectful_in ((clauses Trees)) Bool
    (uses Alloc)
    (match clauses
      ((NoTrees) false)
      ((Trees c rest) (or (and (head_is c "uses") (< 0 (trees_len (after_head c)))) (effectful_in rest)))))

  ; Everything between the result type and the last item, which is the body.
  (fn middle ((ts Trees)) Trees
    (uses Alloc)
    (match ts
      ((NoTrees) ts)
      ((Trees h rest) (match rest ((NoTrees) (NoTrees)) ((Trees n more) (Trees h (middle rest)))))))

  (fn last_of ((ts Trees)) (Option Tree)
    (match ts ((NoTrees) (None)) ((Trees h rest) (match rest ((NoTrees) (Some h)) ((Trees n more) (last_of rest))))))

  ; `(fn name (params) ret clause... body)`, or `(fn (name T...) ...)` for a generic one, whose
  ; type parameters are values nothing is known of.
  (fn info_from ((ns NewTs) (after Trees)) (Option FnInfo)
    (uses Alloc)
    (match after
      ((NoTrees) (None))
      ((Trees n rest) (match rest
          ((NoTrees) (None))
          ((Trees params more) (match more
            ((NoTrees) (None))
            ((Trees ret clauses) (Some (info_with ns (declared_name n) (items_of params) (type_ty ret 20) (middle clauses))))))))))

  (fn info_with ((ns NewTs) (name Str) (params Trees) (ret Str) (clauses Trees)) FnInfo
    (uses Alloc)
    (make FnInfo
      (name name)
      (params (param_names params))
      (kinds (resolved ns (param_kinds params)))
      (named (heads_of (param_kinds params)))
      (ret (base_kind ns ret 20))
      (retname (type_head ret))
      (pre (clause_of clauses "requires"))
      (post (clause_of clauses "ensures"))
      (effectful (effectful_in clauses))
      (readable (and (all_scalar (resolved ns (param_kinds params))) (scalar (base_kind ns ret 20))))))

  (fn infos_of ((ns NewTs) (items Trees)) FnInfos
    (uses Alloc)
    (match items
      ((NoTrees) (NoFnInfos))
      ((Trees h rest) (if (head_is h "fn")
        (match (info_from ns (after_head h)) ((None) (infos_of ns rest)) ((Some i) (FnInfos i (infos_of ns rest))))
        (infos_of ns rest)))))

  (fn body_of ((h Tree)) (Option Tree) (last_of (after_head h)))

  ; --- termination -----------------------------------------------------------------------------------------------------
  ; A function that reaches itself must make something smaller on the way round. For each
  ; group of functions that call each other, one parameter per member is looked for such that
  ; every call in the group either lowers it -- a number still above 0 passed something
  ; provably smaller, or a part of it that a `match` or a field read took apart -- or passes it
  ; on unchanged, and the calls that pass it on cannot go round for ever by themselves. That is
  ; witness/verify.py's rule. A group with a member this does not read is not read either.
  (record Seen (name Str) (text Str) (read Bool) (sites Sites) (callees Atoms) (params Atoms) (kinds Atoms) (line Bool) (item Tree) (entry Formulas) (declared Trees))

  (enum Seens (NoSeens) (Seens (head Seen) (rest Seens)))

  (record Done (text Str) (read Bool) (sites Sites) (entry Formulas))

  (fn done_of ((cx Cx) (info FnInfo) (body (Option Tree))) Done
    (uses Alloc)
    (if (not (get info readable))
      (make Done (text "not read yet: a parameter or result that is not Int or Bool") (read false) (sites (NoSites)) (entry (NoFormulas)))
      (match body
        ((None) (make Done (text "not read yet: no body") (read false) (sites (NoSites)) (entry (NoFormulas))))
        ((Some b) (match (checked cx info b)
          ((Err f) (make Done (text (concat "not read yet: " (get f why))) (read false) (sites (NoSites)) (entry (NoFormulas))))
          ((Ok st) (make Done (text (get st errs)) (read true) (sites (get st sites)) (entry (entry_facts cx info)))))))))

  ; What is known on entry: the parameters' types and the function's own `requires`.
  (fn entry_facts ((cx Cx) (info FnInfo)) Formulas
    (uses Alloc)
    (match (param_facts cx (make St (facts (NoFormulas)) (fresh 0) (errs "") (always (NoFormulas)) (sites (NoSites))) (get info name) (get info params) (get info kinds) (get info named))
      ((Err f) (NoFormulas))
      ((Ok st1) (match (instantiate_own cx info (param_binds (get info name) (get info params) (get info kinds)) st1)
        ((Err f) (NoFormulas))
        ((Ok st0) (get st0 facts))))))

  ; The names of every function in the module, generic ones too.
  (fn fn_names ((items Trees)) Atoms
    (uses Alloc)
    (match items
      ((NoTrees) (NoAtoms))
      ((Trees h rest) (if (head_is h "fn")
        (match (after_head h) ((NoTrees) (fn_names rest)) ((Trees n more) (Atoms (declared_name n) (fn_names rest))))
        (fn_names rest)))))

  ; The functions a tree calls, among `names`.
  (fn calls_in ((names Atoms) (t Tree) (acc Atoms) (left Int)) Atoms
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) acc
      (match t
        ((Leaf x q) acc)
        ((Node items) (match items
          ((NoTrees) acc)
          ((Trees h rest) (match h
            ((Leaf x q) (calls_in_all names rest (named_call names (word_of h) acc) (- left 1)))
            ((Node inner) (calls_in_all names rest (calls_in names h acc (- left 1)) (- left 1))))))))))

  (fn named_call ((names Atoms) (w Str) (acc Atoms)) Atoms
    (if (and (holds names w) (not (holds acc w))) (Atoms w acc) acc))

  (fn calls_in_all ((names Atoms) (ts Trees) (acc Atoms) (left Int)) Atoms
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) acc
      (match ts ((NoTrees) acc) ((Trees h rest) (calls_in_all names rest (calls_in names h acc (- left 1)) (- left 1))))))

  ; `(fn name (params) ret clause... body)`: what follows the parameters is where calls are.
  (fn seen_of ((cx Cx) (names Atoms) (h Tree)) Seen
    (uses Alloc)
    (match (after_head h)
      ((NoTrees) (make Seen (name "") (text "") (read false) (sites (NoSites)) (callees (NoAtoms)) (params (NoAtoms)) (kinds (NoAtoms)) (line false) (item h) (entry (NoFormulas)) (declared (NoTrees))))
      ((Trees n rest) (let callees (match rest ((NoTrees) (NoAtoms)) ((Trees ps more) (calls_in_all names more (NoAtoms) 100000)))
        (match (info_from (get cx news) (after_head h))
          ((None) (make Seen (name (declared_name n)) (text "") (read false) (sites (NoSites)) (callees callees) (params (NoAtoms)) (kinds (NoAtoms)) (line false) (item h) (entry (NoFormulas)) (declared (NoTrees))))
          ((Some info) (let d (done_of cx info (body_of h))
            (make Seen (name (get info name)) (text (get d text)) (read (get d read)) (sites (get d sites)) (callees callees) (params (get info params)) (kinds (get info kinds)) (line true) (item h) (entry (get d entry)) (declared (bounds_of h))))))))))

  (fn bounds_of ((h Tree)) Trees
    (uses Alloc)
    (match (after_head h)
      ((NoTrees) (NoTrees))
      ((Trees n rest) (match rest ((NoTrees) (NoTrees)) ((Trees ps more) (match more ((NoTrees) (NoTrees)) ((Trees ret clauses) (clause_of (middle clauses) "bounds"))))))))

  (fn seens_of ((cx Cx) (names Atoms) (items Trees)) Seens
    (uses Alloc)
    (match items
      ((NoTrees) (NoSeens))
      ((Trees h rest) (if (head_is h "fn") (Seens (seen_of cx names h) (seens_of cx names rest)) (seens_of cx names rest)))))

  (fn seen_named ((ss Seens) (n Str)) (Option Seen)
    (match ss ((NoSeens) (None)) ((Seens h rest) (if (str.eq (get h name) n) (Some h) (seen_named rest n)))))

  ; Everything reachable from `todo` by calls, `done` included.
  (fn reach ((ss Seens) (todo Atoms) (done Atoms) (left Int)) Atoms
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) done
      (match todo
        ((NoAtoms) done)
        ((Atoms n rest) (if (holds done n)
          (reach ss rest done (- left 1))
          (match (seen_named ss n)
            ((None) (reach ss rest (Atoms n done) (- left 1)))
            ((Some s) (reach ss (atoms_join (get s callees) rest) (Atoms n done) (- left 1)))))))))

  (fn reached_from ((ss Seens) (n Str)) Atoms
    (uses Alloc)
    (match (seen_named ss n) ((None) (NoAtoms)) ((Some s) (reach ss (get s callees) (NoAtoms) 100000))))

  ; The functions `n` is mutually recursive with, itself included; none when it does not recur.
  (fn group_of ((ss Seens) (n Str)) Atoms
    (uses Alloc)
    (let mine (reached_from ss n)
      (if (holds mine n) (back_to ss n mine) (NoAtoms))))

  (fn back_to ((ss Seens) (n Str) (cands Atoms)) Atoms
    (uses Alloc)
    (match cands
      ((NoAtoms) (NoAtoms))
      ((Atoms c rest) (if (holds (reached_from ss c) n) (Atoms c (back_to ss n rest)) (back_to ss n rest)))))

  (fn least ((as Atoms) (best Str)) Str
    (uses Alloc)
    (match as ((NoAtoms) best) ((Atoms a rest) (least rest (if (str_before a best) a best)))))

  (fn all_read ((ss Seens) (ms Atoms)) Bool
    (match ms
      ((NoAtoms) true)
      ((Atoms m rest) (match (seen_named ss m) ((None) false) ((Some s) (and (get s read) (all_read ss rest)))))))

  ; --- the measure ---
  (record Edge (caller Str) (callee Str) (args Syms) (facts Formulas))

  (enum Edges (NoEdges) (Edges (head Edge) (rest Edges)))

  (enum Placed (NoPlaced) (Placed (name Str) (at Int) (rest Placed)))

  (fn edges_from ((caller Str) (ms Atoms) (sites Sites) (acc Edges)) Edges
    (uses Alloc)
    (match sites
      ((NoSites) acc)
      ((Sites c args facts rest) (edges_from caller ms rest (if (holds ms c) (Edges (make Edge (caller caller) (callee c) (args args) (facts facts)) acc) acc)))))

  (fn group_edges ((ss Seens) (ms Atoms) (all Atoms) (acc Edges)) Edges
    (uses Alloc)
    (match ms
      ((NoAtoms) acc)
      ((Atoms m rest) (group_edges ss rest all (match (seen_named ss m) ((None) acc) ((Some s) (edges_from m all (get s sites) acc)))))))

  (fn placed_at ((p Placed) (n Str)) (Option Int)
    (match p ((NoPlaced) (None)) ((Placed m at rest) (if (str.eq m n) (Some at) (placed_at rest n)))))

  (fn atom_at ((as Atoms) (i Int)) Str
    (match as ((NoAtoms) "") ((Atoms a rest) (if (<= i 0) a (atom_at rest (- i 1))))))

  (fn integer_kind ((k Str)) Bool (or (str.eq k "Int") (is_width k)))

  ; The one atom a value is, when it is exactly one.
  (fn lone_atom ((s Sym)) Str
    (match s
      ((Num x t) (match (get x terms)
        ((NoTerms) "")
        ((Terms a k rest) (match rest ((NoTerms) (if (and (= k 1) (= (get x const) 0)) a "")) ((Terms b c more) "")))))
      ((Truth f) "") ((Rec n fs) "") ((Ctor v fs) "")))

  ; A part of `whole`: a binder of a match on it (`whole@Variant.i`) or a field of it (`whole.f`).
  (fn part_of ((a Str) (whole Str)) Bool
    (uses Alloc)
    (let n (unwrap (bytes.len (str.encode whole)))
      (and (< n (unwrap (bytes.len (str.encode a))))
        (and (bytes.eq (bytes.slice (str.encode a) (Octets 0) (Octets n)) (str.encode whole))
          (let c (byte_at (str.encode a) n) (or (= c 64) (= c 46)))))))

  (fn edge_ends ((ss Seens) (e Edge) (p Placed)) (Option Ends)
    (uses Alloc)
    (match (placed_at p (get e caller))
      ((None) (None))
      ((Some here) (match (placed_at p (get e callee))
        ((None) (None))
        ((Some there) (match (seen_named ss (get e caller))
          ((None) (None))
          ((Some me) (match (seen_named ss (get e callee))
            ((None) (None))
            ((Some it) (match (sym_at (get e args) there)
              ((None) (None))
              ((Some arg) (Some (make Ends
                (measure (concat "p:" (concat (get e caller) (concat ":" (atom_at (get me params) here)))))
                (arg arg)
                (numeric (and (integer_kind (atom_at (get me kinds) here)) (integer_kind (atom_at (get it kinds) there)))))))))))))))))

  (record Ends (measure Str) (arg Sym) (numeric Bool))

  ; Does the call lower the caller's measure to a smaller value that is still not negative?
  (fn lowers ((ends Ends) (facts Formulas)) Bool
    (uses Alloc)
    (let m (get ends measure)
      (if (part_of (lone_atom (get ends arg)) m)
        true
        (if (not (get ends numeric))
          false
          (match (get ends arg)
            ((Num x t) (str.eq (needed_verdict facts (f_conj (pair (f_lt x (var_of m)) (f_lt (num 0) (var_of m))))) "proved"))
            ((Truth f) false) ((Rec n fs) false) ((Ctor v fs) false))))))

  (fn passes ((ends Ends)) Bool (str.eq (lone_atom (get ends arg)) (get ends measure)))

  ; Every edge both of whose ends are placed and one of which is `placed`.
  (fn edges_hold ((ss Seens) (es Edges) (p Placed) (placed Str)) Bool
    (uses Alloc)
    (match es
      ((NoEdges) true)
      ((Edges e rest) (and
        (if (or (str.eq (get e caller) placed) (str.eq (get e callee) placed))
          (match (edge_ends ss e p) ((None) true) ((Some ends) (or (passes ends) (lowers ends (get e facts)))))
          true)
        (edges_hold ss rest p placed)))))

  ; The edges that pass the measure on without lowering it may not go round by themselves.
  (fn passing ((ss Seens) (es Edges) (p Placed)) Edges
    (uses Alloc)
    (match es
      ((NoEdges) es)
      ((Edges e rest) (match (edge_ends ss e p)
        ((None) (passing ss rest p))
        ((Some ends) (if (and (passes ends) (not (lowers ends (get e facts)))) (Edges e (passing ss rest p)) (passing ss rest p)))))))

  (fn passed_to ((es Edges) (n Str)) Atoms
    (uses Alloc)
    (match es ((NoEdges) (NoAtoms)) ((Edges e rest) (if (str.eq (get e caller) n) (Atoms (get e callee) (passed_to rest n)) (passed_to rest n)))))

  (fn pass_reach ((es Edges) (todo Atoms) (done Atoms) (left Int)) Atoms
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) done
      (match todo
        ((NoAtoms) done)
        ((Atoms n rest) (if (holds done n) (pass_reach es rest done (- left 1)) (pass_reach es (atoms_join (passed_to es n) rest) (Atoms n done) (- left 1)))))))

  (fn no_endless ((es Edges) (ms Atoms)) Bool
    (uses Alloc)
    (match ms
      ((NoAtoms) true)
      ((Atoms m rest) (and (not (holds (pass_reach es (passed_to es m) (NoAtoms) 10000) m)) (no_endless es rest)))))

  (enum Ints (NoInts) (Ints (head Int) (rest Ints)))

  (fn positions ((ks Atoms) (i Int) (numeric Bool)) Ints
    (uses Alloc)
    (match ks ((NoAtoms) (NoInts)) ((Atoms k rest) (if (if numeric (integer_kind k) (not (integer_kind k))) (Ints i (positions rest (+ i 1) numeric)) (positions rest (+ i 1) numeric)))))

  (fn ints_join ((a Ints) (b Ints)) Ints
    (uses Alloc)
    (match a ((NoInts) b) ((Ints h rest) (Ints h (ints_join rest b)))))

  ; Numbers first: a measure is numeric or structural, and a number has no parts.
  (fn candidates ((ss Seens) (n Str)) Ints
    (uses Alloc)
    (match (seen_named ss n) ((None) (NoInts)) ((Some s) (ints_join (positions (get s kinds) 0 true) (positions (get s kinds) 0 false)))))

  (record Search (found Bool) (left Int) (placed Placed))

  ; Place the members in order, abandoning a placement at the first edge it cannot justify.
  ; `left` bounds the placements tried: running out loses a proof, it never invents one.
  (fn place ((ss Seens) (es Edges) (ms Atoms) (order Atoms) (p Placed) (left Int)) Search
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Search (found false) (left 0) (placed p))
      (match order
        ((NoAtoms) (make Search (found (no_endless (passing ss es p) ms)) (left left) (placed p)))
        ((Atoms n rest) (try_at ss es ms n rest p (candidates ss n) (- left 1))))))

  (fn try_at ((ss Seens) (es Edges) (ms Atoms) (n Str) (rest Atoms) (p Placed) (cs Ints) (left Int)) Search
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Search (found false) (left 0) (placed p))
      (match cs
        ((NoInts) (make Search (found false) (left left) (placed p)))
        ((Ints at more) (let q (Placed n at p)
          (if (edges_hold ss es q n)
            (let got (place ss es ms rest q (- left 1))
              (if (get got found) got (try_at ss es ms n rest p more (if (and (<= 0 (get got left)) (< (get got left) left)) (get got left) (- left 1)))))
            (try_at ss es ms n rest p more (- left 1))))))))

  (fn measure_of ((ss Seens) (ms Atoms)) (Option Placed)
    (uses Alloc)
    (let got (place ss (group_edges ss ms ms (NoEdges)) ms ms (NoPlaced) 4096)
      (if (get got found) (Some (get got placed)) (None))))

  (fn terminates ((ss Seens) (ms Atoms)) Bool
    (uses Alloc)
    (match (measure_of ss ms) ((None) false) ((Some p) true)))


  ; --- resource bounds -----------------------------------------------------------------------------------------------
  ; How deep the calls go and how much is built, per group of functions, as witness/verify.py
  ; counts them: one pass through a body is its deepest call plus a frame and every allocating
  ; builtin it reaches; a group costs its passes times how often it can be entered, which is
  ; the tightest bound the prover finds on each member's measure from what is known on entry,
  ; plus one. A structural measure has no number, so a recursion over data is unbounded. Work
  ; placed with memory of its own spends another machine's stack and heap.
  (enum Amt (Is (n Int)) (Unbounded) (Unread))

  ; `calls` is the most calls back into the group being costed that one pass can make: how
  ; many there are in a body decides how often the group's bodies can run (`runs`).
  (enum Pass (Costs (deep Int) (alloc Int) (calls Int)) (NoBound) (NotRead))

  (record GCost (deep Amt) (alloc Amt) (repeats Amt))

  (enum Memo (NoMemo) (Memo (key Str) (cost GCost) (rest Memo)))

  (record Walk (pass Pass) (memo Memo))

  (record Costed (cost GCost) (memo Memo))

  (fn max_int ((a Int) (b Int)) Int (if (< a b) b a))

  (fn seq_pass ((a Pass) (b Pass)) Pass
    (match a
      ((NoBound) a)
      ((NotRead) (match b ((NoBound) b) ((NotRead) a) ((Costs d x k) a)))
      ((Costs d x k) (match b ((NoBound) b) ((NotRead) b) ((Costs e y j) (Costs (max_int d e) (+ x y) (+ k j)))))))

  (fn worst_pass ((a Pass) (b Pass)) Pass
    (match a
      ((NoBound) a)
      ((NotRead) (match b ((NoBound) b) ((NotRead) a) ((Costs d x k) a)))
      ((Costs d x k) (match b ((NoBound) b) ((NotRead) b) ((Costs e y j) (Costs (max_int d e) (max_int x y) (max_int k j)))))))

  ; Branches that run side by side: the deepest of them, and what all of them build.
  (fn side_pass ((a Pass) (b Pass)) Pass
    (match a
      ((NoBound) a)
      ((NotRead) (match b ((NoBound) b) ((NotRead) a) ((Costs d x k) a)))
      ((Costs d x k) (match b ((NoBound) b) ((NotRead) b) ((Costs e y j) (Costs (max_int d e) (+ x y) (+ k j)))))))

  ; Members of one group: the deepest of them and what all of them build, but each run of
  ; the group is one member's body, so the calls back into it are the most any one makes.
  (fn member_pass ((a Pass) (b Pass)) Pass
    (match a
      ((NoBound) a)
      ((NotRead) (match b ((NoBound) b) ((NotRead) a) ((Costs d x k) a)))
      ((Costs d x k) (match b ((NoBound) b) ((NotRead) b) ((Costs e y j) (Costs (max_int d e) (+ x y) (max_int k j)))))))

  (fn none () Pass (Costs 0 0 0))

  ; 1 + k + ... + k^(n-1): how often the bodies of a group entered `n` deep can run when each
  ; calls back into it at most `k` times. It is `n` when `k` is one; a body that calls itself
  ; twice runs 2^n - 1 times, which a count of the repeats alone would miss.
  (fn runs ((k Int) (n Int)) Int
    (requires (<= 0 n))
    (if (<= n 0) 0 (+ 1 (* k (runs k (- n 1))))))

  (fn part_of_fn ((ss Seens) (n Str)) Atoms
    (uses Alloc)
    (match (group_of ss n) ((NoAtoms) (Atoms n (NoAtoms))) ((Atoms a rest) (Atoms a rest))))

  (fn memo_at ((m Memo) (k Str)) (Option GCost)
    (match m ((NoMemo) (None)) ((Memo key c rest) (if (str.eq key k) (Some c) (memo_at rest k)))))

  ; The cost of the group `n` is in, from the memo or worked out.
  (fn group_cost ((ss Seens) (names Atoms) (n Str) (memo Memo) (left Int)) Costed
    (uses Alloc)
    (requires (<= 0 left))
    (let ms (part_of_fn ss n)
      (let key (least ms n)
        (match (memo_at memo key)
          ((Some c) (make Costed (cost c) (memo memo)))
          ((None) (if (<= left 0)
            (make Costed (cost (make GCost (deep (Unread)) (alloc (Unread)) (repeats (Unread)))) (memo memo))
            (let w (members_pass ss names ms ms (none) memo (- left 1))
              (let c (scaled (get w pass) (repeats_of ss ms))
                (make Costed (cost c) (memo (Memo key c (get w memo))))))))))))

  (fn scaled ((p Pass) (r Amt)) GCost
    (match p
      ((NoBound) (make GCost (deep (Unbounded)) (alloc (Unbounded)) (repeats r)))
      ((NotRead) (make GCost (deep (Unread)) (alloc (Unread)) (repeats r)))
      ((Costs d a calls) (match r
        ((Is k) (make GCost (deep (Is (* k d))) (alloc (Is (* (if (<= 0 k) (runs calls k) 0) a))) (repeats r)))
        ((Unbounded) (make GCost (deep r) (alloc r) (repeats r)))
        ((Unread) (make GCost (deep r) (alloc r) (repeats r)))))))

  ; The members' passes: the deepest of them, and what they build added up.
  (fn members_pass ((ss Seens) (names Atoms) (group Atoms) (ms Atoms) (acc Pass) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) (make Walk (pass (NotRead)) (memo memo))
      (match ms
        ((NoAtoms) (make Walk (pass acc) (memo memo)))
        ((Atoms m rest) (match (seen_named ss m)
          ((None) (members_pass ss names group rest (member_pass acc (NotRead)) memo (- left 1)))
          ((Some s) (match (body_of (get s item))
            ((None) (members_pass ss names group rest (member_pass acc (NotRead)) memo (- left 1)))
            ((Some b) (let w (walk_cost ss names group b memo (- left 1))
              (members_pass ss names group rest (member_pass acc (framed (get w pass))) (get w memo) (- left 1)))))))))))

  (fn framed ((p Pass)) Pass (match p ((Costs d a k) (Costs (+ d 1) a k)) ((NoBound) p) ((NotRead) p)))

  ; How often a group can be entered, the first time included.
  (fn repeats_of ((ss Seens) (ms Atoms)) Amt
    (uses Alloc)
    (match (group_edges ss ms ms (NoEdges))
      ((NoEdges) (Is 1))
      ((Edges e more) (if (not (all_read ss ms))
        (Unread)
        (match (measure_of ss ms)
          ((None) (Unbounded))
          ((Some p) (tops ss p 0)))))))

  (fn tops ((ss Seens) (p Placed) (worst Int)) Amt
    (uses Alloc)
    (match p
      ((NoPlaced) (Is (+ worst 1)))
      ((Placed name at rest) (match (seen_named ss name)
        ((None) (Unread))
        ((Some s) (if (not (integer_kind (atom_at (get s kinds) at)))
          (Unbounded)
          (let top (upper (get s entry) (var_of (concat "p:" (concat name (concat ":" (atom_at (get s params) at))))) 0 1000000)
            (if (<= 1000000 top) (Unbounded) (tops ss rest (max_int worst top))))))))))

  ; The tightest bound on `x` that follows from `facts`, between `lo` and `hi`.
  (fn upper ((facts Formulas) (x Lin) (lo Int) (hi Int)) Int
    (uses Alloc)
    (if (str.eq (verdict facts (f_le x (num hi))) "proved") (narrowed_to facts x lo hi 64) hi))

  (fn narrowed_to ((facts Formulas) (x Lin) (lo Int) (hi Int) (left Int)) Int
    (uses Alloc)
    (requires (<= 0 left))
    (if (or (<= left 0) (<= hi lo))
      hi
      (let mid (half (+ lo hi))
        (if (str.eq (verdict facts (f_le x (num mid))) "proved")
          (narrowed_to facts x lo mid (- left 1))
          (narrowed_to facts x (+ mid 1) hi (- left 1))))))

  ; Rounded down, as Python's `//` has it, for the non-negative numbers asked here.
  (fn half ((n Int)) Int (match (num.div n 2) ((Some q) q) ((None) 0)))

  ; --- one pass through a body ---
  (fn walk_cost ((ss Seens) (names Atoms) (group Atoms) (t Tree) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match t
        ((Leaf x q) (make Walk (pass (none)) (memo memo)))
        ((Node items) (match items
          ((NoTrees) (make Walk (pass (none)) (memo memo)))
          ((Trees h args) (match h
            ((Node inner) (walk_all ss names group items (none) memo (- left 1)))
            ((Leaf x q) (form_cost ss names group (word_of h) args memo (- left 1))))))))))

  (fn walk_all ((ss Seens) (names Atoms) (group Atoms) (ts Trees) (acc Pass) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match ts
        ((NoTrees) (make Walk (pass acc) (memo memo)))
        ((Trees h rest) (let w (walk_cost ss names group h memo (- left 1))
          (walk_all ss names group rest (seq_pass acc (get w pass)) (get w memo) (- left 1)))))))

  ; The second item of each `(name value)`: the values of a make, a with or log.fields.
  (fn values_of ((ts Trees)) Trees
    (uses Alloc)
    (match ts
      ((NoTrees) ts)
      ((Trees h rest) (match (nth (items_of h) 1) ((None) (values_of rest)) ((Some v) (Trees v (values_of rest)))))))

  (fn form_cost ((ss Seens) (names Atoms) (group Atoms) (op Str) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (if (str.eq op "if")
        (if_cost ss names group args memo (- left 1))
        (if (str.eq op "match")
          (match_cost ss names group args memo (- left 1))
          (form_more ss names group op args memo (- left 1))))))

  (fn match_cost ((ss Seens) (names Atoms) (group Atoms) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match args
        ((NoTrees) (make Walk (pass (none)) (memo memo)))
        ((Trees scrut arms) (let w (walk_cost ss names group scrut memo (- left 1))
          (let a (arms_cost ss names group arms (none) false (get w memo) (- left 1))
            (make Walk (pass (seq_pass (get w pass) (get a pass))) (memo (get a memo)))))))))

  (fn form_more ((ss Seens) (names Atoms) (group Atoms) (op Str) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
          (if (or (str.eq op "make") (or (str.eq op "with") (str.eq op "log.fields")))
            (walk_all ss names group (fields_walked op args) (none) memo (- left 1))
              (if (str.eq op "infer")
                (let w (walk_all ss names group args (none) memo (- left 1)) (make Walk (pass (seq_pass (get w pass) (Costs 0 1 0))) (memo (get w memo))))
                (if (str.eq op "par")
                  (par_cost ss names group args memo (- left 1))
                  (if (str.eq op "scope")
                    (scope_cost ss names group args memo (- left 1))
                    (call_cost ss names group op args memo (- left 1))))))))

  ; What a make, a with or log.fields evaluates: the record changed (for a with) and the
  ; values of its `(name value)` pairs.
  (fn fields_walked ((op Str) (args Trees)) Trees
    (uses Alloc)
    (match args
      ((NoTrees) args)
      ((Trees r fields) (if (str.eq op "make") (values_of fields) (if (str.eq op "with") (Trees r (values_of fields)) (values_of args))))))

  (fn if_cost ((ss Seens) (names Atoms) (group Atoms) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) (make Walk (pass (NotRead)) (memo memo))
    (match args
      ((NoTrees) (make Walk (pass (none)) (memo memo)))
      ((Trees c rest) (let w (walk_cost ss names group c memo (- left 1))
        (let a (arms_cost ss names group rest (none) true (get w memo) (- left 1))
          (make Walk (pass (seq_pass (get w pass) (get a pass))) (memo (get a memo)))))))))

  ; Alternatives, only one of which runs: the worst. `bare` when they are expressions, not
  ; `(pattern body)` arms.
  (fn arms_cost ((ss Seens) (names Atoms) (group Atoms) (arms Trees) (acc Pass) (bare Bool) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match arms
        ((NoTrees) (make Walk (pass acc) (memo memo)))
        ((Trees a rest) (let body (if bare (Some a) (nth (items_of a) 1))
          (match body
            ((None) (arms_cost ss names group rest acc bare memo (- left 1)))
            ((Some b) (let w (walk_cost ss names group b memo (- left 1))
              (arms_cost ss names group rest (worst_pass acc (get w pass)) bare (get w memo) (- left 1))))))))))

  (fn separate ((clauses Trees)) Bool
    (uses Alloc)
    (match clauses
      ((NoTrees) false)
      ((Trees c rest) (if (head_is c "on")
        (match (nth (items_of c) 1) ((None) false) ((Some w) (or (str.eq (word_of w) "process") (str.eq (word_of w) "node"))))
        (separate rest)))))

  ; `(par ((name work [(on where)])...) body)`: the branches side by side, then the body.
  (fn par_cost ((ss Seens) (names Atoms) (group Atoms) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) (make Walk (pass (NotRead)) (memo memo))
    (match args
      ((NoTrees) (make Walk (pass (none)) (memo memo)))
      ((Trees bs rest) (let w (branches_cost ss names group (items_of bs) (none) memo (- left 1))
        (let b (walk_all ss names group rest (none) (get w memo) (- left 1))
          (make Walk (pass (seq_pass (get w pass) (get b pass))) (memo (get b memo)))))))))

  (fn branches_cost ((ss Seens) (names Atoms) (group Atoms) (bs Trees) (acc Pass) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match bs
        ((NoTrees) (make Walk (pass acc) (memo memo)))
        ((Trees b rest) (let parts (items_of b)
          (if (separate (drop_two parts))
            (branches_cost ss names group rest (side_pass acc (none)) memo (- left 1))
            (match (nth parts 1)
              ((None) (branches_cost ss names group rest acc memo (- left 1)))
              ((Some work) (let w (walk_cost ss names group work memo (- left 1))
                (branches_cost ss names group rest (side_pass acc (get w pass)) (get w memo) (- left 1)))))))))))

  (fn drop_two ((ts Trees)) Trees
    (match ts ((NoTrees) ts) ((Trees a rest) (match rest ((NoTrees) rest) ((Trees b more) more)))))

  ; `(scope ((name work (deadline d) (on-fail p) [(on where)])...) body)`: a task may run up to
  ; its restart limit, its deadline is work too, and all of it is side by side with the body.
  (fn scope_cost ((ss Seens) (names Atoms) (group Atoms) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) (make Walk (pass (NotRead)) (memo memo))
    (match args
      ((NoTrees) (make Walk (pass (none)) (memo memo)))
      ((Trees ts rest) (let w (tasks_cost ss names group (items_of ts) (none) memo (- left 1))
        (let b (walk_all ss names group rest (none) (get w memo) (- left 1))
          (make Walk (pass (side_pass (get w pass) (get b pass))) (memo (get b memo)))))))))

  (fn tasks_cost ((ss Seens) (names Atoms) (group Atoms) (ts Trees) (acc Pass) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match ts
        ((NoTrees) (make Walk (pass acc) (memo memo)))
        ((Trees t rest) (let w (task_cost ss names group (items_of t) memo (- left 1))
          (tasks_cost ss names group rest (side_pass acc (get w pass)) (get w memo) (- left 1)))))))

  (fn task_cost ((ss Seens) (names Atoms) (group Atoms) (parts Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (make Walk (pass (NotRead)) (memo memo))
      (match (nth parts 1)
        ((None) (make Walk (pass (none)) (memo memo)))
        ((Some work) (let w (walk_cost ss names group work memo (- left 1))
          (let d (walk_all ss names group (deadlines (drop_two parts)) (none) (get w memo) (- left 1))
            (make Walk (pass (side_pass (tried (get w pass) (drop_two parts)) (get d pass))) (memo (get d memo)))))))))

  (fn tried ((p Pass) (clauses Trees)) Pass
    (uses Alloc)
    (match p
      ((Costs dd a k) (if (separate clauses) (none) (Costs dd (* a (tries clauses)) (* k (tries clauses)))))
      ((NoBound) p)
      ((NotRead) p)))

  (fn deadlines ((clauses Trees)) Trees
    (uses Alloc)
    (match clauses
      ((NoTrees) clauses)
      ((Trees c rest) (if (head_is c "deadline") (match (nth (items_of c) 1) ((None) (deadlines rest)) ((Some d) (Trees d (deadlines rest)))) (deadlines rest)))))

  (fn tries ((clauses Trees)) Int
    (uses Alloc)
    (match clauses
      ((NoTrees) 1)
      ((Trees c rest) (if (head_is c "on-fail")
        (if (str.eq (match (nth (items_of c) 1) ((None) "") ((Some w) (word_of w))) "restart")
          (match (nth (items_of c) 2) ((None) 1) ((Some n) (+ 1 (number_of n))))
          1)
        (tries rest)))))

  ; A call: its arguments, then what it is -- a function of another group adds that group's
  ; cost, one of this group is counted by the repeats, an allocating builtin builds one thing.
  (fn call_cost ((ss Seens) (names Atoms) (group Atoms) (op Str) (args Trees) (memo Memo) (left Int)) Walk
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) (make Walk (pass (NotRead)) (memo memo))
    (let w (walk_all ss names group args (none) memo (- left 1))
      (if (holds names op)
        (if (holds group op)
          (make Walk (pass (seq_pass (get w pass) (Costs 0 0 1))) (memo (get w memo)))
          (let c (group_cost ss names op (get w memo) (- left 1))
            (make Walk (pass (seq_pass (get w pass) (pass_of (get c cost)))) (memo (get c memo)))))
        (make Walk (pass (seq_pass (get w pass) (Costs 0 (if (builds op) 1 0) 0))) (memo (get w memo)))))))

  (fn pass_of ((c GCost)) Pass
    (match (get c deep)
      ((Unbounded) (NoBound))
      ((Unread) (NotRead))
      ((Is d) (match (get c alloc) ((Is a) (Costs d a 0)) ((Unbounded) (NoBound)) ((Unread) (NotRead))))))

  (fn builds ((op Str)) Bool
    (uses Alloc)
    (if (or (str.eq op "array.empty") (str.eq op "array.push"))
      true
      (match (primitive op) ((None) false) ((Some b) (names_has_alloc (get b effects))))))

  (fn names_has_alloc ((ns Names)) Bool
    (match ns ((NoNames) false) ((Names n rest) (or (str.eq n "Alloc") (names_has_alloc rest)))))

  ; What a function's `(bounds (depth N) (alloc N) (repeats N))` says against what it may use:
  ; a finding for each that is exceeded or unbounded, or "?" when it rests on what is not read.
  (fn bound_findings ((c GCost) (bs Trees)) Str
    (uses Alloc)
    (match bs
      ((NoTrees) "")
      ((Trees b rest) (let what (word_of (match (nth (items_of b) 0) ((None) b) ((Some w) w)))
        (let declared (match (nth (items_of b) 1) ((None) 0) ((Some n) (number_of n)))
          (let actual (if (str.eq what "depth") (get c deep) (if (str.eq what "alloc") (get c alloc) (get c repeats)))
            (let more (bound_findings c rest)
              (match actual
                ((Unread) "?")
                ((Unbounded) (if (str.eq more "?") more (concat "resource-bound " more)))
                ((Is n) (if (or (str.eq more "?") (<= n declared)) more (concat "resource-bound " more)))))))))))

  ; --- the report: one line per fn --------------------------------------------------------------------------------------------
  ; A recursive function's line says whether its group was read and, on the group's first
  ; member as Python reports it, whether no measure was found.
  (fn line_of ((ss Seens) (s Seen)) Str
    (uses Alloc)
    (let shown (termination_line ss s)
      (match (get s declared)
        ((NoTrees) shown)
        ((Trees b more) (if (or (not (get s read)) (bytes.eq (bytes.slice (str.encode shown) (Octets 0) (Octets 12)) (str.encode "not read yet")))
          shown
          (let found (bound_findings (get (group_cost ss (fn_names_of ss) (get s name) (NoMemo) 100000) cost) (get s declared))
            (if (str.eq found "?")
              "not read yet: a bound that rests on a function this does not read"
              (concat shown found))))))))

  (fn fn_names_of ((ss Seens)) Atoms
    (uses Alloc)
    (match ss ((NoSeens) (NoAtoms)) ((Seens h rest) (Atoms (get h name) (fn_names_of rest)))))

  (fn termination_line ((ss Seens) (s Seen)) Str
    (uses Alloc)
    (let ms (group_of ss (get s name))
      (let text (match ms
        ((NoAtoms) (get s text))
        ((Atoms first more) (if (not (get s read))
          (get s text)
          (if (not (all_read ss ms))
            "not read yet: a recursion through a function this does not read"
            (if (and (str.eq (least ms (get s name)) (get s name)) (not (terminates ss ms)))
              (concat (get s text) "no-termination-proof ")
              (get s text))))))
        text)))

  (fn report_seens ((all Seens) (ss Seens)) Str
    (uses Alloc)
    (match ss
      ((NoSeens) "")
      ((Seens h rest) (concat (if (get h line) (let text (line_of all h) (concat (get h name) (concat ": " (concat (if (str.eq text "") "ok" text) "\n")))) "") (report_seens all rest)))))

  (fn report_items ((cx Cx) (items Trees)) Str
    (uses Alloc)
    (let all (trees_append (prelude_items) items)
      (let ss (seens_of cx (fn_names all) all)
        (report_seens ss (seens_of_module ss items)))))

  ; The module's own functions, as already seen among everything.
  (fn seens_of_module ((all Seens) (items Trees)) Seens
    (uses Alloc)
    (match items
      ((NoTrees) (NoSeens))
      ((Trees h rest) (if (head_is h "fn")
        (match (after_head h) ((NoTrees) (seens_of_module all rest)) ((Trees n more) (match (seen_named all (declared_name n)) ((None) (seens_of_module all rest)) ((Some s) (Seens s (seens_of_module all rest))))))
        (seens_of_module all rest)))))

  (fn report_source ((src Str)) Str
    (uses Alloc)
    (match (parse (tokens_of (str.encode src)))
      ((Err f) (concat "not a form: " (get f why)))
      ((Ok tree) (report_items (make Cx (fns (infos_of (newtypes_of (module_items tree)) (trees_append (prelude_items) (module_items tree)))) (open (NoAtoms)) (news (newtypes_of (trees_append (prelude_items) (module_items tree)))) (recs (recs_of (trees_append (prelude_items) (module_items tree)))) (vars (vars_of (trees_append (prelude_items) (module_items tree)))) (contract false) (me "") (foreigns (foreigns_of (module_items tree)))) (module_items tree)))))

  (test "a bound that follows from the requires is proved" (str.eq "f: ok\n" (report_source "(module m (fn f ((n Int)) Int (requires (<= 0 n)) (ensures (<= 0 result)) (+ n 1)))")))

  (test "a bound that does not follow is refused" (str.eq "f: unproven-postcondition \n" (report_source "(module m (fn f ((n Int)) Int (ensures (<= 0 result)) (+ n 1)))")))

  (test "a call must establish what the callee requires" (str.eq "f: ok\ng: unproven-precondition \n" (report_source "(module m (fn f ((n Int)) Int (requires (<= 0 n)) n) (fn g ((n Int)) Int (f n)))")))

  (fn main () Unit
    (uses Alloc Console)
    (print (report_source "(module m (fn f ((n Int)) Int (requires (<= 0 n)) (ensures (<= 0 result)) (+ n 1)))"))))
