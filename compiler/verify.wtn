  (fn arms_of ((ts Trees)) Arms
    (uses Alloc)
    (match ts
      ((NoTrees) (NoArms))
      ((Trees h rest) (match (node_items h)
        ((None) (Arms (make Arm (variant "") (binders (NoAtoms)) (body h)) (arms_of rest)))
        ((Some parts) (match parts
          ((NoTrees) (Arms (make Arm (variant "") (binders (NoAtoms)) (body h)) (arms_of rest)))
          ((Trees pattern more) (match more
            ((NoTrees) (Arms (make Arm (variant "") (binders (NoAtoms)) (body h)) (arms_of rest)))
            ((Trees body none) (match (node_items pattern)
