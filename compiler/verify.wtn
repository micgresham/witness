  (fn arm_bound ((cx Cx) (binds Binds) (st St) (key Str) (ty Str) (v VarD) (a Arm) (rest Arms) (left Int)) (Result Walked Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
