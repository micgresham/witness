    (match s
      ((Num x ty) (match (type_args ty) ((NoTrees) "?") ((Trees t rest) (type_ty t 20))))
      ((Ctor v fs) (match fs ((NoSyms) "?") ((Syms f more) (sym_ty f))))
      ((Truth f) "?")
      ((Rec n fs) "?")))

  (fn sym_ty ((s Sym)) Str
