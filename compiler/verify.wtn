            ((NoTrees) (unread "a scope needs a body"))
            ((Trees body none) (match (value cx (get b binds) (get b st) body (- left 1))
              ((Err f) (Err f))
              ((Ok o) (Ok (unknown (get o st) "?" false))))))))))))

  (fn task_values ((cx Cx) (outer Binds) (inner Binds) (st St) (ts Trees) (left Int)) (Result Bound Fault)
    (uses Alloc)
    (requires (<= 0 left))
