  (record Bound (binds Binds) (st St))

  ; Each binder is a value of its field's type, known to be a part of the whole.
  (fn arm_binds ((cx Cx) (st St) (key Str) (ty Str) (v VarD) (variant Str) (names Atoms) (i Int) (binds Binds) (left Int)) (Result Bound Fault)
    (uses Alloc)
    (requires (<= 0 left))
