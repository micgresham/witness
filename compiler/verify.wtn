  (fn opaque_arms ((cx Cx) (binds Binds) (st St) (key Str) (ty Str) (arms Arms) (left Int)) (Result Out Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
    (match (arm_cases cx binds (exclusive arms key (facts_plus st (f_disj (tags_of arms key)))) key ty arms (- left 1))
      ((Err f) (Err f))
      ((Ok done) (Ok (joined_all (get done st) (get done cases)))))))

  (record Walked (cases Cases) (st St))

  (fn arm_cases ((cx Cx) (binds Binds) (st St) (key Str) (ty Str) (arms Arms) (left Int)) (Result Walked Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
    (match arms
      ((NoArms) (Ok (make Walked (cases (NoCases)) (st st))))
      ((Arms a rest) (arm_case cx binds st key ty a rest (- left 1))))))

  (fn arm_case ((cx Cx) (binds Binds) (st St) (key Str) (ty Str) (a Arm) (rest Arms) (left Int)) (Result Walked Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
    (match (var_named (get cx vars) (get a variant))
