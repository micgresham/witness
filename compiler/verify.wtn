  (fn arm_bind ((cx Cx) (st St) (key Str) (ty Str) (v VarD) (variant Str) (n Str) (rest Atoms) (i Int) (binds Binds) (left Int)) (Result Bound Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
    (match (variant_ty v ty i)
      ((None) (unbound "a variant field of a type this does not know"))
