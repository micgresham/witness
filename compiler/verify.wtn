  (fn arm_branch ((cx Cx) (binds Binds) (key Str) (ty Str) (a Arm) (rest Arms) (bound Bound) (left Int)) (Result Walked Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
