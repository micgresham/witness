      (Err (fault "verify" "the expression is nested too deeply"))
      (match ts
        ((NoTrees) (Ok (make Bound (binds inner) (st st))))
        ((Trees t rest) (match (task_value cx outer st (items_of t) (- left 1))
          ((Err f) (Err f))
          ((Ok o) (task_values cx outer (Binds (match (nth (items_of t) 0) ((None) "") ((Some n) (word_of n))) (get o sym) inner) (get o st) rest (- left 1))))))))

  ; The work and then the deadline are read; the task's name is a fresh value of what it carries.
  (fn task_value ((cx Cx) (outer Binds) (st St) (parts Trees) (left Int)) (Result Out Fault)
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0)
      (Err (fault "verify" "the expression is nested too deeply"))
      (match (nth parts 1)
        ((None) (unread "a task needs work"))
        ((Some work) (match (value cx outer st work (- left 1))
          ((Err f) (Err f))
