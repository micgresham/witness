; Witness to Cortex-M0 (ARMv6-M), from the same instructions the other backends write.
;
; This is the Cortex-M3 image (native_thumb.wtn) on the smaller instruction set, with its memory
; map and so its bounds. A constant is built a byte at a time; the operand stack pointer moves
; before a push writes, there being no negative offset; r6 is the temporary and r7 the operand stack
; pointer, with the frame and the memory base in r8 and r9, reached through r6; a product is shift
; and add; and BL is the jump, since LR is already in the frame.
;
; Almost nothing here is written by hand: tools/gen_armv6m.py makes it from native_thumb.wtn.
; Edit that, not this.
;
; The evidence is tests/test_native_thumb.py: the image is run in Unicorn, every instruction it
; holds is read and refused if ARMv6-M has no such thing (Unicorn's Cortex-M0 would run it), and
; what it prints is compared with the interpreter's.
;
;   witness test compiler/native_armv6m.wtn
(module native_armv6m
  (use "wtn:8be2edc17933e3f38aba6ee3bc6960aaa2e82f42c8b8022ec3d187702ed47a20" as imm64)

  (use "wtn:30701617d68c3654a403fd5dedb917a11d116e4e5ce3d16cc8059f76e8f0b497" as imm32)

  (use "wtn:3752be75d9b35195f27bce3966247382cbf1f4b367ca42472081c4579c41a784" as low8)

  (use "wtn:a21c39d745ed071e8a191a37f70dd1779e3f66cef78971e75cc5db8d15985d3a" as Ins)

  (use "wtn:1073bcf7f2ec07adcc09eb7c2e8fe48e9f9e9761a767076f6172edba3db8cde8" as Inss)

  (use "wtn:6049eb96cd5bb0261e93f3b63d858e9295b28d4454c9d335d6fc6b7357255c97" as Segment)

  (use "wtn:1d8850cc1eac3078061af0c4abac9ffb8c04c7f625724d647535443ad3cd3899" as Segments)

  (use "wtn:746b7af1483e2ad3bac5bd48a927f405dda763ad2e13285b41298d2d268a366f" as Imports)

  (use "wtn:780cd5f1caffd09ae27df62731b93b0f47c18f7b93487643ce22510a7c5f029b" as Func)

  (use "wtn:3e591891f9cf54232e04bb14b46fe1ad8efe8c82e1ddad2a481589bba3844f43" as Funcs)

  (use "wtn:aaa5788594cd2f68165abd0f2e6560c4aa6aaf92e09822948cc887f7cd927be5" as Module)

  (fn no_bytes () Bytes
    (uses Alloc)
    (str.encode ""))

  (fn byte ((n I64)) U8 (u8.of (bit.and n (i64.of 255))))

  (fn half ((h I64)) Bytes
    (uses Alloc)
    (bytes.concat (bytes.of (byte h)) (bytes.of (byte (bit.shr h 8)))))

  (fn wide ((a I64) (b I64)) Bytes
    (uses Alloc)
    (bytes.concat (half a) (half b)))

  (fn plus ((a I64) (b I64)) I64 (wrap.add a b))

  (fn at ((n I64) (by U32)) I64 (bit.shl n (int.of by)))

  (fn bits ((n I64) (from U32) (mask I64)) I64 (bit.and (bit.shr n (int.of from)) mask))

  (fn low ((r U32)) I64 (i64.of (bit.and r (u32.of 7))))

  (fn number ((r U32)) I64 (i64.of (bit.and r (u32.of 15))))

  ; MOV, ADD: any two registers, and neither touches the flags when written this way.
  (fn high_form ((op I64) (d U32) (m U32)) Bytes
    (uses Alloc)
    (half (plus op (plus (at (bit.shr (number d) 3) (u32.of 7)) (plus (at (number m) (u32.of 3)) (low d))))))

  (fn mov_rr ((d U32) (m U32)) Bytes (uses Alloc) (high_form (i64.of 17920) d m))

  (fn add_high ((d U32) (m U32)) Bytes (uses Alloc) (high_form (i64.of 17408) d m))

  (fn three ((op I64) (d U32) (n U32) (m U32)) Bytes
    (uses Alloc)
    (half (plus op (plus (at (low m) (u32.of 6)) (plus (at (low n) (u32.of 3)) (low d))))))

  (fn adds3 ((d U32) (n U32) (m U32)) Bytes (uses Alloc) (three (i64.of 6144) d n m))

  (fn subs3 ((d U32) (n U32) (m U32)) Bytes (uses Alloc) (three (i64.of 6656) d n m))

  (fn addi3 ((d U32) (n U32) (v I64)) Bytes
    (uses Alloc)
    (half (plus (i64.of 7168) (plus (at (bit.and v (i64.of 7)) (u32.of 6)) (plus (at (low n) (u32.of 3)) (low d))))))

  ; d, and a byte.
  (fn eight ((op I64) (d U32) (v I64)) Bytes
    (uses Alloc)
    (half (plus op (plus (at (low d) (u32.of 8)) (bit.and v (i64.of 255))))))

  (fn movs ((d U32) (v I64)) Bytes (uses Alloc) (eight (i64.of 8192) d v))

  (fn cmpi ((d U32) (v I64)) Bytes (uses Alloc) (eight (i64.of 10240) d v))

  (fn addi8 ((d U32) (v I64)) Bytes (uses Alloc) (eight (i64.of 12288) d v))

  (fn subi8 ((d U32) (v I64)) Bytes (uses Alloc) (eight (i64.of 14336) d v))

  ; The two-register data operations: d is both the first operand and the answer.
  (fn alu ((op I64) (d U32) (m U32)) Bytes
    (uses Alloc)
    (half (plus (i64.of 16384) (plus (at op (u32.of 6)) (plus (at (low m) (u32.of 3)) (low d))))))

  (fn ands ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 0) d m))

  (fn eors ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 1) d m))

  (fn lsls ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 2) d m))

  (fn lsrs ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 3) d m))

  (fn asrs ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 4) d m))

  (fn adcs ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 5) d m))

  (fn sbcs ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 6) d m))

  (fn cmp_rr ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 10) d m))

  (fn orrs ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 12) d m))

  (fn mvns ((d U32) (m U32)) Bytes (uses Alloc) (alu (i64.of 15) d m))

  (fn shifted ((op I64) (d U32) (m U32) (by I64)) Bytes
    (uses Alloc)
    (half (plus op (plus (at (bit.and by (i64.of 31)) (u32.of 6)) (plus (at (low m) (u32.of 3)) (low d))))))

  (fn lsli ((d U32) (m U32) (by I64)) Bytes (uses Alloc) (shifted (i64.of 0) d m by))

  (fn lsri ((d U32) (m U32) (by I64)) Bytes (uses Alloc) (shifted (i64.of 2048) d m by))

  (fn asri ((d U32) (m U32) (by I64)) Bytes (uses Alloc) (shifted (i64.of 4096) d m by))

  ; A word's offset is in words, and a load's base is r0-r7 or sp; a byte's in bytes.
  (fn word_at ((op I64) (t U32) (n U32) (off I64)) Bytes
    (uses Alloc)
    (half (plus op (plus (at (bit.and (bit.shr off 2) (i64.of 31)) (u32.of 6)) (plus (at (low n) (u32.of 3)) (low t))))))

  (fn ldr ((t U32) (n U32) (off I64)) Bytes (uses Alloc) (word_at (i64.of 26624) t n off))

  (fn str ((t U32) (n U32) (off I64)) Bytes (uses Alloc) (word_at (i64.of 24576) t n off))

  (fn ldrb ((t U32) (n U32)) Bytes (uses Alloc) (word_at (i64.of 30720) t n (i64.of 0)))

  (fn strb ((t U32) (n U32)) Bytes (uses Alloc) (word_at (i64.of 28672) t n (i64.of 0)))

  (fn ldr_sp ((t U32) (off I64)) Bytes (uses Alloc) (eight (i64.of 38912) t (bit.shr off 2)))

  (fn str_sp ((t U32) (off I64)) Bytes (uses Alloc) (eight (i64.of 36864) t (bit.shr off 2)))

  ; A constant a byte at a time, from its top; each step leaves the flags changed.
  (fn next_byte ((d U32) (v I64)) Bytes
    (uses Alloc)
    (if (= v (i64.of 0)) (lsli d d (i64.of 8)) (bytes.concat (lsli d d (i64.of 8)) (addi8 d v))))

  (fn byte_of ((v I64) (from U32)) I64 (bit.and (bit.shr v (int.of from)) (i64.of 255)))

  (fn mov_imm ((d U32) (n I64)) Bytes
    (uses Alloc)
    (let v (bit.and n (i64.of 4294967295))
      (if (< v (i64.of 256))
        (movs d v)
        (if (< v (i64.of 65536))
          (bytes.concat (movs d (byte_of v (u32.of 8))) (next_byte d (byte_of v (u32.of 0))))
          (if (< v (i64.of 16777216))
            (bytes.concat (movs d (byte_of v (u32.of 16))) (bytes.concat (next_byte d (byte_of v (u32.of 8))) (next_byte d (byte_of v (u32.of 0)))))
            (bytes.concat (movs d (byte_of v (u32.of 24))) (bytes.concat (next_byte d (byte_of v (u32.of 16))) (bytes.concat (next_byte d (byte_of v (u32.of 8))) (next_byte d (byte_of v (u32.of 0)))))))))))

  ; d = n + m, with whichever of them may be high.
  (fn add_rr ((d U32) (n U32) (m U32)) Bytes
    (uses Alloc)
    (if (= d n)
      (add_high d m)
      (if (= d m) (add_high d n) (bytes.concat (mov_rr d n) (add_high d m)))))

  ; A condition's branch reaches 256 bytes each way, B 2048, and BL sixteen megabytes.
  (fn bcond ((c U32) (off I64)) Bytes
    (uses Alloc)
    (half (plus (i64.of 53248) (plus (at (i64.of c) (u32.of 8)) (bit.and (bit.shr (wrap.sub off (i64.of 4)) 1) (i64.of 255))))))

  (fn b_near ((off I64)) Bytes
    (uses Alloc)
    (half (plus (i64.of 57344) (bit.and (bit.shr (wrap.sub off (i64.of 4)) 1) (i64.of 2047)))))

  (fn cmp_i ((n U32) (v I64)) Bytes (uses Alloc) (cmpi n v))

  (fn blx_r ((m U32)) Bytes (uses Alloc) (half (plus (i64.of 18304) (at (number m) (u32.of 3)))))

  (fn ret () Bytes (uses Alloc) (half (i64.of 18288)))

  (fn bkpt () Bytes (uses Alloc) (half (i64.of 48640)))

  ; The jump within a function: BL, whose clobbering of LR costs nothing, the frame having it.
  (fn b ((off I64)) Bytes (uses Alloc) (bl off))

  (fn cond_of ((f3 U32)) U32
    (if (= f3 (u32.of 0)) (u32.of 0)
      (if (= f3 (u32.of 1)) (u32.of 1)
        (if (= f3 (u32.of 4)) (u32.of 11)
          (if (= f3 (u32.of 5)) (u32.of 10)
            (if (= f3 (u32.of 6)) (u32.of 3) (u32.of 2)))))))

  (fn insn_size () U32 (u32.of 4))

  (fn not_cond ((c U32)) U32 (bit.xor c (u32.of 1)))

  (fn long_jump ((second I64) (off I64)) Bytes
    (uses Alloc)
    (let d (wrap.sub off (i64.of 4))
      (let s (bits d (u32.of 24) (i64.of 1))
        (let j1 (bit.xor (i64.of 1) (bit.xor (bits d (u32.of 23) (i64.of 1)) s))
          (let j2 (bit.xor (i64.of 1) (bit.xor (bits d (u32.of 22) (i64.of 1)) s))
            (wide (plus (i64.of 61440) (plus (at s (u32.of 10)) (bits d (u32.of 12) (i64.of 1023))))
                  (plus second (plus (at j1 (u32.of 13)) (plus (at j2 (u32.of 11)) (bits d (u32.of 1) (i64.of 2047)))))))))))

  (fn bl ((off I64)) Bytes (uses Alloc) (long_jump (i64.of 53248) off))

  (fn jump_cmp ((a U32) (b U32)) Bytes
    (uses Alloc)
    (if (= b (zero)) (cmp_i a (i64.of 0)) (cmp_rr a b)))

  (fn host_call ((k U32)) Bytes
    (uses Alloc)
    (cat (mov_imm (tmp) (wrap.add (i64.of 150994944) (i64.of (wrap.add (wrap.mul k (u32.of 16)) (u32.of 1))))) (blx_r (tmp))))

  (fn push_frame () Bytes
    (uses Alloc)
    (cat4 (half (i64.of 45188)) (cat (mov_rr (tmp) (u32.of 14)) (str_sp (tmp) (i64.of 8))) (mov_rr (tmp) (fp)) (str_sp (tmp) (i64.of 0))))

  (fn pop_frame () Bytes
    (uses Alloc)
    (cat4 (ldr_sp (tmp) (i64.of 0)) (cat (mov_rr (fp) (tmp)) (ldr_sp (tmp) (i64.of 8))) (mov_rr (u32.of 14) (tmp)) (half (i64.of 45060))))

  (fn octets ((b Bytes)) U32
    (let n (unwrap (bytes.len b)) (if (<= n 4294967295) (u32.of n) (u32.of 0))))

  (fn greater ((a U32) (b U32)) U32 (if (< a b) b a))

  (fn less ((a U32) (b U32)) U32 (if (< a b) (u32.of 0) (- a b)))

  (enum VItem
    (VRaw (code Bytes))
    (VMark (id U32))
    (VJump (id U32))
    (VJumpIf (f3 U32) (a U32) (b U32) (id U32))
    (VCallFn (func U32)))

  (enum VItems (VNoItems) (VItems (head VItem) (rest VItems)))

  (fn items_join ((a VItems) (b VItems)) VItems
    (match a ((VNoItems) b) ((VItems h rest) (VItems h (items_join rest b)))))

  (fn raw ((code Bytes)) VItems (VItems (VRaw code) (VNoItems)))

  (fn item ((i VItem)) VItems (VItems i (VNoItems)))

  (fn item_size ((i VItem)) U32
    (match i
      ((VRaw code) (octets code))
      ((VMark id) (u32.of 0))
      ((VJump id) (u32.of 4))
      ((VJumpIf f3 a b id) (u32.of 8))
      ((VCallFn func) (u32.of 4))))

  (fn items_size ((is VItems)) U32
    (match is
      ((VNoItems) (u32.of 0))
      ((VItems h rest) (wrap.add (item_size h) (items_size rest)))))

  (enum VLabels (VNoLabels) (VLabels (id U32) (offset U32) (rest VLabels)))

  (fn labels_of ((is VItems) (at U32)) VLabels
    (match is
      ((VNoItems) (VNoLabels))
      ((VItems h rest) (match h ((VMark id) (VLabels id at (labels_of rest at))) ((VRaw code) (labels_of rest (wrap.add at (item_size h)))) ((VJump id) (labels_of rest (wrap.add at (item_size h)))) ((VJumpIf f3 a b id) (labels_of rest (wrap.add at (item_size h)))) ((VCallFn func) (labels_of rest (wrap.add at (item_size h))))))))

  (fn label_at ((ls VLabels) (mark U32)) U32
    (match ls
      ((VNoLabels) (u32.of 0))
      ((VLabels l offset rest) (if (= l mark) offset (label_at rest mark)))))

  (enum VStarts (VNoStarts) (VStarts (offset U32) (rest VStarts)))

  (fn start_of ((ss VStarts) (index U32)) U32
    (match ss
      ((VNoStarts) (u32.of 0))
      ((VStarts offset rest) (if (<= index (u32.of 0)) offset (start_of rest (- index (u32.of 1)))))))

  (fn distance ((target U32) (at U32)) I64 (wrap.sub (i64.of target) (i64.of at)))

  (fn item_bytes ((i VItem) (at U32) (ls VLabels) (ss VStarts)) Bytes
    (uses Alloc)
    (match i
      ((VRaw code) code)
      ((VMark id) (no_bytes))
      ((VJump id) (b (distance (label_at ls id) at)))
      ((VJumpIf f3 a b id) (cat3 (jump_cmp a b) (bcond (not_cond (cond_of f3)) (i64.of 6)) (b (distance (label_at ls id) (wrap.add at (u32.of 4))))))
      ((VCallFn func) (bl (distance (start_of ss func) at)))))

  (fn r0 () U32 (wrap.sub (u32.of 16) (u32.of 16)))

  (fn r1 () U32 (wrap.sub (u32.of 17) (u32.of 16)))

  (fn r2 () U32 (wrap.sub (u32.of 18) (u32.of 16)))

  (fn r3 () U32 (wrap.sub (u32.of 19) (u32.of 16)))

  (fn r4 () U32 (wrap.sub (u32.of 20) (u32.of 16)))

  (fn r5 () U32 (wrap.sub (u32.of 21) (u32.of 16)))

  (fn zero () U32 (wrap.sub (u32.of 115) (u32.of 16)))

  (fn sp () U32 (wrap.sub (u32.of 29) (u32.of 16)))

  (fn tmp () U32 (u32.of 6))

  (fn fp () U32 (u32.of 8))

  (fn mem () U32 (u32.of 9))

  (fn os () U32 (u32.of 7))

  (fn cat ((a Bytes) (b Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a b))

  (fn cat3 ((a Bytes) (b Bytes) (c Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b c)))

  (fn cat4 ((a Bytes) (b Bytes) (c Bytes) (d Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b (bytes.concat c d))))

  (fn push ((r U32)) Bytes
    (uses Alloc)
    (cat4 (subi8 (os) (i64.of 8)) (str r (os) (i64.of 0)) (movs (tmp) (i64.of 0)) (str (tmp) (os) (i64.of 4))))

  (fn pop ((r U32)) Bytes
    (uses Alloc)
    (cat (ldr r (os) (i64.of 0)) (addi8 (os) (i64.of 8))))

  (fn pushp ((lo U32) (hi U32)) Bytes
    (uses Alloc)
    (cat3 (subi8 (os) (i64.of 8)) (str lo (os) (i64.of 0)) (str hi (os) (i64.of 4))))

  (fn popp ((lo U32) (hi U32)) Bytes
    (uses Alloc)
    (cat3 (ldr lo (os) (i64.of 0)) (ldr hi (os) (i64.of 4)) (addi8 (os) (i64.of 8))))

  (fn peekp ((lo U32) (hi U32)) Bytes
    (uses Alloc)
    (cat (ldr lo (os) (i64.of 0)) (ldr hi (os) (i64.of 4))))

  (fn cell_get ((d U32) (at I64)) Bytes (uses Alloc) (cat (mov_imm (tmp) at) (ldr d (tmp) (i64.of 0))))

  (fn cell_set ((s U32) (at I64)) Bytes (uses Alloc) (cat (mov_imm (tmp) at) (str s (tmp) (i64.of 0))))

  (fn addi ((d U32) (n U32) (imm I64)) Bytes
    (uses Alloc)
    (if (and (<= (i64.of -255) imm) (<= imm (i64.of 255)))
      (cat (if (= d n) (no_bytes) (mov_rr d n))
           (if (< imm (i64.of 0)) (subi8 d (wrap.sub (i64.of 0) imm)) (addi8 d imm)))
      (cat (mov_imm (tmp) imm) (add_rr d n (tmp)))))

  (fn lbux ((dst U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (ldrb dst (tmp))))

  (fn sbx ((src U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (strb src (tmp))))

  (fn add_big ((d U32) (n U32) (imm I64)) Bytes (uses Alloc) (addi d n imm))

  ; The temporary at a frame's slot: the frame's register is one no load can use.
  (fn frame_slot ((disp I64)) Bytes (uses Alloc) (addi (tmp) (fp) disp))

  (fn frame_loadp ((lo U32) (hi U32) (disp I64)) Bytes
    (uses Alloc)
    (cat3 (frame_slot disp) (ldr lo (tmp) (i64.of 0)) (ldr hi (tmp) (i64.of 4))))

  (fn frame_storep ((lo U32) (hi U32) (disp I64)) Bytes
    (uses Alloc)
    (cat3 (frame_slot disp) (str lo (tmp) (i64.of 0)) (str hi (tmp) (i64.of 4))))

  (fn widen ((n U32)) I64 (i64.of n))

  (enum VShapes (VNoShapes) (VShapes (params U32) (results U32) (rest VShapes)))

  (fn shape_at ((ss VShapes) (index U32)) (Option VShapes)
    (match ss
      ((VNoShapes) (None))
      ((VShapes p r rest) (if (<= index (u32.of 0)) (Some ss) (shape_at rest (- index (u32.of 1)))))))

  (enum VHostfns
    (VNoHostfns)
    (VHostfns (name Str) (params U32) (results U32) (rest VHostfns)))

  (fn host_at ((hs VHostfns) (slot U32)) (Option VHostfns)
    (match hs
      ((VNoHostfns) (None))
      ((VHostfns n p r rest) (if (<= slot (u32.of 0)) (Some hs) (host_at rest (- slot (u32.of 1)))))))

  (record VFx (params U32) (locals U32) (results U32) (shapes VShapes) (hosts VHostfns))

  (fn local_disp ((fx VFx) (index U32)) I64
    (if (< index (get fx params))
      (widen (wrap.mul (wrap.sub (wrap.sub (get fx params) (u32.of 1)) index) (u32.of 8)))
      (wrap.sub (i64.of 0)
        (widen (wrap.mul (wrap.add (wrap.sub index (get fx params)) (u32.of 1)) (u32.of 8))))))

  (fn frame_depth ((fx VFx) (h U32)) U32 (wrap.mul (wrap.add (get fx locals) h) (u32.of 8)))

  (fn set_stack ((fx VFx) (h U32)) Bytes
    (uses Alloc)
    (add_big (os) (fp) (wrap.sub (i64.of 0) (widen (frame_depth fx h)))))

  (record VSt (h U32) (next U32) (dead Bool))

  (record VWalked (items VItems) (st VSt))

  (enum VCtrl (VNoCtrl) (VCtrl (target U32) (height U32) (carries U32) (rest VCtrl)))

  (fn ctrl_at ((c VCtrl) (depth U32)) (Option VCtrl)
    (match c
      ((VNoCtrl) (None))
      ((VCtrl t h a rest) (if (<= depth (u32.of 0)) (Some c) (ctrl_at rest (- depth (u32.of 1)))))))

  (fn with_h ((st VSt) (h U32)) VSt (make VSt (h h) (next (get st next)) (dead false)))

  (fn walked ((code Bytes) (st VSt) (h U32)) VWalked
    (make VWalked (items (raw code)) (st (with_h st h))))

  (fn nothing ((st VSt)) VWalked (make VWalked (items (VNoItems)) (st st)))

  (fn walked_join ((a VWalked) (b VWalked)) VWalked
    (make VWalked (items (items_join (get a items) (get b items))) (st (get b st))))

  (fn binary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat4 (popp (r2) (r3)) (popp (r0) (r1)) work (pushp (r0) (r1))))

  (fn unary_code ((work Bytes)) Bytes
    (uses Alloc)
    (cat3 (popp (r0) (r1)) work (pushp (r0) (r1))))

