; What a module declares, collected once, and what each declared name means.
;
; compiler/typecheck.wtn reads a type out of source. This is the piece after it, and the
; piece before any expression can be checked: a checker that meets `(add 1 2)` has to
; know what `add` is, and nothing so far does. So this pass walks a module's
; declarations and writes down what each of them says -- a function's parameter and
; result types, an enum's variants and their field types, a newtype's wrapped type --
; and then answers lookups by name.
;
; Every type it records is read by `type_of`, which comes in by hash and brings the
; kernel's `Ty` with it. That is what the import is for, rather than a copy: the type
; this pass writes down for `add` is the same value the kernel's rules are stated about,
; so there is one notion of a type in the project rather than several that drift. The
; tree, and the small readers over it, come in from compiler/parse.wtn the same way.
;
; It does not look at a body, and it reads no clause between a signature and its body.
; Checking an expression is the next piece and needs this one, so an environment that
; waited for it could not be written first; and what a declaration means to a caller is
; its signature, which is exactly what stands in front of those clauses.
;
;   witness run compiler/env.wtn --grant Alloc,Console
(module env
  (use "wtn:86a99f8451d3c7998900c44d4eac8671aac7a339305b840140e9696becd82774" as Tree)

  (use "wtn:4518c8219b4cc1aa6d0d1c0e4490160bbddfdf49348a92c47e1f9de9e69fb47e" as parse)

  (use "wtn:37b77793359240afd68298a030a33b6f0d6fc0868bd10d00420a1edfb8d92d26" as tokens_of)

  (use "wtn:899e21eb94eb82caaa0d2a3ac52dccd80eb8c4e238c6aa55cd5b7c73f92faad1" as type_of)

  ; The one-line readers the parser already has for taking a form apart. Asking for them
  ; by hash is cheaper than writing them again, and it keeps one answer to "is this leaf
  ; the word `fn`" in the codebase rather than two that could come to disagree.
  (use "wtn:0ac194f57800427d350e6b879c492d927ef50886c557823c0c5cfe1981329b01" as leaf_text)

  (use "wtn:51ca6ecd82025968aecc39ecfd111bccc8f5a3500e43cf0488a54d017947ed8e" as node_items)

  (use "wtn:b74a1973df7919505307399950487f6de6ccf432871b362157e7698205a90710" as is_word)

  ; Showing a type is the checker's own, and so is `plain`, which builds an unlabelled
  ; one with no arguments and comes in along with `type_of`. A proposition below asks
  ; whether a collected result type is the one `plain "Int"` builds, which is a question
  ; about the kernel's representation rather than about this module's rendering of it.
  (use "wtn:af1e918412dddc13cfa2e8020e1c36c71b7fdc47c9df423fd0693bccd2af9575" as shown_ty)

  (use "wtn:af8ea96cfe3210caeb244955a5e80a1cc194a4f59549fa5e350633b183cd879d" as tys_shown)

  ; --- what a declaration says ----------------------------------------------
  ; A signature is what a caller needs and nothing else: the parameters' types in order,
  ; and the type that comes back. The parameters' *names* are not here, because a call is
  ; positional, so a name would be a fact about the definition that no use of it can
  ; observe.
  ;
  ; `type_params` and `label_param` are the other half of a generic function's name, and
  ; they are not decoration. `type_of` writes down what was *written*, so the `T` in
  ; `(fn (unwrap_or T) ((o (Option T)) ...)` arrives as a type named `T` exactly as
  ; `Int` would; only these two fields say that it is a parameter and therefore rigid
  ; rather than a type nobody declared. A signature that dropped them would be a
  ; signature that could not be checked against. The field order is kernel/core.wtn's
  ; `FnDecl`, so that the two line up for a reader comparing them.
  (record FnSignature
    (name Str)
    (params Tys)
    (ret Ty)
    (type_params Names)
    (label_param Str)
    (effects Names))

  (enum FnSignatures (NoFnSignatures) (FnSignatures (head FnSignature) (rest FnSignatures)))

  ; A variant's fields are kept as types in declaration order, which is the order a
  ; `match` arm's binders come in, so this is what an arm will be checked against.
  (record VariantSignature (name Str) (fields Tys))

  (enum VariantSignatures
    (NoVariantSignatures)
    (VariantSignatures (head VariantSignature) (rest VariantSignatures)))

  ; `params` are the type parameters of a generic enum -- the `T` of `(Option T)` -- and
  ; empty for an ordinary one. They are collected because a variant's field type may name
  ; one, and the field types cannot be read without knowing which names stand for a
  ; parameter rather than for a type.
  (record EnumSignature (name Str) (params Names) (variants VariantSignatures))

  (enum EnumSignatures
    (NoEnumSignatures)
    (EnumSignatures (head EnumSignature) (rest EnumSignatures)))

  (record NewtypeSignature (name Str) (inner Ty))

  (enum NewtypeSignatures
    (NoNewtypeSignatures)
    (NewtypeSignatures (head NewtypeSignature) (rest NewtypeSignatures)))

  ; A record's fields, in declaration order, which is also the order `make` must write
  ; them in. Unlike a parameter, a field keeps its name: `get` and `make` are about it.
  (enum RecordFields (NoRecordFields) (RecordFields (name Str) (ty Ty) (rest RecordFields)))

  ; `wired` when it declares a wire schema, so a copy of it can cross to memory of its own.
  (record RecordSignature (name Str) (fields RecordFields) (wired Bool))

  (enum RecordSignatures
    (NoRecordSignatures)
    (RecordSignatures (head RecordSignature) (rest RecordSignatures)))

  ; A patch is named for the record it partially updates; what its fields are is that
  ; record's, each wrapped in an `Option`. It is kept as a name and a target, and read
  ; against the records when it is used, since a patch may be declared before its record.
  (record PatchSignature (name Str) (target Str))

  (enum PatchSignatures
    (NoPatchSignatures)
    (PatchSignatures (head PatchSignature) (rest PatchSignatures)))

  ; A channel carries one named payload type, and the labels its receiver is allowed to
  ; handle. A model has an input type, an output type, and the labels of what it was
  ; trained on, which come back out on everything it answers.
  (record ChannelSignature (name Str) (payload Str) (admits Names))

  (enum ChannelSignatures
    (NoChannelSignatures)
    (ChannelSignatures (head ChannelSignature) (rest ChannelSignatures)))

  (record ModelSignature (name Str) (input Ty) (output Ty) (trained Names) (device Str))

  (enum ModelSignatures
    (NoModelSignatures)
    (ModelSignatures (head ModelSignature) (rest ModelSignatures)))

  ; The environment is four association lists rather than one rather than one, because the language has
  ; two namespaces and a lookup always knows which kind of thing it is asking after: a
  ; checker looking at `(add 1 2)` wants a function, and one looking at `(Option Int)`
  ; wants a type. There is no map in the language, so a lookup walks a list -- which is
  ; the other reason there are three, since a walk should not pass over the kinds nobody
  ; asked about.
  (record Env
    (fns FnSignatures)
    (enums EnumSignatures)
    (newtypes NewtypeSignatures)
    (records RecordSignatures)
    (patches PatchSignatures)
    (redactions Names)
    (foreigns Names)
    (channels ChannelSignatures)
    (models ModelSignatures))

  (fn empty_env () Env
    (make Env
      (fns (NoFnSignatures))
      (enums (NoEnumSignatures))
      (newtypes (NoNewtypeSignatures))
      (records (NoRecordSignatures))
      (patches (NoPatchSignatures))
      (redactions (NoNames))
      (foreigns (NoNames))
      (channels (NoChannelSignatures))
      (models (NoModelSignatures))))

  ; --- lookup ---------------------------------------------------------------
  ; Each of the three answers `(Option ...)`, so a name that was never declared is a
  ; value the caller has to handle rather than a failure. Every walk is structural on its
  ; list, so none of them needs a budget.
  (fn signature_of ((e Env) (which Str)) (Option FnSignature) (fn_at (get e fns) which))

  (fn fn_at ((fs FnSignatures) (which Str)) (Option FnSignature)
    (match fs
      ((NoFnSignatures) (None))
      ((FnSignatures h rest) (if (str.eq which (get h name)) (Some h) (fn_at rest which)))))

  (fn enum_of ((e Env) (which Str)) (Option EnumSignature) (enum_at (get e enums) which))

  (fn enum_at ((es EnumSignatures) (which Str)) (Option EnumSignature)
    (match es
      ((NoEnumSignatures) (None))
      ((EnumSignatures h rest) (if (str.eq which (get h name)) (Some h) (enum_at rest which)))))

  (fn newtype_of ((e Env) (which Str)) (Option NewtypeSignature)
    (newtype_at (get e newtypes) which))

  (fn newtype_at ((ns NewtypeSignatures) (which Str)) (Option NewtypeSignature)
    (match ns
      ((NoNewtypeSignatures) (None))
      ((NewtypeSignatures h rest) (if (str.eq which (get h name)) (Some h) (newtype_at rest which)))))

  (fn record_of ((e Env) (which Str)) (Option RecordSignature)
    (record_at (get e records) which))

  (fn record_at ((rs RecordSignatures) (which Str)) (Option RecordSignature)
    (match rs
      ((NoRecordSignatures) (None))
      ((RecordSignatures h rest) (if (str.eq which (get h name)) (Some h) (record_at rest which)))))

  (fn patch_of ((e Env) (which Str)) (Option PatchSignature)
    (patch_at (get e patches) which))

  (fn patch_at ((ps PatchSignatures) (which Str)) (Option PatchSignature)
    (match ps
      ((NoPatchSignatures) (None))
      ((PatchSignatures h rest) (if (str.eq which (get h name)) (Some h) (patch_at rest which)))))

  (fn channel_of ((e Env) (which Str)) (Option ChannelSignature)
    (channel_at (get e channels) which))

  (fn channel_at ((cs ChannelSignatures) (which Str)) (Option ChannelSignature)
    (match cs
      ((NoChannelSignatures) (None))
      ((ChannelSignatures h rest) (if (str.eq which (get h name)) (Some h) (channel_at rest which)))))

  (fn model_of ((e Env) (which Str)) (Option ModelSignature)
    (model_at (get e models) which))

  (fn model_at ((ms ModelSignatures) (which Str)) (Option ModelSignature)
    (match ms
      ((NoModelSignatures) (None))
      ((ModelSignatures h rest) (if (str.eq which (get h name)) (Some h) (model_at rest which)))))

  (fn field_at ((fs RecordFields) (which Str)) (Option Ty)
    (match fs
      ((NoRecordFields) (None))
      ((RecordFields n ty rest) (if (str.eq which n) (Some ty) (field_at rest which)))))

  ; A variant is looked up inside its enum, because that is where its name means
  ; something: two enums may each have a variant nobody would confuse.
  (fn variant_of ((d EnumSignature) (which Str)) (Option VariantSignature)
    (variant_at (get d variants) which))

  (fn variant_at ((vs VariantSignatures) (which Str)) (Option VariantSignature)
    (match vs
      ((NoVariantSignatures) (None))
      ((VariantSignatures h rest) (if (str.eq which (get h name)) (Some h) (variant_at rest which)))))

  ; Whether a lookup found anything, for the one question that does not care what. It is
  ; generic because the three lookups answer three types and the question is one.
  (fn (present T) ((o (Option T))) Bool (match o ((None) false) ((Some v) true)))

  ; --- adding one, and refusing a second -------------------------------------
  ; A name declared twice is a refusal rather than a shadowing, and the `Fault` says
  ; which name it was: a message that only says "duplicate" leaves the reader to find it.
  (fn duplicate ((which Str)) Fault
    (uses Alloc)
    (fault "env" (concat "two declarations are named " which)))

  (fn with_fn ((e Env) (s FnSignature)) (Result Env Fault)
    (uses Alloc)
    (if (present (signature_of e (get s name)))
      (Err (duplicate (get s name)))
      (Ok (with e (fns (FnSignatures s (get e fns)))))))

  ; An enum and a newtype are both types, so one name cannot be both. That is why the
  ; check here looks in two lists where the function one looks in one: the namespaces are
  ; the language's, not this record's.
  (fn type_taken ((e Env) (which Str)) Bool
    (or (or (or (present (enum_of e which)) (present (newtype_of e which))) (present (record_of e which)))
      (present (patch_of e which))))

  (fn with_enum ((e Env) (d EnumSignature)) (Result Env Fault)
    (uses Alloc)
    (if (type_taken e (get d name))
      (Err (duplicate (get d name)))
      (Ok (with e (enums (EnumSignatures d (get e enums)))))))

  (fn with_newtype ((e Env) (d NewtypeSignature)) (Result Env Fault)
    (uses Alloc)
    (if (type_taken e (get d name))
      (Err (duplicate (get d name)))
      (Ok (with e (newtypes (NewtypeSignatures d (get e newtypes)))))))

  (fn with_record ((e Env) (d RecordSignature)) (Result Env Fault)
    (uses Alloc)
    (if (type_taken e (get d name))
      (Err (duplicate (get d name)))
      (Ok (with e (records (RecordSignatures d (get e records)))))))

  ; --- reading the parts of a form -------------------------------------------
  ; A parameter and a field are written the same way -- a name and a type in a list --
  ; and a signature wants only the type, so one reader serves both.
  (fn field_type ((t Tree)) (Result Ty Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Err (fault "env" "a parameter or field is a name and a type in a list")))
      ((Some items) (match items ((NoTrees) (Err (fault "env" "an empty list is not a parameter or field"))) ((Trees h more) (match more ((NoTrees) (Err (fault "env" "a parameter or field needs a type after its name"))) ((Trees written rest) (match rest ((NoTrees) (type_of written)) ((Trees extra others) (Err (fault "env" "a parameter or field is one name and one type")))))))))))

  (fn field_types ((ts Trees)) (Result Tys Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoTys)))
      ((Trees h more) (match (field_type h) ((Err f) (Err f)) ((Ok one) (match (field_types more) ((Err f) (Err f)) ((Ok others) (Ok (Tys one others)))))))))

  ; A type parameter, like `T`, is a word and nothing else; one written as a list would be
  ; the bounded parameter the language does not have.
  (fn param_names ((ts Trees)) (Result Names Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoNames)))
      ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a type parameter is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match (param_names more) ((Err f) (Err f)) ((Ok others) (Ok (Names which others)))))))))))

  ; --- a fn's name -----------------------------------------------------------
  ; Everything a fn's name says, before the parameter list is read. It is a record of its
  ; own rather than a half-built `FnSignature`, because the two fields a signature still
  ; wants have no honest empty value: an empty list of parameters is a real list, but a
  ; result type with no name is nothing a later pass could tell from a mistake.
  (record FnName (name Str) (type_params Names) (label_param Str))

  (fn simple_name ((which Str)) FnName
    (make FnName (name which) (type_params (NoNames)) (label_param "")))

  ; A fn's name is a word, or a list whose first word is the name and whose rest are its
  ; type parameters followed, at most once and written last, by `(label L)`.
  (fn fn_head ((t Tree)) (Result FnName Fault)
    (uses Alloc)
    (match t
      ((Leaf text quoted) (match (named text) ((Err f) (Err f)) ((Ok which) (Ok (simple_name which)))))
      ((Node items) (match items ((NoTrees) (Err (fault "env" "an empty list is not a fn's name"))) ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a fn's name begins with the name itself, which is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (fn_name_parts which more))))))))))

  ; The walk is structural on what is left of the name, so the label parameter is read by
  ; noticing that the list has run out after it: a word is a type parameter, and a list
  ; is the label parameter, which is why anything after one is refused here rather than
  ; silently accepted in the wrong place.
  (fn fn_name_parts ((which Str) (ts Trees)) (Result FnName Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (simple_name which)))
      ((Trees h more) (match (leaf_text h) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok one) (match (fn_name_parts which more) ((Err f) (Err f)) ((Ok rest) (Ok (with rest (type_params (Names one (get rest type_params)))))))))) ((None) (match more ((Trees extra others) (Err (fault "env" "a label parameter is written last in a fn's name"))) ((NoTrees) (match (label_named h) ((Err f) (Err f)) ((Ok one) (Ok (with (simple_name which) (label_param one))))))))))))

  (fn label_named ((t Tree)) (Result Str Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Err (fault "env" "a label parameter is a list")))
      ((Some items) (match items ((NoTrees) (Err (fault "env" "an empty list is not a label parameter"))) ((Trees h more) (if (is_word h "label") (label_itself more) (Err (fault "env" "the only list in a fn's name is its label parameter"))))))))

  (fn label_itself ((after Trees)) (Result Str Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a label parameter needs a label")))
      ((Trees h more) (match more ((Trees extra others) (Err (fault "env" "a fn takes one label parameter"))) ((NoTrees) (match (leaf_text h) ((None) (Err (fault "env" "a label is a word"))) ((Some text) (named text))))))))

  ; --- a fn's signature ------------------------------------------------------
  ; `after` is what follows the word `fn`: a name, a parameter list, a result type, then
  ; the clauses and body this pass walks past. Each step reports the part that was
  ; missing, which is the shape compiler/parse.wtn's `fn_shape` reads a whole definition
  ; in. That one insists on exactly one expression after the result type, so it turns
  ; away every real `fn` carrying a `(uses ...)` clause, and the signature is read here
  ; rather than through it.
  (fn fn_signature_of ((after Trees)) (Result FnSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a fn needs a name")))
      ((Trees h more) (match (fn_head h) ((Err f) (Err f)) ((Ok head) (fn_parameters head more))))))

  (fn fn_parameters ((head FnName) (after Trees)) (Result FnSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a fn needs a parameter list, written () when it has none")))
      ((Trees h more) (match (node_items h) ((None) (Err (fault "env" "a fn's parameters are a list"))) ((Some ps) (match (field_types ps) ((Err f) (Err f)) ((Ok tys) (fn_result head tys more))))))))

  ; What `more` holds here is the clauses and the body, and nothing reads them: a
  ; signature is what a call is checked against, and a call can see neither.
  (fn fn_result ((head FnName) (tys Tys) (after Trees)) (Result FnSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a fn needs a result type")))
      ((Trees h more) (match (type_of h) ((Err f) (Err f)) ((Ok gives) (Ok (make FnSignature (name (get head name)) (params tys) (ret gives) (type_params (get head type_params)) (label_param (get head label_param)) (effects (uses_in more)))))))))

  ; The effects a function or foreign declaration states in its `(uses ...)` clause. The
  ; body is among what is scanned, which is harmless: no expression is written `(uses ...)`.
  (fn uses_in ((ts Trees)) Names
    (uses Alloc)
    (match ts
      ((NoTrees) (NoNames))
      ((Trees h more) (match (node_items h) ((None) (uses_in more)) ((Some items) (match items ((NoTrees) (uses_in more)) ((Trees head words) (if (is_word head "uses") (match (label_words words) ((Err f) (uses_in more)) ((Ok names) (names_union names (uses_in more)))) (uses_in more)))))))))

  ; --- an enum's signature ---------------------------------------------------
  ; The name is a word for an ordinary enum and a list for a generic one, where the first
  ; word is the name and the rest are its type parameters.
  (fn enum_head ((t Tree)) (Result EnumSignature Fault)
    (uses Alloc)
    (match t
      ((Leaf text quoted) (match (named text) ((Err f) (Err f)) ((Ok which) (Ok (make EnumSignature (name which) (params (NoNames)) (variants (NoVariantSignatures)))))))
      ((Node items) (match items ((NoTrees) (Err (fault "env" "an empty list is not an enum's name"))) ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a generic enum's name is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match (param_names more) ((Err f) (Err f)) ((Ok ps) (Ok (make EnumSignature (name which) (params ps) (variants (NoVariantSignatures)))))))))))))))

  (fn variant_signature_of ((t Tree)) (Result VariantSignature Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Err (fault "env" "a variant is a list, written (Name) when it has no fields")))
      ((Some items) (match items ((NoTrees) (Err (fault "env" "an empty list is not a variant"))) ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a variant's name is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match (field_types more) ((Err f) (Err f)) ((Ok tys) (Ok (make VariantSignature (name which) (fields tys))))))))))))))

  (fn variant_signatures_of ((ts Trees)) (Result VariantSignatures Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoVariantSignatures)))
      ((Trees h more) (match (variant_signature_of h) ((Err f) (Err f)) ((Ok one) (match (variant_signatures_of more) ((Err f) (Err f)) ((Ok others) (Ok (VariantSignatures one others)))))))))

  (fn enum_signature_of ((after Trees)) (Result EnumSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "an enum needs a name")))
      ((Trees h more) (match (enum_head h) ((Err f) (Err f)) ((Ok d) (match (variant_signatures_of more) ((Err f) (Err f)) ((Ok vs) (Ok (with d (variants vs))))))))))

  ; --- a newtype's signature -------------------------------------------------
  ; A refinement -- the `(requires ...)` a newtype may carry -- follows the wrapped type
  ; and is not read here. It is an obligation on whoever builds one, so it belongs to the
  ; pass that checks an expression rather than to what a name means.
  (fn newtype_signature_of ((after Trees)) (Result NewtypeSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a newtype needs a name")))
      ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a newtype's name is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (newtype_wraps which more))))))))

  (fn newtype_wraps ((which Str) (after Trees)) (Result NewtypeSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a newtype needs a type to wrap")))
      ((Trees h more) (match (type_of h) ((Err f) (Err f)) ((Ok wrapped) (Ok (make NewtypeSignature (name which) (inner wrapped))))))))

  ; --- a record's signature --------------------------------------------------
  ; `(record Name [(schema Name Version)] (field Type)...)`. The schema clause is about
  ; the wire form and says nothing about what a field is, so it is stepped over, and only
  ; whether there is one is kept.
  (fn record_signature_of ((after Trees)) (Result RecordSignature Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a record needs a name")))
      ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a record's name is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match (record_fields_of (past_schema more)) ((Err f) (Err f)) ((Ok fields) (Ok (make RecordSignature (name which) (fields fields) (wired (has_schema more)))))))))))))

  (fn has_schema ((ts Trees)) Bool
    (uses Alloc)
    (match ts
      ((NoTrees) false)
      ((Trees h more) (match (node_items h) ((None) false) ((Some items) (match items ((NoTrees) false) ((Trees head rest) (is_word head "schema"))))))))

  (fn past_schema ((ts Trees)) Trees
    (uses Alloc)
    (match ts
      ((NoTrees) ts)
      ((Trees h more) (match (node_items h) ((None) ts) ((Some items) (match items ((NoTrees) ts) ((Trees head rest) (if (is_word head "schema") more ts))))))))

  (fn record_fields_of ((ts Trees)) (Result RecordFields Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoRecordFields)))
      ((Trees h more) (match (record_field h) ((Err f) (Err f)) ((Ok one) (match (record_fields_of more) ((Err f) (Err f)) ((Ok others) (Ok (with_field one others)))))))))

  (fn with_field ((one RecordFields) (others RecordFields)) RecordFields
    (match one
      ((NoRecordFields) others)
      ((RecordFields n ty none) (RecordFields n ty others))))

  ; One field, as a `RecordFields` of length one, so the walk above has one outcome type.
  (fn record_field ((t Tree)) (Result RecordFields Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Err (fault "env" "a field is a name and a type in a list")))
      ((Some items) (match items ((NoTrees) (Err (fault "env" "an empty list is not a field"))) ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a field's name is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match more ((NoTrees) (Err (fault "env" "a field needs a type after its name"))) ((Trees written rest) (match rest ((Trees extra others) (Err (fault "env" "a field is one name and one type"))) ((NoTrees) (match (type_of written) ((Err f) (Err f)) ((Ok ty) (Ok (RecordFields which ty (NoRecordFields))))))))))))))))))

  ; --- the walk over a module ------------------------------------------------
  ; One declaration. A form whose first word is not one of the three is left alone rather
  ; than refused: a module also holds `(use ...)` lines, records, tests and its own name,
  ; and a pass that turned those away could not be run on any real module. Records are
  ; the obvious next thing to collect here, and they wait for the same reason expression
  ; checking does -- what a record declaration is for is checking `make` and `get`, which
  ; is the piece after this one.
  (fn one_decl ((t Tree) (e Env)) (Result Env Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Ok e))
      ((Some items) (match items ((NoTrees) (Ok e)) ((Trees h after) (if (is_word h "fn") (added_fn e after) (if (is_word h "enum") (added_enum e after) (if (is_word h "newtype") (added_newtype e after) (if (is_word h "record") (added_record e after) (if (is_word h "patch") (added_patch e after) (if (is_word h "redact") (added_redaction e after) (if (is_word h "foreign") (added_foreign e after) (if (is_word h "channel") (added_channel e after) (if (is_word h "model") (added_model e after) (Ok e)))))))))))))))

  (fn added_fn ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match (fn_signature_of after) ((Err f) (Err f)) ((Ok s) (with_fn e s))))

  (fn added_enum ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match (enum_signature_of after) ((Err f) (Err f)) ((Ok d) (with_enum e d))))

  (fn added_newtype ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match (newtype_signature_of after) ((Err f) (Err f)) ((Ok d) (with_newtype e d))))

  ; A foreign function is called like any other, but what it answers is unverified, so
  ; its name is remembered as well as its signature.
  (fn added_foreign ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match (fn_signature_of after)
      ((Err f) (Err f))
      ((Ok s) (match (with_fn e s) ((Err f) (Err f)) ((Ok next) (Ok (with next (foreigns (Names (get s name) (get next foreigns))))))))))

  ; `(channel Name Payload [(accepts Label...)])`.
  (fn added_channel ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a channel needs a name and a payload")))
      ((Trees n more) (match (leaf_text n) ((None) (Err (fault "env" "a channel's name is a word"))) ((Some ntext) (match more ((NoTrees) (Err (fault "env" "a channel needs a name and a payload"))) ((Trees payload rest) (match (leaf_text payload) ((None) (Err (fault "env" "a channel's payload is a type name"))) ((Some ptext) (match (named ntext) ((Err f) (Err f)) ((Ok cname) (match (named ptext) ((Err f) (Err f)) ((Ok pname) (match (accepted rest) ((Err f) (Err f)) ((Ok labels) (if (present (channel_of e cname)) (Err (duplicate cname)) (Ok (with e (channels (ChannelSignatures (make ChannelSignature (name cname) (payload pname) (admits labels)) (get e channels)))))))))))))))))))))

  ; The labels a channel's receiver handles: none, or those of an `(accepts ...)` clause.
  (fn accepted ((rest Trees)) (Result Names Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Ok (NoNames)))
      ((Trees clause none) (match (clause_args clause) ((Err f) (Err f)) ((Ok args) (label_words args))))))

  ; What follows the head of a clause such as `(accepts A B)`.
  (fn clause_args ((t Tree)) (Result Trees Fault)
    (match t
      ((Leaf text quoted) (Err (fault "env" "a clause is a list")))
      ((Node items) (match items ((NoTrees) (Err (fault "env" "a clause is not empty"))) ((Trees head args) (Ok args))))))

  (fn label_words ((ts Trees)) (Result Names Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoNames)))
      ((Trees h more) (match (leaf_text h) ((None) (Err (fault "env" "a label is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (match (label_words more) ((Err f) (Err f)) ((Ok others) (Ok (Names which others)))))))))))

  ; `(model Name (input T) (output T) (trained-on Label...) (device d) (weights w))`.
  (fn added_model ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a model needs a name")))
      ((Trees n clauses) (match (leaf_text n) ((None) (Err (fault "env" "a model's name is a word"))) ((Some ntext) (match (named ntext) ((Err f) (Err f)) ((Ok mname) (model_clauses e mname clauses))))))))

  (fn model_clauses ((e Env) (mname Str) (clauses Trees)) (Result Env Fault)
    (uses Alloc)
    (match clauses
      ((NoTrees) (Err (fault "env" "a model needs its input and output")))
      ((Trees input more) (match more ((NoTrees) (Err (fault "env" "a model needs its input and output"))) ((Trees output rest) (match rest ((NoTrees) (Err (fault "env" "a model needs its training labels"))) ((Trees trained others) (match (clause_type input) ((Err f) (Err f)) ((Ok in) (match (clause_type output) ((Err f) (Err f)) ((Ok out) (match (clause_args trained) ((Err f) (Err f)) ((Ok words) (match (label_words words) ((Err f) (Err f)) ((Ok labels) (if (present (model_of e mname)) (Err (duplicate mname)) (Ok (with e (models (ModelSignatures (make ModelSignature (name mname) (input in) (output out) (trained labels) (device (device_of others))) (get e models)))))))))))))))))))))

  ; `(device cpu)`, the clause after the training labels; "cpu" if it is not there.
  (fn device_of ((clauses Trees)) Str
    (uses Alloc)
    (match clauses
      ((NoTrees) "cpu")
      ((Trees clause more) (match (clause_args clause) ((Err f) "cpu") ((Ok args) (match args ((NoTrees) "cpu") ((Trees d none) (match (leaf_text d) ((None) "cpu") ((Some text) (match (named text) ((Err f) "cpu") ((Ok word) word)))))))))))

  ; `(input T)`: the one type a clause holds.
  (fn clause_type ((t Tree)) (Result Ty Fault)
    (uses Alloc)
    (match (clause_args t)
      ((Err f) (Err f))
      ((Ok args) (match args ((NoTrees) (Err (fault "env" "a clause needs a type"))) ((Trees written more) (type_of written))))))

  ; `(patch Name Record)`.
  (fn added_patch ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a patch needs a name and a record")))
      ((Trees n more) (match (leaf_text n) ((None) (Err (fault "env" "a patch's name is a word"))) ((Some ntext) (match more ((NoTrees) (Err (fault "env" "a patch needs a name and a record"))) ((Trees r none) (match (leaf_text r) ((None) (Err (fault "env" "a patch updates a record, named by a word"))) ((Some rtext) (match (named ntext) ((Err f) (Err f)) ((Ok pname) (match (named rtext) ((Err f) (Err f)) ((Ok target) (if (type_taken e pname) (Err (duplicate pname)) (Ok (with e (patches (PatchSignatures (make PatchSignature (name pname) (target target)) (get e patches)))))))))))))))))))

  ; `(redact Label policy)`: only the label matters here, since a field that carries it
  ; may be logged.
  (fn added_redaction ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a redact needs a label and a policy")))
      ((Trees l more) (match (leaf_text l) ((None) (Err (fault "env" "a redacted label is a word"))) ((Some text) (match (named text) ((Err f) (Err f)) ((Ok which) (Ok (with e (redactions (Names which (get e redactions))))))))))))

  (fn added_record ((e Env) (after Trees)) (Result Env Fault)
    (uses Alloc)
    (match (record_signature_of after) ((Err f) (Err f)) ((Ok d) (with_record e d))))

  ; Every declaration. The walk is structural on the list of items, so it needs no
  ; budget. It builds the tail of the environment before adding the head, which is what
  ; puts the first declaration first in a list that can only be built by prefixing --
  ; and the duplicate check each declaration makes therefore looks at the declarations
  ; *after* it. That is all it needs: a name written twice is one the earlier of the two
  ; finds, and order is not part of what an environment says anyway, since a module's
  ; declarations may be written in any order.
  (fn collected ((items Trees) (e Env)) (Result Env Fault)
    (uses Alloc)
    (match items
      ((NoTrees) (Ok e))
      ((Trees h more) (match (collected more e) ((Err f) (Err f)) ((Ok rest) (one_decl h rest))))))

  (fn env_of ((t Tree)) (Result Env Fault)
    (uses Alloc)
    (match (node_items t)
      ((None) (Err (fault "env" "a module is a form, not a word")))
      ((Some items) (match items ((NoTrees) (Err (fault "env" "an empty form is not a module"))) ((Trees h after) (if (is_word h "module") (module_named after) (Err (fault "env" "the form does not begin with module"))))))))

  ; The module's own name is read past rather than kept: a module does not export, so
  ; nothing outside looks a declaration up through it.
  (fn module_named ((after Trees)) (Result Env Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "env" "a module needs a name")))
      ((Trees h more) (collected more (empty_env)))))

  (fn env_of_source ((src Str)) (Result Env Fault)
    (uses Alloc)
    (match (parse (tokens_of (str.encode src))) ((Err f) (Err f)) ((Ok t) (env_of t))))

  ; --- showing what was found ------------------------------------------------
  ; A generic function's name is shown the way the language writes it -- `(unwrap_or T)`
  ; -- because the alternative is a rendering in which a type parameter and a type
  ; nobody declared look alike, and telling those two apart is the whole reason the
  ; signature keeps them.
  (fn names_shown ((ns Names)) Str
    (uses Alloc)
    (match ns ((NoNames) "") ((Names h rest) (concat (concat " " h) (names_shown rest)))))

  (fn label_param_shown ((l Str)) Str
    (uses Alloc)
    (if (str.eq "" l) "" (concat " (label " (concat l ")"))))

  (fn name_shown ((s FnSignature)) Str
    (uses Alloc)
    (match (get s type_params)
      ((NoNames) (if (str.eq "" (get s label_param)) (get s name) (written_name s)))
      ((Names h rest) (written_name s))))

  (fn written_name ((s FnSignature)) Str
    (uses Alloc)
    (concat "("
      (concat (get s name)
        (concat (names_shown (get s type_params))
          (concat (label_param_shown (get s label_param)) ")")))))

  (fn signature_shown ((s FnSignature)) Str
    (uses Alloc)
    (concat (name_shown s)
      (concat " :"
        (concat (tys_shown (get s params)) (concat " -> " (shown_ty (get s ret)))))))

  (fn fns_shown ((fs FnSignatures)) Str
    (uses Alloc)
    (match fs
      ((NoFnSignatures) "")
      ((FnSignatures h rest) (concat (concat "\n  " (signature_shown h)) (fns_shown rest)))))

  (fn variants_shown ((vs VariantSignatures)) Str
    (uses Alloc)
    (match vs
      ((NoVariantSignatures) "")
      ((VariantSignatures h rest) (concat (concat " " (concat (get h name) (tys_shown (get h fields)))) (variants_shown rest)))))

  (fn enums_shown ((es EnumSignatures)) Str
    (uses Alloc)
    (match es
      ((NoEnumSignatures) "")
      ((EnumSignatures h rest) (concat (concat "\n  " (concat (get h name) (concat " has" (variants_shown (get h variants))))) (enums_shown rest)))))

  (fn newtypes_shown ((ns NewtypeSignatures)) Str
    (uses Alloc)
    (match ns
      ((NoNewtypeSignatures) "")
      ((NewtypeSignatures h rest) (concat (concat "\n  " (concat (get h name) (concat " wraps " (shown_ty (get h inner))))) (newtypes_shown rest)))))

  (fn env_shown ((e Env)) Str
    (uses Alloc)
    (concat (concat "fns:" (fns_shown (get e fns)))
      (concat (concat "\nenums:" (enums_shown (get e enums)))
        (concat "\nnewtypes:" (newtypes_shown (get e newtypes))))))

  ; One lookup, shown. Each of these takes an environment rather than source text, and
  ; the `*_line` function under it is the one-shot version: collect, then ask. Reading a
  ; module is far the expensive half -- the parser spends a step of budget per token --
  ; so anything asking more than one question should collect once and ask here.
  (fn signature_in ((e Env) (which Str)) Str
    (uses Alloc)
    (match (signature_of e which)
      ((None) (concat "not declared: " which))
      ((Some s) (signature_shown s))))

  (fn enum_in ((e Env) (which Str)) Str
    (uses Alloc)
    (match (enum_of e which)
      ((None) (concat "not declared: " which))
      ((Some d) (concat (get d name) (concat " has" (variants_shown (get d variants)))))))

  (fn newtype_in ((e Env) (which Str)) Str
    (uses Alloc)
    (match (newtype_of e which)
      ((None) (concat "not declared: " which))
      ((Some d) (shown_ty (get d inner)))))

  (fn variant_in ((e Env) (which Str) (branch Str)) Str
    (uses Alloc)
    (match (enum_of e which)
      ((None) (concat "not declared: " which))
      ((Some d) (match (variant_of d branch) ((None) (concat "no such variant: " branch)) ((Some v) (concat (get v name) (tys_shown (get v fields))))))))

  (fn env_line ((src Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (env_shown e))))

  (fn signature_line ((src Str) (which Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (signature_in e which))))

  ; The collected names alone, in declaration order and separated by a space. What this
  ; pass holds is a claim about a module, and another checker can be asked the same
  ; question about the same module, so it is worth having the answer in a form that
  ; lines up against one.
  ;
  ; Three collectors that differ only in the list they walk is what a language with no
  ; higher-order functions costs here. The join is written once, over `Names`, which is
  ; where the saving is.
  (fn fn_names ((fs FnSignatures)) Names
    (match fs
      ((NoFnSignatures) (NoNames))
      ((FnSignatures h rest) (Names (get h name) (fn_names rest)))))

  (fn enum_names ((es EnumSignatures)) Names
    (match es
      ((NoEnumSignatures) (NoNames))
      ((EnumSignatures h rest) (Names (get h name) (enum_names rest)))))

  (fn newtype_names ((ns NewtypeSignatures)) Names
    (match ns
      ((NoNewtypeSignatures) (NoNames))
      ((NewtypeSignatures h rest) (Names (get h name) (newtype_names rest)))))

  (fn joined ((ns Names)) Str
    (uses Alloc)
    (match ns
      ((NoNames) "")
      ((Names h rest) (match rest ((NoNames) h) ((Names next others) (concat h (concat " " (joined rest))))))))

  (fn names_line ((src Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (joined (fn_names (get e fns))))))

  (fn enum_names_line ((src Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (joined (enum_names (get e enums))))))

  (fn newtype_names_line ((src Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (joined (newtype_names (get e newtypes))))))

  ; All three at once: the functions, the enums and the newtypes, a line each, for one
  ; reading of the module instead of three.
  (fn declared_line ((src Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (concat (joined (fn_names (get e fns))) (concat "\n" (concat (joined (enum_names (get e enums))) (concat "\n" (joined (newtype_names (get e newtypes))))))))))

  (fn result_line ((src Str) (which Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (match (signature_of e which) ((None) (concat "not declared: " which)) ((Some s) (shown_ty (get s ret)))))))

  (fn enum_line ((src Str) (which Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (enum_in e which))))

  (fn newtype_line ((src Str) (which Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (newtype_in e which))))

  (fn fields_shown ((fs RecordFields)) Str
    (uses Alloc)
    (match fs
      ((NoRecordFields) "")
      ((RecordFields n ty rest) (concat (concat " " (concat n (concat ":" (shown_ty ty)))) (fields_shown rest)))))

  (fn record_line ((src Str) (which Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (match (record_of e which) ((None) (concat "not declared: " which)) ((Some d) (concat (get d name) (fields_shown (get d fields))))))))

  (fn variant_line ((src Str) (which Str) (branch Str)) Str
    (uses Alloc)
    (match (env_of_source src)
      ((Err f) (concat "refused: " (get f why)))
      ((Ok e) (variant_in e which branch))))

  ; --- what it says about itself ---------------------------------------------
  ; One sample module, read by every proposition below, so that each of them is about the
  ; same collection rather than about a source written to suit it.
  (fn sample () Str
    (uses Alloc)
    (concat "(module shapes (newtype Side Int)"
      (concat " (enum Shape (Square (side Side)) (Rect (w Int) (h Int)))"
        " (fn area ((s Shape)) Int (uses Alloc) (match s ((Square side) 1) ((Rect w h) 2))))")))

  (test "a fn is collected with its parameter and result types" (str.eq "area : Shape -> Int" (signature_line (sample) "area")))

  (test "a clause between the result type and the body is read past" (str.eq "area : Shape -> Int" (signature_line "(module m (fn area ((s Shape)) Int (uses Alloc) (bounds (depth 1)) 1))" "area")))

  (test "a name nobody declared is not found" (str.eq "not declared: perimeter" (signature_line (sample) "perimeter")))

  ; `plain` comes in with `type_of`: it is how the checker builds an unlabelled type with
  ; no arguments. So this asks whether what was collected for `area`'s result is the
  ; value the kernel would have built, and not merely text that reads the same.
  (test "the result type collected is the kernel's own Int" (str.eq (shown_ty (plain "Int")) (result_line (sample) "area")))

  (test "an enum is collected with its variants and their field types" (str.eq "Shape has Square Side Rect Int Int" (enum_line (sample) "Shape")))

  (test "a variant is looked up inside its enum" (str.eq "Rect Int Int" (variant_line (sample) "Shape" "Rect")))

  (test "a variant of another name is not a variant of this enum" (str.eq "no such variant: Round" (variant_line (sample) "Shape" "Round")))

  (test "a newtype is collected with what it wraps" (str.eq "Int" (newtype_line (sample) "Side")))

  (test "a generic enum keeps the parameters its fields name" (str.eq "Pair has MkPair A B" (enum_line "(module m (enum (Pair A B) (MkPair (first A) (second B))))" "Pair")))

  ; The type parameter and the result are both written `T`, and the signature is what
  ; says the first of those is a parameter: hence the name shown as the language writes
  ; it, rather than as a bare word that would hide the difference.
  (test "a generic fn keeps the type parameters its name declares" (str.eq "(unwrap_or T) : (Option T) T -> T" (signature_line "(module m (fn (unwrap_or T) ((o (Option T)) (fallback T)) T 1))" "unwrap_or")))

  (test "a label parameter is read, and it is written last" (str.eq "(prefix T (label L)) : T Str @L -> Str @L" (signature_line "(module m (fn (prefix T (label L)) ((a T) (b (label L Str))) (label L Str) b))" "prefix")))

  (test "a label parameter before a type parameter is refused" (str.eq "refused: a label parameter is written last in a fn's name" (env_line "(module m (fn (f (label L) T) ((a T)) T a))")))

  (test "names come back in the order they were declared" (str.eq "first second third" (names_line "(module m (fn first () Int 1) (fn second () Int 2) (fn third () Int 3))")))

  (test "types come back in the order they were declared" (str.eq "A B" (enum_names_line "(module m (enum A (X)) (newtype C Int) (enum B (Y)))")))

  (test "two declarations of one name are refused" (str.eq "refused: two declarations are named f" (env_line "(module m (fn f () Int 1) (fn f ((n Int)) Int n))")))

  (test "an enum and a newtype share one namespace" (str.eq "refused: two declarations are named T" (env_line "(module m (newtype T Int) (enum T (A)))")))

  (test "a fn and a type of one name do not collide" (str.eq "f : -> Int" (signature_line "(module m (newtype F Int) (fn f () Int 1))" "f")))

  (test "a form this pass does not read is left alone" (str.eq "fns:\nenums:\nnewtypes:" (env_line "(module m (record Site (code Str)) (test \"nothing\" true))")))

  (test "a fn with no result type is refused" (str.eq "refused: a fn needs a result type" (env_line "(module m (fn f ()))")))

  (fn main () Unit
    (uses Alloc Console)
    (seq
      (print (env_line (sample)))
      (print (signature_line (sample) "area"))
      (print (signature_line "(module m (fn (unwrap_or T) ((o (Option T)) (fallback T)) T fallback))" "unwrap_or"))
      (print (env_line "(module m (fn f () Int 1) (fn f () Int 2))")))))
