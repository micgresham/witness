    (cat (lw r (os) (i64.of 0)) (addi (os) (os) (i64.of 8))))

  (fn pushp ((lo U32) (hi U32)) Bytes
    (uses Alloc)
    (cat3 (sw lo (os) (i64.of -8)) (sw hi (os) (i64.of -4)) (addi (os) (os) (i64.of -8))))

  (fn popp ((lo U32) (hi U32)) Bytes
    (uses Alloc)
    (cat3 (lw lo (os) (i64.of 0)) (lw hi (os) (i64.of 4)) (addi (os) (os) (i64.of 8))))

  (fn peekp ((lo U32) (hi U32)) Bytes
