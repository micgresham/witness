    (cat (add_rr (tmp) base idx) (lbu dst (tmp) (i64.of 0))))

  (fn sbx ((src U32) (base U32) (idx U32)) Bytes
    (uses Alloc)
    (cat (add_rr (tmp) base idx) (sb src (tmp) (i64.of 0))))

  (fn add_big ((d U32) (n U32) (imm I64)) Bytes
