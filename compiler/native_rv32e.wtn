  ; RAM comes out of reset holding anything, and the runtime counts on memory it has not
  ; written reading as zero, as a wasm module's does: the free lists' table, for one, is
  ; allocated and never cleared. So the wasm memory and the operand stack are zeroed, a word
  ; at a time, before the data image is copied in.
  (fn cleared () Bytes
    (uses Alloc)
    (cat4 (mov_rr (r0) (mem)) (mov_imm (r2) (i64.of 73728))
      (cat (sw (zero) (r0) (i64.of 0)) (addi (r0) (r0) (i64.of 4)))
      (cat (addi (r2) (r2) (i64.of -1)) (bne (r2) (zero) (i64.of -12)))))

  (fn main_entry ((main_index U32)) VItems
    (uses Alloc)
    (items_join (item (VCallFn main_index)) (raw (exit_code (i64.of 0)))))

  (fn stub_items ((entry VItems) (image_at I64) (image_size I64) (heap I64) (pages I64)) VItems
    (uses Alloc)
    (items_join (raw (start_code image_at image_size heap pages)) entry))

  (fn elf_of ((m Module) (entry_name Str) (filter Bool)) (Result Bytes Fault)
    (uses Alloc)
    (match (index_of_func (get m funcs) entry_name (u32.of 0))
      ((None) (Err (fault "native" (concat "the program has no function named " entry_name))))
      ((Some index) (let shapes (shapes_of (get m funcs)) (let bodies (bodies_of (get m funcs) shapes (hostfns_of (get m imports))) (let heap (get m heap) (let image (image_of (get m segments) (zeros (narrow heap) (u32.of 40))) (let image_at (wrap.add (base_address) (i64.of 128)) (let entry (main_entry index) (let stub (stub_items entry image_at (i64.of (octets image)) heap (widen (get m pages))) (let stub_end (items_size stub) (let starts (starts_from bodies stub_end) (let code (joined (code_to stub (u32.of 0) (labels_of stub (u32.of 0)) starts (bodies_to bodies stub_end starts (VNoChunks)))) (let code_offset (wrap.add (i64.of 128) (i64.of (octets image))) (let total (wrap.add code_offset (i64.of (octets code))) (if (< (i64.of 131056) total) (Err (fault "native" (concat "the image is " (concat (num.to_str total) " bytes, more than the 131056 of RAM the RV32E board's layout has for code")))) (Ok (cat4 (elf_header (wrap.add (base_address) code_offset) total) (zeros (u32.of 44) (u32.of 8)) image code))))))))))))))))))

  (fn main () Unit
    (uses Console)
    (print "compiler/native_arm.wtn is exercised by tests/test_native_arm.py")))
