  (fn r1 () U32 (u32.of 11))

  (fn r2 () U32 (u32.of 12))

  (fn r3 () U32 (u32.of 13))

  (fn r4 () U32 (u32.of 14))

  (fn r5 () U32 (u32.of 15))

  (fn zero () U32 (u32.of 0))

  (fn sp () U32 (u32.of 2))

  (fn tmp () U32 (u32.of 5))

  (fn fp () U32 (u32.of 8))

  (fn mem () U32 (u32.of 4))

  (fn os () U32 (u32.of 3))

  (fn cat ((a Bytes) (b Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a b))

  (fn cat3 ((a Bytes) (b Bytes) (c Bytes)) Bytes
    (uses Alloc)
    (bytes.concat a (bytes.concat b c)))

  (fn cat4 ((a Bytes) (b Bytes) (c Bytes) (d Bytes)) Bytes
