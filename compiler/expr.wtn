    (uses Alloc)
    (match members
      ((NoTrees) (NoNames))
      ((Trees member more) (names_union (match member ((Leaf text quoted) (NoNames)) ((Node parts) (match parts ((NoTrees) (NoNames)) ((Trees name after) (effects_in_all decls after))))) (members_effects decls more)))))

  (fn device_effects ((decls Env) (m Tree)) Names
    (uses Alloc)
    (match m
      ((Node inner) (NoNames))
      ((Leaf text quoted) (match (named text) ((Err f) (NoNames)) ((Ok mname) (match (model_of decls mname) ((None) (NoNames)) ((Some known) (if (str.eq (get known device) "gpu") (Names "Gpu" (NoNames)) (if (str.eq (get known device) "npu") (Names "Npu" (NoNames)) (Names "Alloc" (NoNames)))))))))))

  ; What calling a name performs.
  (fn call_effects ((decls Env) (name Str)) Names
    (uses Alloc)
    (match (signature_of decls name)
      ((Some sig) (if (names_has (get decls foreigns) name) (names_union (Names "Foreign" (NoNames)) (get sig effects)) (get sig effects)))
      ((None) (match (primitive name) ((Some b) (get b effects)) ((None) (if (or (or (str.eq name "array.empty") (str.eq name "array.push")) (or (str.eq name "tensor.add") (str.eq name "tensor.matmul"))) (Names "Alloc" (NoNames)) (NoNames)))))))

  ; The first name in a `(uses ...)` that is not an effect.
  (fn first_unknown ((declared Names)) (Option Str)
    (match declared
      ((NoNames) (None))
      ((Names e more) (if (known_effect e) (first_unknown more) (Some e)))))

  (fn known_effect ((e Str)) Bool
    (or (or (or (str.eq e "Alloc") (str.eq e "Clock")) (or (str.eq e "Console") (str.eq e "Env")))
      (or (or (or (str.eq e "Foreign") (str.eq e "Gpu")) (or (str.eq e "Ipc") (str.eq e "Log")))
        (or (or (str.eq e "Net") (str.eq e "Nondet"))
          (or (str.eq e "Npu") (str.eq e "Store"))))))

  ; The first effect performed that is not declared, if any.
  (fn first_missing ((performed Names) (declared Names)) (Option Str)
    (match performed
      ((NoNames) (None))
      ((Names e more) (if (names_has declared e) (first_missing more declared) (Some e)))))

  ; --- a whole function ------------------------------------------------------
  ; `(fn name ((param Type)...) Ret clause... body)`: the parameters are the scope, and
  ; the body's type must fit the declared result. Clauses are not read here. A generic
  ; function is turned away by name, since its parameters are types not yet known.
  (fn check_fn ((decls Env) (t Tree)) (Result Unit Fault)
    (uses Alloc)
    (match t
      ((Leaf text quoted) (Err (fault "syntax" "a fn is a list")))
      ((Node items) (match items ((NoTrees) (Err (fault "syntax" "a fn is a list"))) ((Trees keyword rest) (match rest ((NoTrees) (Err (fault "syntax" "a fn needs a name"))) ((Trees name after) (match name ((Node generic) (match generic ((NoTrees) (Err (fault "syntax" "a fn needs a name"))) ((Trees first tparams) (match (type_params_of tparams) ((Err f) (Err f)) ((Ok names) (check_after decls names after)))))) ((Leaf ntext nquoted) (check_after decls (NoNames) after))))))))))

  (fn check_after ((decls Env) (tparams Names) (after Trees)) (Result Unit Fault)
    (uses Alloc)
    (match after
      ((NoTrees) (Err (fault "syntax" "a fn needs a parameter list")))
      ((Trees params more) (match more ((NoTrees) (Err (fault "syntax" "a fn needs a return type"))) ((Trees ret body) (check_body decls tparams params ret body))))))

  ; The type parameters in a generic fn's name. A label parameter, written last as
  ; `(label L)`, adds no type parameter: in the body `L` is a label like any other, which
  ; is what rigid means -- nothing in the body can name what it stands for, so a value
  ; carrying it cannot be returned without it.
  (fn type_params_of ((ts Trees)) (Result Names Fault)
    (uses Alloc)
    (match ts
      ((NoTrees) (Ok (NoNames)))
      ((Trees h more) (match h ((Node inner) (type_params_of more)) ((Leaf text quoted) (match (named text) ((Err f) (Err f)) ((Ok word) (match (type_params_of more) ((Err f) (Err f)) ((Ok others) (Ok (Names word others)))))))))))

  ; Every name in a written type is something: a type parameter in scope (which takes no
  ; arguments), a primitive, or a declared enum, record or newtype at the right arity.
  (fn resolved ((decls Env) (tparams Names) (t Ty)) (Result Unit Fault)
    (uses Alloc)
    (if (names_has tparams (get t base))
      (if (= (tys_count (get t args)) 0)
        (Ok unit)
        (Err (fault "type-arity" "a type parameter takes no arguments")))
      (if (is_primitive (get t base))
        (if (= (tys_count (get t args)) (primitive_arity (get t base)))
          (resolved_all decls tparams (get t args))
          (Err (fault "type-arity" (concat (get t base) " is given the wrong number of type arguments"))))
        (match (enum_of decls (get t base))
          ((Some d) (if (= (tys_count (get t args)) (names_count (get d params))) (resolved_all decls tparams (get t args)) (Err (fault "type-arity" (concat (get t base) " is given the wrong number of type arguments")))))
          ((None) (if (or (present_newtype decls (get t base)) (present_any_record decls (get t base))) (if (= (tys_count (get t args)) 0) (Ok unit) (Err (fault "type-arity" (concat (get t base) " takes no type arguments")))) (Err (fault "unknown-type" (concat "no type is named `" (concat (get t base) "`"))))))))))

  (fn resolved_all ((decls Env) (tparams Names) (ts Tys)) (Result Unit Fault)
    (uses Alloc)
    (match ts
      ((NoTys) (Ok unit))
      ((Tys h more) (match (resolved decls tparams h) ((Err f) (Err f)) ((Ok done) (resolved_all decls tparams more))))))

  ; An array holds one type; a tensor's one argument is its element format; every other
  ; primitive stands alone.
  (fn primitive_arity ((name Str)) Int
    (if (or (str.eq name "Array") (str.eq name "Tensor")) 1 0))

  (fn present_newtype ((decls Env) (name Str)) Bool
    (match (newtype_of decls name) ((Some d) true) ((None) false)))

  (fn present_any_record ((decls Env) (name Str)) Bool
    (match (any_record decls name) ((Some d) true) ((None) false)))

  (fn check_body ((decls Env) (tparams Names) (params Tree) (ret Tree) (body Trees)) (Result Unit Fault)
    (uses Alloc)
    (match (param_locals decls tparams (NoLocals) (param_trees params))
      ((Err f) (Err f))
      ((Ok ls) (match (type_of ret) ((Err f) (Err f)) ((Ok declared) (match (resolved decls tparams declared) ((Err f) (Err f)) ((Ok known) (match (last_of body) ((None) (Err (fault "syntax" "a fn needs a body"))) ((Some b) (match (expr_type decls ls b) ((Err f) (Err f)) ((Ok got) (if (loose_fits got declared) (match (first_unknown (uses_in body)) ((Some odd) (Err (fault "unknown-effect" (concat "no effect is named `" (concat odd "`"))))) ((None) (match (first_missing (effects_in decls b) (uses_in body)) ((None) (Ok unit)) ((Some missing) (Err (fault (if (str.eq missing "Nondet") "nondeterministic-par" "undeclared-effect") (concat "a fn performs " (concat missing " but does not declare it")))))))) (Err (mismatch got declared))))))))))))))

  ; Why a body does not fit its result: the labels alone (label-flow), a tensor's axes alone
  ; (shape), or the type.
  (fn mismatch ((got Ty) (declared Ty)) Fault
    (if (loose_fits (unlabelled got) (unlabelled declared))
      (fault "label-flow" "the body carries a label its declared result does not")
      (if (loose_fits (unaxed got) (unaxed declared))
        (fault "shape" "the body's axes are not the declared result's")
        (fault "type-mismatch" "the body of a fn does not fit its declared result"))))

  (fn unlabelled ((t Ty)) Ty
    (make Ty (base (get t base)) (labels (NoNames)) (args (get t args)) (dims (get t dims))))

  (fn unaxed ((t Ty)) Ty
    (make Ty (base (get t base)) (labels (get t labels)) (args (get t args)) (dims (NoDims))))

  (fn param_trees ((t Tree)) Trees
    (match t ((Leaf text quoted) (NoTrees)) ((Node items) items)))

  (fn param_locals ((decls Env) (tparams Names) (ls Locals) (ps Trees)) (Result Locals Fault)
    (uses Alloc)
    (match ps
      ((NoTrees) (Ok ls))
      ((Trees p more) (match p ((Leaf text quoted) (Err (fault "syntax" "a parameter is (name Type)"))) ((Node parts) (match parts ((NoTrees) (Err (fault "syntax" "a parameter is (name Type)"))) ((Trees n rest) (match rest ((NoTrees) (Err (fault "syntax" "a parameter is (name Type)"))) ((Trees written none) (match n ((Node inner) (Err (fault "syntax" "a parameter is (name Type)"))) ((Leaf ntext nquoted) (match (named ntext) ((Err f) (Err f)) ((Ok name) (match (binder_ok ls name) ((Err f) (Err (if (str.eq (get f op) "shadowing") (fault "duplicate-binding" (get f why)) f))) ((Ok fine) (match (type_of written) ((Err f) (Err f)) ((Ok ty) (match (resolved decls tparams ty) ((Err f) (Err f)) ((Ok known) (param_locals decls tparams (Local name ty ls) more))))))))))))))))))))

  ; --- a whole module, one line per fn -------------------------------------------
  (fn report_source ((src Str)) Str
    (uses Alloc)
    (match (env_with_prelude src)
      ((Err f) (concat "no environment: " (get f why)))
      ((Ok decls) (match (parse (tokens_of (str.encode src))) ((Err f) (concat "not a form: " (get f why))) ((Ok tree) (report_items decls (module_items tree)))))))

  ; The prelude is part of every module: `Option`, `Result`, `Fault` and the newtypes the
  ; primitives answer in. The environment starts from it and the module's own
  ; declarations are added on top, so a module that redeclares one is refused.
  (fn prelude () Str
    "(module prelude (enum (Option T) (None) (Some (value T))) (enum (Result T E) (Ok (value T)) (Err (error E))) (record Fault (schema Fault 1) (op Str) (why Str) (cause (Option Fault))) (newtype Chars Int) (newtype Octets Int) (newtype Count Int) (newtype Instant I64) (newtype WallTime I64) (newtype Ticks I64) (newtype Duration I64) (fn fault ((op Str) (why Str)) Fault (make Fault (op op) (why why) (cause (None)))) (fn (context T) ((r (Result T Fault)) (op Str) (why Str)) (Result T Fault) r))")

  (fn env_with_prelude ((src Str)) (Result Env Fault)
    (uses Alloc)
    (match (env_of_source (prelude))
      ((Err f) (Err f))
      ((Ok base) (match (parse (tokens_of (str.encode src))) ((Err f) (Err f)) ((Ok tree) (collected (module_items tree) base))))))

  (fn module_items ((t Tree)) Trees
    (match t
      ((Leaf text quoted) (NoTrees))
      ((Node items) (match items ((NoTrees) (NoTrees)) ((Trees keyword rest) (match rest ((NoTrees) (NoTrees)) ((Trees name more) more)))))))

  (fn report_items ((decls Env) (items Trees)) Str
    (uses Alloc)
    (match items
      ((NoTrees) "")
      ((Trees h more) (concat (report_one decls h) (report_items decls more)))))

  (fn report_one ((decls Env) (h Tree)) Str
    (uses Alloc)
    (match h
      ((Leaf text quoted) "")
      ((Node parts) (match parts ((NoTrees) "") ((Trees head after) (if (is_word head "fn") (concat (fn_label after) (concat (outcome (check_fn decls h)) "\n")) ""))))))

  (fn fn_label ((after Trees)) Str
    (uses Alloc)
    (match after
      ((NoTrees) "?: ")
      ((Trees name more) (match name ((Node inner) "(generic): ") ((Leaf text quoted) (match (named text) ((Err f) "?: ") ((Ok word) (concat word ": "))))))))

  (fn outcome ((r (Result Unit Fault))) Str
    (match r ((Ok done) "ok") ((Err f) (get f why))))

  ; --- saying what was found -----------------------------------------------------
  (fn array_of_int () Ty
    (make Ty
      (base "Array")
      (labels (NoNames))
      (args (Tys (plain "Int") (NoTys)))
      (dims (NoDims))))

  (fn tensor_ab () Ty
    (make Ty
      (base "Tensor")
      (labels (NoNames))
      (args (Tys (plain "F32") (NoTys)))
      (dims (Dims "a" 2 (Dims "b" 3 (NoDims))))))

  (fn tensor_bc () Ty
    (make Ty
      (base "Tensor")
      (labels (NoNames))
      (args (Tys (plain "F32") (NoTys)))
      (dims (Dims "b" 3 (Dims "c" 4 (NoDims))))))

  (fn labelled_msg ((tag Str)) Ty
    (make Ty (base "Msg") (labels (Names tag (NoNames))) (args (NoTys)) (dims (NoDims))))

  (fn secret_text () Ty
    (make Ty
      (base "Str")
      (labels (Names "Secret" (NoNames)))
      (args (NoTys))
      (dims (NoDims))))

  (fn sample () Locals
    (Local "n"
      (plain "Int")
      (Local "ok"
        (plain "Bool")
        (Local "s"
          (plain "Str")
          (Local "sh"
            (plain "Shape")
            (Local "p"
              (plain "Point")
              (Local "arr"
                (array_of_int)
                (Local "ta"
                  (tensor_ab)
                  (Local "tb"
                    (tensor_bc)
                    (Local "sec"
                      (secret_text)
                      (Local "msg"
                        (plain "Msg")
                        (Local "smsg"
                          (labelled_msg "Secret")
                          (Local "umsg" (labelled_msg "Unverified") (NoLocals))))))))))))))

  ; The declarations the calls below are made against.
  (fn declarations () Str
    "(module m (fn double ((x Int)) Int (* x 2)) (fn both ((a Bool) (b Bool)) Bool a) (fn greet ((s Str)) Str s) (fn (keep T) ((x T)) T x) (enum Shape (Dot) (Pair (a Int) (b Int))) (record Point (x Int) (y Int) (tag Str)) (patch PointPatch Point) (redact Secret hidden) (foreign fetch ((k Str)) Str) (record Msg (schema Msg 1) (body Str)) (channel Out Msg (accepts Secret)) (model Clf (input Str) (output Str) (trained-on Corpus) (device cpu) (weights \"wtn:abc\")))")

  (fn typed ((src Str)) Str
    (uses Alloc)
    (match (env_with_prelude (declarations))
      ((Err f) (concat "no environment: " (get f why)))
      ((Ok decls) (match (parse (tokens_of (str.encode src))) ((Err f) (concat "not a form: " (get f why))) ((Ok tree) (match (expr_type decls (sample) tree) ((Err f) (concat "ill-typed: " (get f why))) ((Ok t) (shown t))))))))

  (test "a number is an Int" (str.eq "Int" (typed "42")))

  (test "a quoted token is a Str" (str.eq "Str" (typed "\"hi\"")))

  (test "true and false are Bools" (str.eq "Bool" (typed "true")))

  (test "a name has the type it was declared at" (str.eq "Bool" (typed "ok")))

  (test "a name out of scope is refused" (str.eq "ill-typed: no name `x` is in scope" (typed "x")))

  (test "arithmetic on Int is an Int" (str.eq "Int" (typed "(+ n (* 2 n))")))

  (test "a comparison is a Bool" (str.eq "Bool" (typed "(<= n 3)")))

  (test "arithmetic on a Str is refused" (str.eq "ill-typed: a primitive mixes number formats" (typed "(+ s 1)")))

  (test "an operator takes two operands" (str.eq "ill-typed: a primitive is given a different number of arguments than it takes" (typed "(+ 1)")))

  (test "an if takes the type of its branches" (str.eq "Str" (typed "(if ok s \"no\")")))

  (test "the branches of an if must agree" (str.eq "ill-typed: the branches of an if have different types" (typed "(if ok 1 s)")))

  (test "the condition of an if is a Bool" (str.eq "ill-typed: the condition of an if is a Bool" (typed "(if n 1 2)")))

  (test "a let puts its name in scope for the body" (str.eq "Int" (typed "(let k (+ n 1) (* k k))")))

  (test "a let's name is not in scope outside it" (str.eq "ill-typed: no name `k` is in scope" (typed "(+ (let k 1 k) k)")))

  (test "a call has the function's result type" (str.eq "Int" (typed "(double (+ n 1))")))

  (test "an argument must fit its parameter" (str.eq "ill-typed: an argument does not fit its parameter" (typed "(double ok)")))

  (test "too few arguments are refused" (str.eq "ill-typed: a call has fewer arguments than the function takes" (typed "(both ok)")))

  (test "too many arguments are refused" (str.eq "ill-typed: a call has more arguments than the function takes" (typed "(greet s s)")))

  (test "a generic function's parameter is found from its argument" (str.eq "Str" (typed "(keep s)")))

  (test "a constructor of a generic enum finds its argument" (str.eq "(Option Int)" (typed "(Some 1)")))

  (test "an argument nothing settles stays unknown" (str.eq "(Option ?)" (typed "(None)")))

  (test "the other branch settles it" (str.eq "(Option Int)" (typed "(if ok (Some 1) (None))")))

  (test "a match on a generic enum binds the instantiated fields" (str.eq "Int" (typed "(match (Some n) ((Some x) x) ((None) 0))")))

  (test "a match has the type of its arms" (str.eq "Int" (typed "(match sh ((Dot) 0) ((Pair a b) (+ a b)))")))

  (test "a variant left out is refused" (str.eq "ill-typed: a match on Shape does not handle every variant" (typed "(match sh ((Dot) 0))")))

  (test "a variant handled twice is refused" (str.eq "ill-typed: `Dot` is handled twice" (typed "(match sh ((Dot) 0) ((Dot) 1) ((Pair a b) a))")))

  (test "a wildcard is refused" (str.eq "ill-typed: wildcard arms are not allowed: a new variant must never be handled silently" (typed "(match sh ((Dot) 0) ((_) 1))")))

  (test "a pattern binds every field" (str.eq "ill-typed: a pattern binds fewer names than the variant has fields" (typed "(match sh ((Dot) 0) ((Pair a) a))")))

  (test "arms must agree" (str.eq "ill-typed: the arms of a match have different types" (typed "(match sh ((Dot) 0) ((Pair a b) ok))")))

  (test "a let may not shadow a name in scope" (str.eq "ill-typed: `n` is already bound in this scope" (typed "(let n 1 n)")))

  (test "a pattern may not shadow a name in scope" (str.eq "ill-typed: `n` is already bound in this scope" (typed "(match sh ((Dot) 0) ((Pair n b) b))")))

  (test "a binder may not be a group of builtins" (str.eq "ill-typed: `str` names a group of builtins, so a binding may not take it" (typed "(let str 1 str)")))

  (test "a binder starts lower-case" (str.eq "ill-typed: bindings start lower-case: `K`" (typed "(let K 1 K)")))

  (test "a make has the record's type" (str.eq "Point" (typed "(make Point (x 1) (y 2) (tag \"a\"))")))

  (test "a make needs every field" (str.eq "ill-typed: a make needs every field" (typed "(make Point (x 1) (y 2))")))

  (test "a make gives its fields in order" (str.eq "ill-typed: a make gives its fields in declaration order, with none left out" (typed "(make Point (y 2) (x 1) (tag \"a\"))")))

  (test "a field's value must fit" (str.eq "ill-typed: a value does not fit field `x`" (typed "(make Point (x ok) (y 2) (tag \"a\"))")))

  (test "a get has the field's type" (str.eq "Str" (typed "(get p tag)")))

  (test "a get of a missing field is refused" (str.eq "ill-typed: Point has no field `z`" (typed "(get p z)")))

  (test "a with has the record's type" (str.eq "Point" (typed "(with p (x 1) (tag \"q\"))")))

  (test "a with may not repeat a field" (str.eq "ill-typed: no field `x` is left to give, in this order" (typed "(with p (x 1) (x 2))")))

  (test "a with changes at least one field" (str.eq "ill-typed: a with changes at least one field" (typed "(with p)")))

  (test "an array's length is a Count" (str.eq "Count" (typed "(array.len arr)")))

  (test "an element comes out in an Option" (str.eq "(Option Int)" (typed "(array.at arr (array.len arr))")))

  (test "what is pushed must be what the array holds" (str.eq "ill-typed: the value pushed onto an array is not what it holds" (typed "(array.push arr s)")))

  (test "an empty array's element is not settled yet" (str.eq "(Array ?)" (typed "(array.empty)")))

  (test "a matrix product contracts the axes that meet" (str.eq "(Tensor F32 (a 2) (c 4))" (typed "(tensor.matmul ta tb)")))

  (test "a transposed product is refused" (str.eq "ill-typed: tensor.matmul contracts the last axis of the left with the first of the right, and they are not the same axis" (typed "(tensor.matmul tb ta)")))

  (test "a label travels through a primitive" (str.eq "Str @Secret" (typed "(concat sec s)")))

  (test "declassify releases a label" (str.eq "Str" (typed "(declassify Secret (concat sec s))")))

  (test "the branches of an if may carry different labels" (str.eq "Str @Secret" (typed "(if ok sec s)")))

  (test "a decimal literal is a Real until a format is named" (str.eq "F32" (typed "(f32.of 1.5)")))

  (test "an update takes a patch of that record" (str.eq "Point" (typed "(update p (make PointPatch (x (Some 1)) (y (None)) (tag (None))))")))

  (test "an update without a patch is refused" (str.eq "ill-typed: an update needs a patch" (typed "(update p p)")))

  (test "a patch must give every field, in an Option" (str.eq "ill-typed: a make needs every field" (typed "(make PointPatch (x (Some 1)))")))

  (test "a log line is a Unit" (str.eq "Unit" (typed "(log.fields (count n) (name s))")))

  (test "a log field may not repeat" (str.eq "ill-typed: a log field is given twice" (typed "(log.fields (count n) (count n))")))

  (test "what a foreign function answers is unverified" (str.eq "Str @Unverified" (typed "(fetch s)")))

  (test "a send checks the channel's labels" (str.eq "Unit" (typed "(send Out smsg)")))

  (test "a send must be the channel's payload" (str.eq "ill-typed: the value sent is not the channel's payload" (typed "(send Out s)")))

  (test "a recv answers what the channel admits" (str.eq "(Option Msg @Secret)" (typed "(recv Out)")))

  (test "an infer carries its input's labels and its training data's" (str.eq "Str @Corpus @ModelOutput" (typed "(infer Clf s)")))

  (test "a par binds each branch for the body" (str.eq "Int" (typed "(par ((a (+ n 1)) (b (+ n 2))) (+ a b))")))

  (test "a scope hands the body what its tasks carry" (str.eq "(Result Int Fault)" (typed "(scope ((t (Ok 1) (deadline (duration.of_ms (i64.of 5))) (on-fail fail))) (Ok (+ t 1)))")))

  (test "a form not read yet is turned away by name" (str.eq "ill-typed: `mystery` is not read yet" (typed "(mystery n)")))

  (fn main () Unit
    (uses Alloc Console)
    (seq
      (print (typed "(if (<= n 3) n (+ n 1))"))
      (print (typed "(if n 1 2)"))
      (print (typed "(f n)")))))
