; The type of an expression, read from its tree against the names in scope.
;
; The second piece of the Phase 2 checker, after compiler/typecheck.wtn read a type out
; of source. It covers the part of the language that needs nothing but a scope: literals,
; names, `if`, and arithmetic and comparison on `Int`. A call to a declared function, a
; `match`, a `let` and the rest come next and say so by refusing: a form this does not
; read is turned away with the form's name, never guessed at.
;
; What is judged is only the type. Whether an operation can overflow, or a condition is
; provable, is the prover's business and none of this pass's; it answers what the
; Python checker's `_expr` answers before any obligation is raised.
;
;   witness run compiler/expr.wtn --grant Alloc,Console
(module expr
  ; Every label a type carries, wherever in it: the kernel's own walk, taken rather than
  ; written again under another name.
  (use "wtn:608532136ea7a9cc73a01524073c19bacd7aaefce3efb4faebb6528ea4a86b11"
    as
    labels_deep)

  (use "wtn:86a99f8451d3c7998900c44d4eac8671aac7a339305b840140e9696becd82774" as Tree)

  (use "wtn:4518c8219b4cc1aa6d0d1c0e4490160bbddfdf49348a92c47e1f9de9e69fb47e" as parse)

  (use "wtn:37b77793359240afd68298a030a33b6f0d6fc0868bd10d00420a1edfb8d92d26" as tokens_of)

  (use "wtn:92f81a40f63652dea9fbf74791ba55b839d7db7e5dbbb2f5e8a7c2512a911780" as named)

  (use "wtn:d371dabcadae5e0f7dbfea300a8b823e4d3140e5e0336a00393fe722ceb7069b" as plain)

  (use "wtn:af1e918412dddc13cfa2e8020e1c36c71b7fdc47c9df423fd0693bccd2af9575" as shown)

  (use "wtn:a9e2f9aa9fbff0e4da8d7b33ee725f08fc9f01529c5e2edd3e20bf5e5b5edcbb" as Env)

  (use "wtn:0467e6da785e3d4510a5f4b6c4d415736dfaeecf2e4adbdc2ac82fe76ee3de28"
    as
    signature_of)

  (use "wtn:73475838d70d180b65533219f2e05082fc567733e46dbd77b0dd6ee3a4a325da"
    as
    env_of_source)

  (use "wtn:709fc445d0bb2126a17cc59426ba8c16a2cc8fc8d1a9036bf0bfd7817aba5bca" as enum_of)

  (use "wtn:eeac0a58c74c2c8e42df0f7056c90c7eb7b0dd78485f27e810b2e75a271447ba" as variant_of)

  (use "wtn:8d123602cebf5e9de6a5e992a7483873e86b9595b4833c48ab2f123b03f9da9c" as names_has)

  (use "wtn:391e924d31f28ba56c34bd35b70757803b8021c81a605839336cc0c9dc1131d1" as record_of)

  (use "wtn:a1bfb0d57b638229fc7a5772ac4d6b49ca9bfd6668aeeef9dced9e6d8f141bfa" as field_at)

  (use "wtn:0806fb421a4d2267c936e2efbc71aada4a3d2f76ac8116019678462d0ad0348a" as ty_plus)

  (use "wtn:a327a3354cda09d706b7552c925e0e5817b918bd5eb5e7b104369c6cdf63a871" as primitive)

  (use "wtn:239508bf7fe41345cc8ffe9f317fc3c35f7629f881efa5ea44d60ff81b7f574c"
    as
    allowed_format)

  (use "wtn:5254c76f0de7323e88d2201fb6aba452c6edef99e1e18ee34fc76135dece5e0b"
    as
    is_fixed_width)

  (use "wtn:2783d5badf8794113c8eb4d51c6bf8f7e37774eaabcfd2b791c9e82fb1a2e051" as fits_want)

  (use "wtn:7b463d2694f8a95de73c4ebcc36ac8d62a74441441ff03349277665f634ca61d" as answered)

  (use "wtn:17eba03513ce8dcf68f8fbe92fc3f6771c5d30442de431246d594b8ecdd6d48f"
    as
    wants_count)

  (use "wtn:fb2f9c7b433809854f53f9e2237db409e6d3b99d5e621038f5feb004dc957372"
    as
    stands_for_a_number)

  (use "wtn:bf7764f50adf617405038f927a145e9a225a550297a206d4a9162b3fb8b65d8b" as tys_count)

  (use "wtn:2bf9db991f79bd86386f9d48b3d14c3938df6dbacab323d8c9f06fdbab332347" as newtype_of)

  (use "wtn:209085983cb25b9fe57efaa3917faee8873e6f23e495572eee5f6038a2782322" as last_of)

  (use "wtn:3fdd718f00ba3dd37317de926fb93b14c7438de6daffd8a4f75e03ae9353df32" as type_of)

  (use "wtn:b74a1973df7919505307399950487f6de6ccf432871b362157e7698205a90710" as is_word)

  (use "wtn:989f32a48713655e7f23a328a06d723337463cf98766e4dcd27980b76a609597" as collected)

  (use "wtn:8cad77ce8028c78b6f80b49536f0448d8c6f075789964549c88ebef18b6275ab" as dims_eq)

  (use "wtn:87738bbc3d280b4506682245c8a9c435c6331baf7356e9575b361b2d6a6eb11a"
    as
    names_within)

  (use "wtn:add8d88231eab6d22b551e7feeed5144097f259ae3f8bb82eb9d90e8256ec974"
    as
    names_index)

  (use "wtn:4858b623debd74b1316b0b39a4f7f4e213d411a22c2d2f8ceb911c05dd60fecb" as ty_at)

  (use "wtn:cec34254f3af0a4b2bbeb035ac2b15ccf29cd47dc111e463543cda0b385e0fda"
    as
    names_count)

  (use "wtn:51cc51adfdd8a230b6994a43e368eb4d1c2659779ba83843976a6a406b4ffdfc"
    as
    is_primitive)

  (use "wtn:389c32161549ec786e2e27e301b832610ff750d6be481603802f9a9a25ed52a8" as ty_strip)

  (use "wtn:4aab89ca9b8d498c2f69d8799321ce4c6aae73c69e22950b63f8b9f8f4f63fbe"
    as
    names_union)

  (use "wtn:c6398eb5ab0b14cf194672066b7d3a72fdde0ca40fe9d9986e10ed14a34ee143" as patch_of)

  (use "wtn:fd8007113ca063049f03120013647bb573bd426ebee0c31d860f249064364e68" as channel_of)

  (use "wtn:fa0c3f1564b61f14efea122459d97a80aee0a0200a55894c0585e196050765c8" as model_of)

  (use "wtn:c22a070d8cde78f6b2529a7cee9c92f95fe21e2ab57a3467911fb3d5a4bb3dce" as uses_in)

  (use "wtn:726e882e80cd3e9021af16dfbc8be44de67d22ef62892ebceeca01b349d08ab1" as byte_at)

  (use "wtn:315e70b0830671f92192b9b7cff60d910b683354fdc3c37bb8da01d8eec89674" as is_digit)

  ; --- scope -----------------------------------------------------------------
  ; The names a body can see, innermost first, each with the type it was declared at.
  (enum Locals (NoLocals) (Local (name Str) (ty Ty) (rest Locals)))

  (fn lookup ((ls Locals) (name Str)) (Option Ty)
    (match ls
      ((NoLocals) (None))
      ((Local n ty rest) (if (str.eq n name) (Some ty) (lookup rest name)))))

  ; --- binders ---------------------------------------------------------------
  ; What Python's checker asks of a name a `let` or a pattern introduces: it starts with a
  ; lower-case letter, it is not the name of a group of builtins (`str.eq` would read two
  ; ways), and nothing already in scope has it. Lower-case is ASCII here, where Python's
  ; also takes any other lower-case letter; no name in this project starts with one.
  (fn binder_ok ((ls Locals) (name Str)) (Result Unit Fault)
    (uses Alloc)
    (if (not (lower_first (byte_at (str.encode name) 0)))
      (Err (fault "naming" (concat "bindings start lower-case: `" (concat name "`"))))
      (if (is_group name)
        (Err (fault "naming" (concat "`" (concat name "` names a group of builtins, so a binding may not take it"))))
        (match (lookup ls name)
          ((Some ty) (Err (fault "shadowing" (concat "`" (concat name "` is already bound in this scope")))))
          ((None) (Ok unit))))))

  (fn lower_first ((b Int)) Bool (and (<= 97 b) (<= b 122)))

  (fn is_group ((name Str)) Bool
    (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (or (str.eq name "bf16") (str.eq name "bit")) (str.eq name "bytes")) (str.eq name "clock")) (str.eq name "duration")) (str.eq name "env")) (str.eq name "f16")) (str.eq name "f32")) (str.eq name "i16")) (str.eq name "i32")) (str.eq name "i64")) (str.eq name "i8")) (str.eq name "instant")) (str.eq name "int")) (str.eq name "net")) (str.eq name "num")) (str.eq name "sat")) (str.eq name "store")) (str.eq name "str")) (str.eq name "tensor")) (str.eq name "ticks")) (str.eq name "u16")) (str.eq name "u32")) (str.eq name "u64")) (str.eq name "u8")) (str.eq name "wall"))
      (str.eq name "wrap")))

  ; --- types that are not all known yet ---------------------------------------
  ; `Ok 1` is a `Result Int ?`: the error type is not settled by anything written, and
  ; becomes whatever the place it is used in wants. Python's checker does this with
  ; unification variables; here an unknown is the type `?`, which fits anywhere and is
  ; filled in by `join` when two types for one place meet.
  (fn unknown () Ty (plain "?"))

  (fn is_unknown ((t Ty)) Bool (str.eq (get t base) "?"))

  (fn loose_fits ((got Ty) (want Ty)) Bool
    (or (or (is_unknown got) (is_unknown want))
      (and (and (str.eq (get got base) (get want base)) (dims_eq (get got dims) (get want dims)))
        (and (names_within (get got labels) (get want labels))
          (tys_loose_fit (get got args) (get want args))))))

  (fn tys_loose_fit ((p Tys) (q Tys)) Bool
    (match p
      ((NoTys) (match q ((NoTys) true) ((Tys b more) false)))
      ((Tys a rest) (match q ((NoTys) false) ((Tys b more) (and (loose_fits a b) (tys_loose_fit rest more)))))))

  ; Two types for one place, the branches of an `if` or the arms of a `match`: the same
  ; type wherever the labels are not looked at, since the answer carries both sets.
  (fn loose_eq ((a Ty) (b Ty)) Bool
    (or (or (is_unknown a) (is_unknown b))
      (and (and (str.eq (get a base) (get b base)) (dims_eq (get a dims) (get b dims)))
        (tys_loose_eq (get a args) (get b args)))))

  (fn tys_loose_eq ((p Tys) (q Tys)) Bool
    (match p
      ((NoTys) (match q ((NoTys) true) ((Tys b more) false)))
      ((Tys a rest) (match q ((NoTys) false) ((Tys b more) (and (loose_eq a b) (tys_loose_eq rest more)))))))

  ; Two types for one place, with each unknown filled from the other.
  (fn join ((a Ty) (b Ty)) Ty
    (uses Alloc)
    (if (is_unknown a)
      b
      (if (is_unknown b)
        a
        (with a
          (labels (names_union (get a labels) (get b labels)))
          (args (join_tys (get a args) (get b args)))))))

  (fn join_tys ((p Tys) (q Tys)) Tys
    (uses Alloc)
    (match p
      ((NoTys) p)
      ((Tys x rest) (match q ((NoTys) p) ((Tys y more) (Tys (join x y) (join_tys rest more)))))))

  ; --- generic types ------------------------------------------------------------
  ; A type written with the parameters of a declaration, at the arguments it was given.
  (fn subst ((t Ty) (params Names) (given Tys)) Ty
    (uses Alloc)
    (if (< (names_index params (get t base)) 0)
      (with t (args (subst_all (get t args) params given)))
      (match (ty_at given (names_index params (get t base)))
        ((Some a) (ty_plus a (get t labels)))
        ((None) t))))

  (fn subst_all ((ts Tys) (params Names) (given Tys)) Tys
    (uses Alloc)
    (match ts
      ((NoTys) (NoTys))
      ((Tys h rest) (Tys (subst h params given) (subst_all rest params given)))))

  (fn unknowns ((params Names)) Tys
    (match params ((NoNames) (NoTys)) ((Names first rest) (Tys (unknown) (unknowns rest)))))

  (fn set_at ((ts Tys) (i Int) (ty Ty)) Tys
    (match ts
      ((NoTys) (NoTys))
      ((Tys h rest) (if (= i 0) (Tys ty rest) (Tys h (set_at rest (- i 1) ty))))))

  ; What a parameter's type, written with the declaration's type parameters, says about
  ; them once it meets the type actually given: each parameter is bound the first time
  ; it is met and must agree afterwards.
  (fn bind ((pat Ty) (actual Ty) (params Names) (acc Tys)) (Result Tys Fault)
    (uses Alloc)
    (if (< (names_index params (get pat base)) 0)
      (if (is_unknown actual)
        (Ok acc)
        (if (str.eq (get pat base) (get actual base))
          (bind_all (get pat args) (get actual args) params acc)
          (Err (fault "type-mismatch" "an argument has a different type than its parameter"))))
      (match (ty_at acc (names_index params (get pat base)))
        ((None) (Ok acc))
        ((Some seen) (if (is_unknown seen) (Ok (set_at acc (names_index params (get pat base)) actual)) (if (loose_fits actual seen) (Ok (set_at acc (names_index params (get pat base)) (join seen actual))) (Err (fault "type-mismatch" "a type parameter is given two different types"))))))))

  (fn bind_all ((pats Tys) (actuals Tys) (params Names) (acc Tys)) (Result Tys Fault)
    (uses Alloc)
    (match pats
      ((NoTys) (Ok acc))
      ((Tys p more) (match actuals ((NoTys) (Ok acc)) ((Tys a rest) (match (bind p a params acc) ((Err f) (Err f)) ((Ok next) (bind_all more rest params next))))))))

  ; --- leaves ------------------------------------------------------------------
  ; A quoted token is a `Str`. A word is a literal if it is `true` or `false`, or a
  ; number if it starts with a digit -- the reader's own rule for a number -- and a name
  ; otherwise, which must be in scope.
  (fn leaf_type ((decls Env) (ls Locals) (text Bytes) (quoted Bool)) (Result Ty Fault)
    (uses Alloc)
    (if quoted
      (Ok (plain "Str"))
      (if (is_number text)
        (if (has_point text 0 (unwrap (bytes.len text)))
          (Ok (plain "Real"))
          (Ok (plain "Int")))
        (match (named text)
          ((Err e) (Err e))
          ((Ok word) (if (or (str.eq word "true") (str.eq word "false")) (Ok (plain "Bool")) (if (str.eq word "unit") (Ok (plain "Unit")) (match (lookup ls word) ((Some ty) (Ok ty)) ((None) (match (signature_of decls word) ((Some sig) (Err (fault "not-a-value" (concat "`" (concat word "` is a function, not a value"))))) ((None) (Err (fault "unknown-name" (concat "no name `" (concat word "` is in scope")))))))))))))))

  ; A number starts with a digit, or with a minus sign and then a digit.
  (fn is_number ((text Bytes)) Bool
    (or (is_digit (byte_at text 0))
      (and (= (byte_at text 0) 45) (is_digit (byte_at text 1)))))

  (fn has_point ((b Bytes) (at Int) (left Int)) Bool
    (requires (<= 0 left))
    (if (or (<= left 0) (<= (unwrap (bytes.len b)) at))
      false
      (if (= (byte_at b at) 46) true (has_point b (+ at 1) (- left 1)))))

  ; --- forms -------------------------------------------------------------------
  (fn expr_type ((decls Env) (ls Locals) (t Tree)) (Result Ty Fault)
    (uses Alloc)
    (match t
      ((Leaf text quoted) (leaf_type decls ls text quoted))
      ((Node items) (match items ((NoTrees) (Err (fault "syntax" "an empty list is not an expression"))) ((Trees head rest) (match head ((Node inner) (Err (fault "syntax" "a call's head is a name, not a list"))) ((Leaf text quoted) (match (named text) ((Err e) (Err e)) ((Ok name) (form_type decls ls name rest))))))))))

  (fn form_type ((decls Env) (ls Locals) (name Str) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (if (str.eq name "if")
      (if_type decls ls rest)
      (if (str.eq name "let")
        (let_type decls ls rest)
        (if (str.eq name "match")
          (match_type decls ls rest)
          (if (str.eq name "make")
            (make_type decls ls rest)
            (if (str.eq name "get")
              (get_type decls ls rest)
              (if (str.eq name "with")
                (with_type decls ls rest)
                (if (str.eq name "seq")
                  (seq_type decls ls rest)
                  (if (str.eq name "unwrap")
                    (unwrap_type decls ls rest)
                    (if (str.eq name "declassify")
                      (declassify_type decls ls rest)
                      (if (str.eq name "bytes")
                        (bytes_type rest)
                        (match (signature_of decls name)
                          ((Some sig) (call_type decls ls sig rest))
                          ((None) (other_type decls ls name rest))))))))))))))

  ; `(bytes "6162")`: a literal `Bytes`, written as pairs of hexadecimal digits.
  (fn bytes_type ((rest Trees)) (Result Ty Fault)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a Bytes literal is (bytes \"hex\")")))
      ((Trees a more) (match more ((Trees extra others) (Err (fault "syntax" "a Bytes literal is (bytes \"hex\")"))) ((NoTrees) (match a ((Node inner) (Err (fault "syntax" "a Bytes literal is (bytes \"hex\")"))) ((Leaf text quoted) (if quoted (Ok (plain "Bytes")) (Err (fault "syntax" "a Bytes literal is (bytes \"hex\")"))))))))))

  ; Everything that is neither a special form nor a declared function: a newtype's
  ; constructor, a variant's, or a primitive.
  (fn other_type ((decls Env) (ls Locals) (name Str) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match (newtype_of decls name)
      ((Some d) (wrap_type decls ls d rest))
      ((None) (match (owner_of (get decls enums) name) ((Some e) (variant_call decls ls e name rest)) ((None) (match (primitive name) ((Some b) (if (or (str.eq name "tensor.add") (str.eq name "tensor.matmul")) (tensor_type_of decls ls name rest) (builtin_type decls ls b rest))) ((None) (if (or (or (str.eq name "array.empty") (str.eq name "array.len")) (or (str.eq name "array.at") (str.eq name "array.push"))) (array_type decls ls name rest) (if (str.eq name "update") (update_type decls ls rest) (if (str.eq name "send") (send_type decls ls rest) (if (str.eq name "recv") (recv_type decls rest) (if (str.eq name "infer") (infer_type decls ls rest) (if (str.eq name "scope") (scope_type decls ls rest) (if (str.eq name "par") (par_type decls ls rest) (if (str.eq name "log.fields") (match rest ((NoTrees) (Err (fault "syntax" "a log.fields needs at least one field"))) ((Trees first others) (log_type decls ls rest (NoNames)))) (Err (fault "unread" (concat "`" (concat name "` is not read yet")))))))))))))))))))

  ; `(declassify Label expr)`: the value without that label, wherever in its type it was.
  ; Whether the function is allowed to release it is the effect pass's question.
  (fn declassify_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a declassify takes a label and an expression")))
      ((Trees which more) (match which ((Node inner) (Err (fault "syntax" "a label is a name"))) ((Leaf ltext lquoted) (match more ((NoTrees) (Err (fault "syntax" "a declassify takes a label and an expression"))) ((Trees value none) (match none ((Trees extra others) (Err (fault "syntax" "a declassify takes a label and an expression"))) ((NoTrees) (match (named ltext) ((Err f) (Err f)) ((Ok name) (match (expr_type decls ls value) ((Err f) (Err f)) ((Ok t) (Ok (ty_strip t name)))))))))))))))

  ; --- patches, updates and logs -----------------------------------------------
  ; A record, or a patch read as the record it partially updates: the same fields, each
  ; in an `Option`, so that leaving one out is a decision written down.
  (fn any_record ((decls Env) (name Str)) (Option RecordSignature)
    (match (record_of decls name)
      ((Some d) (Some d))
      ((None) (match (patch_of decls name) ((None) (None)) ((Some pt) (match (record_of decls (get pt target)) ((None) (None)) ((Some r) (Some (make RecordSignature (name name) (fields (optional_fields (get r fields))) (wired false))))))))))

  (fn optional_fields ((fs RecordFields)) RecordFields
    (match fs
      ((NoRecordFields) (NoRecordFields))
      ((RecordFields n ty rest) (RecordFields n (make Ty (base "Option") (labels (NoNames)) (args (Tys ty (NoTys))) (dims (NoDims))) (optional_fields rest)))))

  ; `(update record patch)`: the patch must be one for that record, and the result carries
  ; whatever labels the patch brought.
  (fn update_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "an update takes a record and a patch")))
      ((Trees value more) (match more ((NoTrees) (Err (fault "syntax" "an update takes a record and a patch"))) ((Trees amendment none) (match none ((Trees extra others) (Err (fault "syntax" "an update takes a record and a patch"))) ((NoTrees) (match (expr_type decls ls value) ((Err f) (Err f)) ((Ok held) (match (expr_type decls ls amendment) ((Err f) (Err f)) ((Ok given) (match (patch_of decls (get given base)) ((None) (Err (fault "not-a-patch" "an update needs a patch"))) ((Some pt) (if (str.eq (get pt target) (get held base)) (Ok (ty_plus held (get given labels))) (Err (fault "type-mismatch" "a patch updates a different record"))))))))))))))))

  ; `(log.fields (name value)...)`: lower-case names, none twice, and nothing labelled
  ; unless the label has a redaction policy.
  (fn log_type ((decls Env) (ls Locals) (rest Trees) (seen Names)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Ok (plain "Unit")))
      ((Trees init more) (match init ((Leaf itext iquoted) (Err (fault "syntax" "a log field is (name value)"))) ((Node parts) (match parts ((NoTrees) (Err (fault "syntax" "a log field is (name value)"))) ((Trees fname after) (match after ((NoTrees) (Err (fault "syntax" "a log field is (name value)"))) ((Trees value none) (match none ((Trees extra others) (Err (fault "syntax" "a log field is (name value)"))) ((NoTrees) (match fname ((Node inner) (Err (fault "syntax" "a log field's name is a name"))) ((Leaf ftext fquoted) (match (named ftext) ((Err f) (Err f)) ((Ok field) (if (not (lower_first (byte_at (str.encode field) 0))) (Err (fault "naming" "log field names start lower-case")) (if (names_has seen field) (Err (fault "duplicate-binding" "a log field is given twice")) (match (expr_type decls ls value) ((Err f) (Err f)) ((Ok t) (if (all_redacted (get decls redactions) (labels_deep t)) (log_type decls ls more (Names field seen)) (Err (fault "undeclared-redaction" "a field carries a label that has no redaction policy, so it cannot be logged"))))))))))))))))))))))

  (fn all_redacted ((policy Names) (ls Names)) Bool
    (match ls
      ((NoNames) true)
      ((Names l more) (and (names_has policy l) (all_redacted policy more)))))

  ; --- channels, models and tasks ------------------------------------------------
  ; `(send Channel value)` checks the receiver's labels here, where the data still is: the
  ; value must be the channel's payload, and every label it carries must be one the
  ; channel admits. `(recv Channel)` answers what arrives, which carries exactly those.
  (fn send_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a send takes a channel and a value")))
      ((Trees chan more) (match chan ((Node inner) (Err (fault "syntax" "a channel's name is a name"))) ((Leaf ctext cquoted) (match more ((NoTrees) (Err (fault "syntax" "a send takes a channel and a value"))) ((Trees value none) (match none ((Trees extra others) (Err (fault "syntax" "a send takes a channel and a value"))) ((NoTrees) (match (named ctext) ((Err f) (Err f)) ((Ok cname) (match (channel_of decls cname) ((None) (Err (fault "unknown-name" (concat "no channel named `" (concat cname "`"))))) ((Some c) (match (expr_type decls ls value) ((Err f) (Err f)) ((Ok sent) (if (not (or (is_unknown sent) (str.eq (get sent base) (get c payload)))) (Err (fault "type-mismatch" "the value sent is not the channel's payload")) (if (all_redacted (get c admits) (labels_deep sent)) (Ok (plain "Unit")) (Err (fault "label-flow" "a channel does not admit the labels the value carries")))))))))))))))))))

  (fn recv_type ((decls Env) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a recv takes a channel")))
      ((Trees chan more) (match more ((Trees extra others) (Err (fault "syntax" "a recv takes a channel"))) ((NoTrees) (match chan ((Node inner) (Err (fault "syntax" "a channel's name is a name"))) ((Leaf ctext cquoted) (match (named ctext) ((Err f) (Err f)) ((Ok cname) (match (channel_of decls cname) ((None) (Err (fault "unknown-name" (concat "no channel named `" (concat cname "`"))))) ((Some c) (Ok (make Ty (base "Option") (labels (NoNames)) (args (Tys (make Ty (base (get c payload)) (labels (get c admits)) (args (NoTys)) (dims (NoDims))) (NoTys))) (dims (NoDims)))))))))))))))

  ; `(infer Model input)`: the input must be the model's, and the answer carries the
  ; labels of the input, of the training data, and `ModelOutput`, so that what a model
  ; says is not mistaken for a fact.
  (fn infer_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "an infer takes a model and an input")))
      ((Trees m more) (match m ((Node inner) (Err (fault "syntax" "a model's name is a name"))) ((Leaf mtext mquoted) (match more ((NoTrees) (Err (fault "syntax" "an infer takes a model and an input"))) ((Trees input none) (match none ((Trees extra others) (Err (fault "syntax" "an infer takes a model and an input"))) ((NoTrees) (match (named mtext) ((Err f) (Err f)) ((Ok mname) (match (model_of decls mname) ((None) (Err (fault "unknown-name" (concat "no model named `" (concat mname "`"))))) ((Some known) (match (expr_type decls ls input) ((Err f) (Err f)) ((Ok given) (if (loose_fits given (ty_plus (get known input) (get given labels))) (Ok (ty_plus (get known output) (names_union (get given labels) (names_union (get known trained) (Names "ModelOutput" (NoNames)))))) (Err (fault "type-mismatch" "the input is not the model's input"))))))))))))))))))

  ; A task fails with a `Fault`, so its work is a `(Result T Fault)` and the scope hands
  ; the body a `T`. The scope itself answers the body's type, which must be able to carry
  ; an escalated failure.
  (fn carried ((t Ty)) (Result Ty Fault)
    (uses Alloc)
    (if (is_unknown t)
      (Ok t)
      (if (not (str.eq (get t base) "Result"))
        (Err (fault "task-shape" "a task's work must be able to fail: it is a (Result T Fault)"))
        (match (get t args)
          ((NoTys) (Err (fault "task-shape" "a task's work must be able to fail: it is a (Result T Fault)")))
          ((Tys value more) (match more ((NoTys) (Err (fault "task-shape" "a task's work must be able to fail: it is a (Result T Fault)"))) ((Tys failure none) (if (loose_fits failure (plain "Fault")) (Ok (ty_plus value (get t labels))) (Err (fault "type-mismatch" "a task fails with a Fault"))))))))))

  ; A scope's own answer is a `(Result T Fault)`: what is not settled is pinned to Fault.
  (fn failing () Ty
    (make Ty
      (base "Result")
      (labels (NoNames))
      (args (Tys (unknown) (Tys (plain "Fault") (NoTys))))
      (dims (NoDims))))

  ; `(scope ((name work (deadline d) (on-fail p) [(on where)])...) body)`.
  (fn scope_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a scope takes tasks and a body")))
      ((Trees tasks more) (match more ((NoTrees) (Err (fault "syntax" "a scope takes tasks and a body"))) ((Trees body none) (match none ((Trees extra others) (Err (fault "syntax" "a scope takes tasks and a body"))) ((NoTrees) (match tasks ((Leaf ttext tquoted) (Err (fault "syntax" "a scope's tasks are a list"))) ((Node list) (match (task_scope decls ls ls list) ((Err f) (Err f)) ((Ok inside) (match (expr_type decls inside body) ((Err f) (Err f)) ((Ok answer) (match (carried answer) ((Err f) (Err f)) ((Ok kept) (Ok (join answer (failing))))))))))))))))))

  ; The tasks one after another: each is read in the scope outside them all, and binds
  ; its name for the body. `inner` is that growing scope.
  (fn task_scope ((decls Env) (outer Locals) (inner Locals) (tasks Trees)) (Result Locals Fault)
    (uses Alloc)
    (match tasks
      ((NoTrees) (Ok inner))
      ((Trees task more) (match task ((Leaf ttext tquoted) (Err (fault "syntax" "a task is (name work (deadline d) (on-fail p))"))) ((Node parts) (match parts ((NoTrees) (Err (fault "syntax" "a task is (name work (deadline d) (on-fail p))"))) ((Trees name after) (match after ((NoTrees) (Err (fault "syntax" "a task is (name work (deadline d) (on-fail p))"))) ((Trees work clauses) (match name ((Node inside) (Err (fault "syntax" "a task's name is a name"))) ((Leaf ntext nquoted) (match (named ntext) ((Err f) (Err f)) ((Ok tname) (match (expr_type decls outer work) ((Err f) (Err f)) ((Ok done) (match (carried done) ((Err f) (Err f)) ((Ok value) (match (task_deadline decls outer clauses) ((Err f) (Err f)) ((Ok fine) (match (placed decls (concat "task `" (concat tname "`")) clauses done) ((Err f) (Err f)) ((Ok wired) (match (binder_ok inner tname) ((Err f) (Err f)) ((Ok free) (task_scope decls outer (Local tname value inner) more))))))))))))))))))))))))

  ; The first clause of a task is `(deadline d)`, and `d` is a Duration.
  (fn task_deadline ((decls Env) (outer Locals) (clauses Trees)) (Result Unit Fault)
    (uses Alloc)
    (match clauses
      ((NoTrees) (Err (fault "syntax" "a task needs a deadline")))
      ((Trees clause more) (match clause ((Leaf ctext cquoted) (Err (fault "syntax" "a task needs a deadline"))) ((Node parts) (match parts ((NoTrees) (Err (fault "syntax" "a task needs a deadline"))) ((Trees head args) (if (is_word head "deadline") (match args ((NoTrees) (Err (fault "type-mismatch" "a deadline is a duration"))) ((Trees d none) (match (expr_type decls outer d) ((Err f) (Err f)) ((Ok given) (if (loose_fits given (plain "Duration")) (Ok unit) (Err (fault "type-mismatch" "a deadline is a Duration"))))))) (Err (fault "syntax" "a task needs a deadline"))))))))))

  ; `(par ((name work [(on where)])...) body)`: every branch is read in the scope before
  ; the block, so a branch cannot observe another, and the body sees all their names.
  (fn par_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a par takes branches and a body")))
      ((Trees branches more) (match more ((NoTrees) (Err (fault "syntax" "a par takes branches and a body"))) ((Trees body none) (match none ((Trees extra others) (Err (fault "syntax" "a par takes branches and a body"))) ((NoTrees) (match branches ((Leaf btext bquoted) (Err (fault "syntax" "a par's branches are a list"))) ((Node list) (match (branch_scope decls ls ls list) ((Err f) (Err f)) ((Ok inside) (expr_type decls inside body))))))))))))

  (fn branch_scope ((decls Env) (outer Locals) (inner Locals) (branches Trees)) (Result Locals Fault)
    (uses Alloc)
    (match branches
      ((NoTrees) (Ok inner))
      ((Trees branch more) (match branch ((Leaf btext bquoted) (Err (fault "syntax" "a branch is (name work)"))) ((Node parts) (match parts ((NoTrees) (Err (fault "syntax" "a branch is (name work)"))) ((Trees name after) (match after ((NoTrees) (Err (fault "syntax" "a branch is (name work)"))) ((Trees work clauses) (match name ((Node inside) (Err (fault "syntax" "a branch's name is a name"))) ((Leaf ntext nquoted) (match (named ntext) ((Err f) (Err f)) ((Ok bname) (match (expr_type decls outer work) ((Err f) (Err f)) ((Ok value) (match (placed decls (concat "branch `" (concat bname "`")) clauses value) ((Err f) (Err f)) ((Ok fine) (match (binder_ok inner bname) ((Err f) (Err f)) ((Ok free) (branch_scope decls outer (Local bname value inner) more))))))))))))))))))))

  ; --- what crosses to memory of its own ---------------------------------------------
  ; Work placed on another `process` or `node` is copied over a wire, not shared, so every
  ; part of what it answers needs an agreed form: a primitive, or a record with a schema.
  ; Whether the profile has such a place at all is compiler/effects.wtn's business.
  (fn placed ((decls Env) (what Str) (clauses Trees) (carried Ty)) (Result Unit Fault)
    (uses Alloc)
    (let where (place_in clauses)
      (if (or (str.eq where "process") (str.eq where "node"))
        (let why (wire_why decls carried (NoNames) 4096)
          (if (str.eq why "")
            (Ok unit)
            (Err (fault "placement" (concat "placement: " (concat what (concat " runs with memory of its own, so what it carries must have a wire form: " why)))))))
        (Ok unit))))

  ; The place in an `(on where)` clause, or "" when there is none.
  (fn place_in ((clauses Trees)) Str
    (uses Alloc)
    (match clauses
      ((NoTrees) "")
      ((Trees c more) (match c
        ((Leaf text quoted) (place_in more))
        ((Node parts) (match parts
          ((NoTrees) (place_in more))
          ((Trees head args) (if (is_word head "on")
            (match args ((NoTrees) "") ((Trees w rest) (match w ((Leaf wtext wquoted) (match (named wtext) ((Ok n) n) ((Err f) ""))) ((Node inner) ""))))
            (place_in more)))))))))

  ; Why `t` has no wire form, or "" when it has one. A type already being looked at is
  ; taken to have one, so a recursive enum ends.
  (fn wire_why ((decls Env) (t Ty) (seen Names) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (let base (get t base)
      (if (or (<= left 0) (or (is_unknown t) (names_has seen base)))
        ""
        (if (str.eq base "Array")
          (wires_why decls (get t args) (Names base seen) (- left 1))
          (if (wire_prim base)
            ""
            (match (newtype_of decls base)
              ((Some d) (wire_why decls (get d inner) (Names base seen) (- left 1)))
              ((None) (match (enum_of decls base)
                ((Some d) (let first (wires_why decls (get t args) (Names base seen) (- left 1))
                  (if (str.eq first "") (variants_why decls (get d variants) (get d params) (get t args) (Names base seen) (- left 1)) first)))
                ((None) (match (record_of decls base)
                  ((Some r) (if (get r wired)
                    (fields_why decls (get r fields) (Names base seen) (- left 1))
                    (concat "`" (concat base "` declares no wire schema, so two machines cannot agree on it"))))
                  ((None) (concat "`" (concat base "` has no wire form")))))))))))))

  (fn wires_why ((decls Env) (ts Tys) (seen Names) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) ""
    (match ts
      ((NoTys) "")
      ((Tys t rest) (let why (wire_why decls t seen (- left 1)) (if (str.eq why "") (wires_why decls rest seen (- left 1)) why))))))

  (fn variants_why ((decls Env) (vs VariantSignatures) (params Names) (given Tys) (seen Names) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) ""
    (match vs
      ((NoVariantSignatures) "")
      ((VariantSignatures v rest) (let why (wires_why decls (subst_all (get v fields) params given) seen (- left 1))
        (if (str.eq why "") (variants_why decls rest params given seen (- left 1)) why))))))

  (fn fields_why ((decls Env) (fs RecordFields) (seen Names) (left Int)) Str
    (uses Alloc)
    (requires (<= 0 left))
    (if (<= left 0) ""
    (match fs
      ((NoRecordFields) "")
      ((RecordFields n ty rest) (let why (wire_why decls ty seen (- left 1)) (if (str.eq why "") (fields_why decls rest seen (- left 1)) why))))))

  (fn wire_prim ((base Str)) Bool
    (or (or (or (str.eq base "Bool") (str.eq base "Bytes")) (or (str.eq base "Int") (str.eq base "Str")))
      (or (or (str.eq base "Tensor") (str.eq base "Unit")) (or (is_fixed_width base) (or (str.eq base "F16") (or (str.eq base "BF16") (str.eq base "F32")))))))

  ; `(seq a b ... z)`: everything but the last is evaluated for what it does and must
  ; be a Unit, since a value computed and dropped is nearly always a mistake.
  (fn seq_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "a seq needs at least one expression")))
      ((Trees h more) (match more ((NoTrees) (expr_type decls ls h)) ((Trees next after) (match (expr_type decls ls h) ((Err f) (Err f)) ((Ok t) (if (or (str.eq (get t base) "Unit") (str.eq (get t base) "?")) (seq_type decls ls more) (Err (fault "discarded-value" (concat "a " (concat (get t base) " value is computed and discarded"))))))))))))

  (fn unwrap_type ((decls Env) (ls Locals) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "syntax" "an unwrap takes one expression")))
      ((Trees h more) (match more ((Trees extra others) (Err (fault "syntax" "an unwrap takes one expression"))) ((NoTrees) (match (expr_type decls ls h) ((Err f) (Err f)) ((Ok t) (match (newtype_of decls (get t base)) ((None) (Err (fault "unwrap-non-newtype" (concat "cannot unwrap a " (concat (get t base) "; only newtypes wrap a value"))))) ((Some d) (Ok (ty_plus (get d inner) (get t labels))))))))))))

  ; `(Newtype value)`: the value must fit what the newtype wraps.
  (fn wrap_type ((decls Env) (ls Locals) (d NewtypeSignature) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Err (fault "arity" "a newtype wraps one value")))
      ((Trees h more) (match more ((Trees extra others) (Err (fault "arity" "a newtype wraps one value"))) ((NoTrees) (match (expr_type decls ls h) ((Err f) (Err f)) ((Ok got) (if (loose_fits got (get d inner)) (Ok (plain (get d name))) (Err (fault "type-mismatch" "a value does not fit the type a newtype wraps"))))))))))

  ; The enum a variant belongs to, wherever it is declared.
  (fn owner_of ((es EnumSignatures) (name Str)) (Option EnumSignature)
    (match es
      ((NoEnumSignatures) (None))
      ((EnumSignatures d more) (match (variant_of d name) ((Some v) (Some d)) ((None) (owner_of more name))))))

  ; A variant used as a constructor. For a generic enum the type arguments are found
  ; from the arguments given; one nothing settles stays unknown (`None` is an `Option ?`)
  ; until the place it is used fills it in.
  (fn variant_call ((decls Env) (ls Locals) (e EnumSignature) (name Str) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match (variant_of e name)
      ((None) (Err (fault "unknown-variant" "a variant is not in its own enum")))
      ((Some v) (match (arg_types decls ls rest) ((Err f) (Err f)) ((Ok actuals) (if (not (= (tys_count actuals) (tys_count (get v fields)))) (Err (fault "arity" "a variant is given a different number of arguments than it has fields")) (match (bind_all (get v fields) actuals (get e params) (unknowns (get e params))) ((Err f) (Err f)) ((Ok found) (if (loose_all (subst_all (get v fields) (get e params) found) actuals) (Ok (make Ty (base (get e name)) (labels (NoNames)) (args found) (dims (NoDims)))) (Err (fault "type-mismatch" "an argument does not fit its field")))))))))))

  ; Each given type against the one wanted in its place, and neither list longer.
  (fn loose_all ((wanted Tys) (given Tys)) Bool
    (match wanted
      ((NoTys) (match given ((NoTys) true) ((Tys g more) false)))
      ((Tys w wmore) (match given ((NoTys) false) ((Tys g gmore) (and (loose_fits g w) (loose_all wmore gmore)))))))

  ; --- arrays and tensors --------------------------------------------------------
  ; What these answer depends on what they hold, which the kernel's table of primitives
  ; cannot say, so each has its own rule. Reading an array is total: `array.at` answers an
  ; `Option`, and the labels of the array ride along on whatever comes out of it.
  (fn array_type ((decls Env) (ls Locals) (name Str) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match (arg_types decls ls rest)
      ((Err f) (Err f))
      ((Ok args) (if (str.eq name "array.empty") (if (= (tys_count args) 0) (Ok (make Ty (base "Array") (labels (NoNames)) (args (Tys (unknown) (NoTys))) (dims (NoDims)))) (Err (fault "arity" "array.empty takes no arguments"))) (match args ((NoTys) (Err (fault "type-mismatch" "an array operation takes an array"))) ((Tys holder more) (if (not (str.eq (get holder base) "Array")) (Err (fault "type-mismatch" "an array operation wants an array")) (match (get holder args) ((NoTys) (Err (fault "type-mismatch" "an array operation wants an array"))) ((Tys element none) (array_op name holder element more))))))))))

  (fn array_op ((name Str) (holder Ty) (element Ty) (more Tys)) (Result Ty Fault)
    (uses Alloc)
    (if (str.eq name "array.len")
      (match more
        ((NoTys) (Ok (make Ty (base "Count") (labels (get holder labels)) (args (NoTys)) (dims (NoDims)))))
        ((Tys extra others) (Err (fault "arity" "array.len takes one argument"))))
      (match more
        ((NoTys) (Err (fault "arity" "an array operation is given too few arguments")))
        ((Tys second tail) (match tail ((Tys extra others) (Err (fault "arity" "an array operation is given too many arguments"))) ((NoTys) (if (str.eq name "array.at") (if (or (is_unknown second) (str.eq (get second base) "Count")) (Ok (make Ty (base "Option") (labels (get holder labels)) (args (Tys (ty_plus element (get holder labels)) (NoTys))) (dims (NoDims)))) (Err (fault "type-mismatch" "an index into an array is a Count"))) (if (loose_fits second element) (Ok (make Ty (base "Array") (labels (names_union (get holder labels) (get second labels))) (args (Tys (join element second) (NoTys))) (dims (NoDims)))) (Err (fault "type-mismatch" "the value pushed onto an array is not what it holds"))))))))))

  ; `tensor.add` is elementwise, so the shapes must match; `tensor.matmul` contracts the
  ; last axis of the left against the first of the right, and the two must agree by name
  ; as well as size.
  (fn tensor_type_of ((decls Env) (ls Locals) (name Str) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match (arg_types decls ls rest)
      ((Err f) (Err f))
      ((Ok args) (match args ((NoTys) (Err (fault "type-mismatch" "a tensor operation takes two tensors"))) ((Tys left more) (match more ((NoTys) (Err (fault "type-mismatch" "a tensor operation takes two tensors"))) ((Tys right none) (match none ((NoTys) (tensor_result name left right)) ((Tys extra others) (Err (fault "type-mismatch" "a tensor operation takes two tensors")))))))))))

  (fn tensor_result ((name Str) (left Ty) (right Ty)) (Result Ty Fault)
    (uses Alloc)
    (if (not (and (is_tensor left) (is_tensor right)))
      (Err (fault "shape" "a tensor operation wants tensors with axes"))
      (if (not (and (tys_loose_fit (get left args) (get right args)) (tys_loose_fit (get right args) (get left args))))
        (Err (fault "type-mismatch" "a tensor operation needs one element format on both sides"))
        (if (str.eq name "tensor.add")
          (if (dims_eq (get left dims) (get right dims))
            (Ok (make Ty (base "Tensor") (labels (names_union (get left labels) (get right labels))) (args (get left args)) (dims (get left dims))))
            (Err (fault "shape" "tensor.add works elementwise, so the shapes must match")))
          (if (or (< (dims_count (get left dims)) 2) (< (dims_count (get right dims)) 2))
            (Err (fault "shape" "tensor.matmul needs two axes on each side"))
            (if (dims_eq (dims_last (get left dims)) (dims_first (get right dims)))
              (Ok (make Ty (base "Tensor") (labels (names_union (get left labels) (get right labels))) (args (get left args)) (dims (dims_join (dims_init (get left dims)) (dims_rest (get right dims))))))
              (Err (fault "shape" "tensor.matmul contracts the last axis of the left with the first of the right, and they are not the same axis"))))))))

  (fn is_tensor ((t Ty)) Bool
    (and (str.eq (get t base) "Tensor") (< 0 (dims_count (get t dims)))))

  (fn dims_count ((ds Dims)) Int
    (match ds ((NoDims) 0) ((Dims a n rest) (+ 1 (dims_count rest)))))

  (fn dims_first ((ds Dims)) Dims
    (match ds ((NoDims) ds) ((Dims a n rest) (Dims a n (NoDims)))))

  (fn dims_rest ((ds Dims)) Dims (match ds ((NoDims) ds) ((Dims a n rest) rest)))

  (fn dims_last ((ds Dims)) Dims
    (match ds
      ((NoDims) ds)
      ((Dims a n rest) (match rest ((NoDims) (Dims a n (NoDims))) ((Dims b m more) (dims_last rest))))))

  (fn dims_init ((ds Dims)) Dims
    (match ds
      ((NoDims) ds)
      ((Dims a n rest) (match rest ((NoDims) (NoDims)) ((Dims b m more) (Dims a n (dims_init rest)))))))

  (fn dims_join ((p Dims) (q Dims)) Dims
    (match p ((NoDims) q) ((Dims a n rest) (Dims a n (dims_join rest q)))))

  ; A primitive, typed from the kernel's table of them: the number format it is used at
  ; is whatever its numeric arguments agree on, and each argument must fit its place.
  (fn builtin_type ((decls Env) (ls Locals) (b Builtin) (rest Trees)) (Result Ty Fault)
    (uses Alloc)
    (match (arg_types decls ls rest)
      ((Err f) (Err f))
      ((Ok args) (if (not (= (tys_count args) (wants_count (get b params)))) (Err (fault "arity" "a primitive is given a different number of arguments than it takes")) (if (and (get b sink) (any_labelled args)) (Err (fault "label-flow" "a sink is given data that carries a label")) (match (format_of (get b params) args "") ((Err f) (Err f)) ((Ok kind) (if (not (allowed_format b kind)) (Err (fault "type-mismatch" "a primitive is used at a format it does not take")) (if (and (get b fixed) (not (is_fixed_width kind))) (Err (fault "type-mismatch" "a primitive needs a fixed width; Int is unbounded")) (if (args_fit (get b params) args kind) (match (answered b kind) ((Err f) (Err f)) ((Ok answer) (Ok (ty_plus answer (names_union (if (get b sink) (NoNames) (labels_of args)) (get b ret_labels)))))) (Err (fault "type-mismatch" "an argument of a primitive is not what it wants"))))))))))))

  (fn arg_types ((decls Env) (ls Locals) (rest Trees)) (Result Tys Fault)
    (uses Alloc)
    (match rest
      ((NoTrees) (Ok (NoTys)))
      ((Trees h more) (match (expr_type decls ls h) ((Err f) (Err f)) ((Ok t) (match (arg_types decls ls more) ((Err f) (Err f)) ((Ok others) (Ok (Tys t others)))))))))

  ; Every label the arguments carry.
  (fn labels_of ((ts Tys)) Names
    (uses Alloc)
    (match ts
      ((NoTys) (NoNames))
      ((Tys t more) (names_union (get t labels) (labels_of more)))))

  (fn any_labelled ((ts Tys)) Bool
    (match ts
      ((NoTys) false)
      ((Tys t more) (match (get t labels) ((Names first others) true) ((NoNames) (any_labelled more))))))

  ; The number format the call is at: what its numeric arguments are, which must agree.
  (fn format_of ((ws Wants) (ts Tys) (seen Str)) (Result Str Fault)
    (uses Alloc)
    (match ws
      ((NoWants) (Ok (if (str.eq seen "") "Int" seen)))
